    @IsTest
    static void testSuccessCreateBenefitPackage() {

        RestContext.request = new RestRequest();
        RestContext.request.requestURI =
            '/sales/enterprise/transversal/benefits_configuration/vexp/benefit_packages';
        RestContext.request.httpMethod = 'POST';
        RestContext.request.headers.put(
            'authorization2',
            'Bearer ' + token
        );

        RestContext.request.requestBody = Blob.valueOf(
            '{' +
                '"product_reference":"I_C_BR",' +
                '"active_start_at":"2026-09-01",' +
                '"active_end_at":"2027-09-01",' +
                '"amount_of_policies":100,' +
                '"affected_policy_range":{' +
                    '"external_number_start_at":"1000",' +
                    '"external_number_end_at":"1100"' +
                '},' +
                '"core_benefits":[' +
                    '{' +
                        '"benefit_id":"LACIEMS"' +
                    '}' +
                '],' +
                '"optional_benefits":[' +
                    '{' +
                        '"benefit_id":"LACCELPRO"' +
                    '}' +
                '],' +
                '"legal_consents":[' +
                    '{' +
                        '"code":"legal_consent_I_understand",' +
                        '"is_confirmed":true,' +
                        '"consented_at":"2026-08-11T10:30:45Z"' +
                    '}' +
                ']' +
            '}'
        );

        RestContext.response = new RestResponse();

        Test.startTest();
        BenefitsConfigAPIPackages_VEXP.doPost();
        Test.stopTest();

        System.assertEquals(201, RestContext.response.statusCode, 'Expected HTTP 201 when the benefit package is created.');

        BenefitsConfigAPIPackages_VEXP.BenefitPackagePostResponse response =
            (BenefitsConfigAPIPackages_VEXP.BenefitPackagePostResponse) JSON.deserialize(
                RestContext.response.responseBody.toString(),
                BenefitsConfigAPIPackages_VEXP.BenefitPackagePostResponse.class
            );

        System.assertNotEquals(null, response.benefit_package_id, 'The response should contain the created benefit package id.');

        ServiceContract contract = [
            SELECT Id,
                   Package_Status__c,
                   Product_Reference__c,
                   Product__c,
                   StartDate,
                   EndDate,
                   Term,
                   Amount_of_Policies__c,
                   Policy_Range_Start__c,
                   Policy_Range_End__c,
                   Legal_Consent_Code__c,
                   Legal_Consent_Confirmed__c,
                   Legal_Consent_Date__c,
                   Pricebook2Id
            FROM ServiceContract
            WHERE Id = :response.benefit_package_id
            LIMIT 1
        ];

        System.assertEquals('Draft', contract.Package_Status__c, 'The created package should have Draft status.');
        System.assertEquals('I_C_BR', contract.Product_Reference__c, 'The product reference should be persisted.');
        System.assertEquals( Date.newInstance(2026, 9, 1), contract.StartDate, 'The start date should be persisted.');
        System.assertEquals(Date.newInstance(2027, 9, 1), contract.EndDate, 'The end date should be persisted.');
        System.assertEquals(12, contract.Term, 'The contract term should contain the number of whole months.');
        System.assertEquals(100, Integer.valueOf(contract.Amount_of_Policies__c), 'The amount of policies should be persisted.');
        System.assertEquals('1000',contract.Policy_Range_Start__c, 'The policy range start should be persisted.');
        System.assertEquals('1100',contract.Policy_Range_End__c,'The policy range end should be persisted.');
        System.assertEquals('legal_consent_I_understand',contract.Legal_Consent_Code__c,'The legal consent code should be persisted.');
        System.assertEquals(true, contract.Legal_Consent_Confirmed__c, 'The legal consent confirmation should be persisted.');
        System.assertNotEquals(null, contract.Product__c, 'The product should be associated with the package.');
        System.assertNotEquals(null, contract.Legal_Consent_Date__c, 'The legal consent date should be persisted.');
        System.assertNotEquals(null, contract.Pricebook2Id, 'The package should use the Benefits Pricebook.');

        List<ContractLineItem> lineItems = [
            SELECT Id, Benefit__c, Benefit_Category__c, Quantity, UnitPrice, StartDate, EndDate
            FROM ContractLineItem
            WHERE ServiceContractId = :contract.Id
            ORDER BY Benefit_Category__c ASC
        ];

        System.assertEquals(2,
            lineItems.size(),
            'The package should contain one Core and one Optional benefit.'
        );

        ContractLineItem coreLineItem;
        ContractLineItem optionalLineItem;

        for (ContractLineItem lineItem : lineItems) {
            if (lineItem.Benefit_Category__c == 'Core') {
                coreLineItem = lineItem;
            } else if (lineItem.Benefit_Category__c == 'Optional') {
                optionalLineItem = lineItem;
            }
        }

        System.assertNotEquals(null, coreLineItem, 'The Core benefit should be created.');
        System.assertEquals(0, coreLineItem.UnitPrice, 'Core benefits should have zero price.');
        System.assertEquals(100, Integer.valueOf(coreLineItem.Quantity), 'The Core benefit quantity should match amount_of_policies.');
        System.assertNotEquals(null, optionalLineItem, 'The Optional benefit should be created.');
        System.assertEquals(50, optionalLineItem.UnitPrice, 'Optional benefits should use the PricebookEntry price.');
        System.assertEquals(100, Integer.valueOf(optionalLineItem.Quantity), 'The Optional benefit quantity should match amount_of_policies.');
    }

