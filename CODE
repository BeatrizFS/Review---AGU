    private static void handleGetDetails(String benefitPackageId) {
        try {
            WebportalAPITokenAuthentication_v1.parseAndValidateSecurityToken(
                RestContext.request,
                new Set<String>{
                    'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.benefit_packages.read_only',
                    'urn:axa.partners.benefits_platform.read_only'
                }
            );

            List<ServiceContract> packages = [
                SELECT Id, Package_Status__c, Product_Reference__c, StartDate, EndDate, 
                    Amount_of_Policies__c, Policy_Range_Start__c, Policy_Range_End__c, 
                    Legal_Consent_Code__c, Legal_Consent_Confirmed__c, Legal_Consent_Date__c
                FROM ServiceContract
                WHERE Id = :benefitPackageId AND RecordType.DeveloperName = :BENEFIT_PACKAGE_RECORD_TYPE
                LIMIT 1
            ];

            if (packages.isEmpty()) {
                throw new WebportalApiUtility_v1.RequestAPIException(404, 'Not Found', 'The searched resource was not found.');
            }

            ServiceContract benefitPackage = packages[0];

            List<ContractLineItem> lineItems = [
                SELECT Id,
                    Benefit_Category__c,
                    PricebookEntry.Product2.Benefit__r.Visa_External_Reference__c,
                    PricebookEntry.Product2.Benefit__r.Name,
                    PricebookEntry.Product2.Benefit__r.Benefit_Description__c
                FROM ContractLineItem
                WHERE ServiceContractId = :benefitPackage.Id
                ORDER BY CreatedDate ASC
            ];

            RestContext.response.statusCode = 200;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(buildBenefitPackageResponse(benefitPackage, lineItems)));

        } catch (WebportalApiUtility_v1.RequestAPIException ex) {
            RestContext.response.statusCode = ex.status_code;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        String.valueOf(ex.status_code),
                        ex.error,
                        ex.error_description
                    )
                )
            );
        } catch (Exception ex) {
            System.debug(LoggingLevel.ERROR, 'Exception type: ' + ex.getTypeName());
            System.debug(LoggingLevel.ERROR, 'Exception stack tracing: ' + ex.getStackTraceString());

            RestContext.response.statusCode = 500;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        '500',
                        'internal_server_error',
                        'Unexpected error retrieving benefit package.'
                    )
                )
            );
        }
    }
    private static List<ContractLineItem> buildContractLineItems(Id contractId, BenefitPackage request, Date startDate, Date endDate, Map<String, Benefit__c> benefitsByReference, Map<String, PricebookEntry> pricebookEntriesByBenefit) {
        List<ContractLineItem> lineItems = new List<ContractLineItem>();
        Integer quantity = request.amount_of_policies;

        addCoreLineItems(lineItems, contractId, quantity, startDate, endDate, request.core_benefits, benefitsByReference, pricebookEntriesByBenefit);
        addOptionalLineItems(lineItems, contractId, quantity, startDate, endDate, request.optional_benefits, benefitsByReference, pricebookEntriesByBenefit);

        return lineItems;
    }

    private static void addCoreLineItems(List<ContractLineItem> lineItems, Id contractId, Integer quantity, Date startDate, Date endDate, List<CoreBenefit> coreBenefits, Map<String, Benefit__c> benefitsByReference, Map<String, PricebookEntry> pricebookEntriesByBenefit) {
        for (CoreBenefit coreBenefit : coreBenefits) {
            lineItems.add(
                buildContractLineItem(
                    contractId,
                    quantity,
                    startDate,
                    endDate,
                    benefitsByReference.get(coreBenefit.benefit_id),
                    pricebookEntriesByBenefit.get(coreBenefit.benefit_id),
                    'Core',
                    0
                )
            );
        }
    }

    private static void addOptionalLineItems(List<ContractLineItem> lineItems, Id contractId, Integer quantity, Date startDate, Date endDate, List<OptionalBenefit> optionalBenefits, Map<String, Benefit__c> benefitsByReference, Map<String, PricebookEntry> pricebookEntriesByBenefit) {
        if (optionalBenefits == null) {
            return;
        }

        for (OptionalBenefit optionalBenefit : optionalBenefits) {
            PricebookEntry pricebookEntry = pricebookEntriesByBenefit.get(optionalBenefit.benefit_id);

            lineItems.add(
                buildContractLineItem(
                    contractId,
                    quantity,
                    startDate,
                    endDate,
                    benefitsByReference.get(optionalBenefit.benefit_id),
                    pricebookEntry,
                    'Optional',
                    pricebookEntry == null ? null : pricebookEntry.UnitPrice
                )
            );
        }
    }

    private static ServiceContract buildServiceContract(BenefitPackage request, Product__c product, Id pricebookId, Date startDate, Date endDate) {
        ServiceContract contract = new ServiceContract();
        contract.Name = '-';
        contract.RecordTypeId = Schema.SObjectType.ServiceContract.getRecordTypeInfosByDeveloperName().get(BENEFIT_PACKAGE_RECORD_TYPE).getRecordTypeId();
        contract.Pricebook2Id = pricebookId;
        contract.Package_Status__c = PACKAGE_STATUS.get('DRAFT');
        contract.Product_Reference__c = request.product_reference;
        contract.Product__c = product.Id;
        contract.StartDate = startDate;
        contract.EndDate = endDate;
        contract.Term = calculateWholeMonthTerm(startDate, endDate);
        contract.Amount_of_Policies__c = request.amount_of_policies;

        populatePolicyRange(contract, request.affected_policy_range);

        populateLegalConsents(contract, request);

        return contract;
    }    

    private static ContractLineItem buildContractLineItem(Id contractId, Integer quantity, Date startDate, Date endDate, Benefit__c benefit, PricebookEntry pricebookEntry, String category, Decimal unitPrice) {
        if (benefit == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Benefit could not be resolved.');
        }
        if (pricebookEntry == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'No PricebookEntry was found for benefit ' + benefit.Name + ' in the Visa Benefits Pricebook.');
        }

        ContractLineItem lineItem = new ContractLineItem();
        lineItem.ServiceContractId = contractId;
        lineItem.PricebookEntryId = pricebookEntry.Id;
        lineItem.Benefit_Category__c = category;
        lineItem.Quantity = quantity;
        lineItem.UnitPrice = unitPrice;
        lineItem.StartDate = startDate;
        lineItem.EndDate = endDate;

        return lineItem;
    }    

    private static List<SimplifiedBenefitPackage> buildBenefitPackageListResponse(List<ServiceContract> contracts) {
        List<SimplifiedBenefitPackage> response = new List<SimplifiedBenefitPackage>();

        for (ServiceContract contract : contracts) {
            SimplifiedBenefitPackage item = new SimplifiedBenefitPackage();
            item.status = contract.Package_Status__c;
            item.benefit_package_id = contract.Id;
            item.product_reference = contract.Product_Reference__c;
            item.active_start_at = contract.StartDate;
            item.active_end_at = contract.EndDate;
            item.amount_of_policies = contract.Amount_of_Policies__c == null ? null : Integer.valueOf(contract.Amount_of_Policies__c);
            response.add(item);
        }

        return response;
    }
    
    private static BenefitPackage buildBenefitPackageResponse(ServiceContract contract, List<ContractLineItem> lineItems) {
        BenefitPackage response = initializeBenefitPackageResponse(contract);

        for (ContractLineItem lineItem : lineItems) {
            if (lineItem.Benefit_Category__c == 'Core') {
                response.core_benefits.add(buildCoreBenefit(lineItem));
            } else if (lineItem.Benefit_Category__c == 'Optional') {
                response.optional_benefits.add(buildOptionalBenefit(lineItem));
            }
        }

        return response;
    }

    private static BenefitPackage initializeBenefitPackageResponse(ServiceContract contract) {
        BenefitPackage response = new BenefitPackage();
        response.status = contract.Package_Status__c;
        response.benefit_package_id = contract.Id;
        response.product_reference = contract.Product_Reference__c;
        response.active_start_at = contract.StartDate;
        response.active_end_at = contract.EndDate;
        response.amount_of_policies = contract.Amount_of_Policies__c == null ? null : Integer.valueOf(contract.Amount_of_Policies__c);
        response.affected_policy_range = buildAffectedPolicyRange(contract);
        response.core_benefits = new List<CoreBenefit>();
        response.optional_benefits = new List<OptionalBenefit>();
        response.legal_consents = buildLegalConsentResponse(contract);

        return response;
    }

    private static AffectedPolicyRange buildAffectedPolicyRange(ServiceContract contract) {
        AffectedPolicyRange affectedPolicyRange = new AffectedPolicyRange();
        affectedPolicyRange.external_number_start_at = contract.Policy_Range_Start__c;
        affectedPolicyRange.external_number_end_at = contract.Policy_Range_End__c;

        return affectedPolicyRange;
    }

    private static CoreBenefit buildCoreBenefit(ContractLineItem lineItem) {
        CoreBenefit coreBenefit = new CoreBenefit();
        coreBenefit.benefit_id = lineItem.PricebookEntry.Product2.Benefit__r.Visa_External_Reference__c;
        coreBenefit.name = lineItem.PricebookEntry.Product2.Benefit__r.Name;

        return coreBenefit;
    }

    private static OptionalBenefit buildOptionalBenefit(ContractLineItem lineItem) {
        OptionalBenefit optionalBenefit = new OptionalBenefit();
        optionalBenefit.benefit_id = lineItem.PricebookEntry.Product2.Benefit__r.Visa_External_Reference__c;
        optionalBenefit.name = lineItem.PricebookEntry.Product2.Benefit__r.Name;
        optionalBenefit.description = lineItem.PricebookEntry.Product2.Benefit__r.Benefit_Description__c;

        return optionalBenefit;
    }

    private static List<LegalConsentItem> buildLegalConsentResponse(ServiceContract contract) {
        List<LegalConsentItem> legalConsents = new List<LegalConsentItem>();
        if (String.isBlank(contract.Legal_Consent_Code__c)) {
            return legalConsents;
        }

        LegalConsentItem consent = new LegalConsentItem();
        consent.code = contract.Legal_Consent_Code__c;
        consent.is_confirmed = contract.Legal_Consent_Confirmed__c;
        consent.consented_at = contract.Legal_Consent_Date__c == null ? null : contract.Legal_Consent_Date__c.formatGmt('yyyy-MM-dd\'T\'HH:mm:ss\'Z\'');
        legalConsents.add(consent);
        return legalConsents;
    }

    private static void populatePolicyRange(ServiceContract contract, AffectedPolicyRange affectedPolicyRange) {
        if (affectedPolicyRange == null) {
            return;
        }

        contract.Policy_Range_Start__c = affectedPolicyRange.external_number_start_at;
        contract.Policy_Range_End__c = affectedPolicyRange.external_number_end_at;
    }

    private static List<String> getResourceSegments(String resourcePath) {
        String requestUri = RestContext.request?.requestURI;

        if (String.isBlank(requestUri) || String.isBlank(resourcePath)) {
            return new List<String>();
        }

        requestUri = requestUri.split('\\?')[0];
        String suffix = requestUri.substringAfter(resourcePath);

        if (String.isBlank(suffix) || suffix == '/') {
            return new List<String>();
        }

        if (!suffix.startsWith('/')) {
            return new List<String>();
        }

        List<String> segments = new List<String>();
        for (String segment : suffix.split('/')) {
            if (String.isNotBlank(segment)) {
                segments.add(segment);
            }
        }

        return segments;
    }

