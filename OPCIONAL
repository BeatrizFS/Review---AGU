        /*
         * O mesmo MN_BINRange_Benefit__c pode casar com mais de um BIN.
         *
         * Exemplo:
         * BIN 1234567890 -> registro A
         * BIN 1234567891 -> registro A
         *
         * O Map elimina a duplicidade do próprio registro.
         */
        Map<Id, MN_BINRange_Benefit__c> matchedBenefits = new Map<Id, MN_BINRange_Benefit__c>();

        for (VG_BankIdentificationNumber__c bin : bins) {
            if (String.isBlank(bin.BIN_10FirstDigitsStdEnc__c)) {
                continue;
            }

            for (MN_BINRange_Benefit__c br : candidates) {
                if (
                    bin.BIN_10FirstDigitsStdEnc__c >= br.BIN_Range__r.Min_Bin_Range_Enc__c
                    &&
                    bin.BIN_10FirstDigitsStdEnc__c <= br.BIN_Range__r.Max_Bin_Range_Enc__c
                ) {
                    matchedBenefits.put(br.Id, br);
                }
            }
        }

        return matchedBenefits.values();
