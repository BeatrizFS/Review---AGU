@RestResource(urlMapping='/sales/enterprise/transversal/benefits_configuration/vexp/products')
global with sharing class BenefitsConfigAPIProducts_VEXP extends BenefitsConfigAPIBase_V1 {

    private static final Set<String> SCOPE_READ = new Set<String>{
        'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.products.read_only'
    };

    private static final Integer MAX_ITEMS = 100;

    @HttpGet
    global static void doGet() {
        RestContext.response.addHeader('Content-Type', 'application/json');

        BenefitsConfigAPIBase_V1.AgentContext context = authorizeAgent(SCOPE_READ);
        if (context == null) {
            return;
        }

        List<MN_Product_Benefit__c> coreBenefits =
            fetchCoreBenefits();

        List<MN_BINRange_Benefit__c> optionalBenefits =
            fetchOptionalBenefits(context.bankAccountId);

        List<ProductResponse> result =
            buildResponse(
                coreBenefits,
                optionalBenefits,
                context.baseCurrency
            );

        // TODO: aplicar JWE encrypt via JSONWebEncryption
        // usando Client_Key__c resolvido por context.clientId

        RestContext.response.statusCode = 200;
        RestContext.response.responseBody =
            Blob.valueOf(JSON.serialize(result));
    }

    // ────────────────────────────────────────────────────────────────────────
    // CORE BENEFITS
    // ────────────────────────────────────────────────────────────────────────

    private static List<MN_Product_Benefit__c> fetchCoreBenefits() {
        return [
            SELECT
                Product__r.Key__c,
                Product__r.Name,
                Benefit__c,
                Benefit__r.Visa_External_Reference__c,
                Benefit__r.Name,
                Benefit__r.Benefit_Description__c
            FROM MN_Product_Benefit__c
            WHERE Benefit__r.Active__c = true
              AND Benefit__r.Visa_External_Reference__c != null
            WITH USER_MODE
            LIMIT :MAX_ITEMS
        ];
    }

    // ────────────────────────────────────────────────────────────────────────
    // OPTIONAL BENEFITS
    // ────────────────────────────────────────────────────────────────────────

    private static List<MN_BINRange_Benefit__c> fetchOptionalBenefits(
        Id bankAccountId
    ) {
        List<VG_BankIdentificationNumber__c> bins = [
            SELECT
                BIN_6FirstDigits__c,
                BIN_10FirstDigitsStdEnc__c
            FROM VG_BankIdentificationNumber__c
            WHERE Bank__c = :bankAccountId
              AND Status__c = 'Approved'
            WITH USER_MODE
        ];

        if (bins.isEmpty()) {
            return new List<MN_BINRange_Benefit__c>();
        }

        Set<String> bin6Set = new Set<String>();

        for (VG_BankIdentificationNumber__c bin : bins) {
            if (String.isNotBlank(bin.BIN_6FirstDigits__c)) {
                bin6Set.add(bin.BIN_6FirstDigits__c);
            }
        }

        if (bin6Set.isEmpty()) {
            return new List<MN_BINRange_Benefit__c>();
        }

        List<MN_BINRange_Benefit__c> candidates = [
            SELECT
                Id,
                Benefit__c,
                Benefit__r.Visa_External_Reference__c,
                Benefit__r.Name,
                Benefit__r.Benefit_Description__c,

                BIN_Range__r.Product__r.Key__c,
                BIN_Range__r.Product__r.Name,

                BIN_Range__r.Min_Bin_Range_Enc__c,
                BIN_Range__r.Max_Bin_Range_Enc__c,
                BIN_Range__r.IIN_Number__c,

                Remove_Core_Benefit__c,
                Coverage_structure__c
            FROM MN_BINRange_Benefit__c
            WHERE BIN_Range__r.IIN_Number__c IN :bin6Set
              AND Benefit__r.Active__c = true
              AND Benefit__r.Visa_External_Reference__c != null
            WITH USER_MODE
        ];

        /*
         * O mesmo MN_BINRange_Benefit__c pode casar com mais de um BIN.
         *
         * Usamos o Id do registro para evitar que a mesma relação
         * seja processada várias vezes.
         */
        Map<Id, MN_BINRange_Benefit__c> matchedBenefits =
            new Map<Id, MN_BINRange_Benefit__c>();

        for (VG_BankIdentificationNumber__c bin : bins) {
            if (String.isBlank(bin.BIN_10FirstDigitsStdEnc__c)) {
                continue;
            }

            for (MN_BINRange_Benefit__c br : candidates) {
                if (
                    bin.BIN_10FirstDigitsStdEnc__c >=
                        br.BIN_Range__r.Min_Bin_Range_Enc__c
                    &&
                    bin.BIN_10FirstDigitsStdEnc__c <=
                        br.BIN_Range__r.Max_Bin_Range_Enc__c
                ) {
                    matchedBenefits.put(br.Id, br);
                }
            }
        }

        return matchedBenefits.values();
    }

    // ────────────────────────────────────────────────────────────────────────
    // RESPONSE
    // ────────────────────────────────────────────────────────────────────────

    private static List<ProductResponse> buildResponse(
        List<MN_Product_Benefit__c> coreBenefits,
        List<MN_BINRange_Benefit__c> optionalBenefits,
        String currency
    ) {
        Map<String, ProductResponse> productMap =
            new Map<String, ProductResponse>();

        /*
         * Guarda os Benefit__c já adicionados ao CORE de cada produto.
         */
        Map<String, Set<Id>> coreBenefitIdsByProduct =
            new Map<String, Set<Id>>();

        /*
         * Guarda os Benefit__c já adicionados ao OPTIONAL de cada produto.
         */
        Map<String, Set<Id>> optionalBenefitIdsByProduct =
            new Map<String, Set<Id>>();

        // ================================================================
        // CORE
        // ================================================================

        for (MN_Product_Benefit__c pb : coreBenefits) {
            String productKey = pb.Product__r.Key__c;

            if (String.isBlank(productKey)) {
                continue;
            }

            ProductResponse product =
                getOrCreateProduct(
                    productMap,
                    productKey,
                    pb.Product__r.Name
                );

            if (!coreBenefitIdsByProduct.containsKey(productKey)) {
                coreBenefitIdsByProduct.put(
                    productKey,
                    new Set<Id>()
                );
            }

            /*
             * Evita o mesmo Benefit__c repetido no CORE
             * do mesmo produto.
             */
            if (
                coreBenefitIdsByProduct
                    .get(productKey)
                    .contains(pb.Benefit__c)
            ) {
                continue;
            }

            CoreBenefitResponse core =
                new CoreBenefitResponse();

            core.benefit_id =
                pb.Benefit__r.Visa_External_Reference__c;

            core.name =
                pb.Benefit__r.Name;

            product.core_benefits.add(core);

            coreBenefitIdsByProduct
                .get(productKey)
                .add(pb.Benefit__c);
        }

        // ================================================================
        // OPTIONAL
        // ================================================================

        for (MN_BINRange_Benefit__c br : optionalBenefits) {
            if (br.Remove_Core_Benefit__c) {
                continue;
            }

            String productKey =
                br.BIN_Range__r.Product__r.Key__c;

            if (String.isBlank(productKey)) {
                continue;
            }

            /*
             * O produto é descoberto pelo relacionamento:
             *
             * MN_BINRange_Benefit__c
             *      -> BIN_Range__r
             *          -> Product__r
             *              -> Key__c
             *
             * Portanto não precisamos receber a Key no GET.
             */
            ProductResponse product =
                getOrCreateProduct(
                    productMap,
                    productKey,
                    br.BIN_Range__r.Product__r.Name
                );

            if (!optionalBenefitIdsByProduct.containsKey(productKey)) {
                optionalBenefitIdsByProduct.put(
                    productKey,
                    new Set<Id>()
                );
            }

            /*
             * Evita o mesmo Benefit__c repetido no OPTIONAL
             * do mesmo produto.
             */
            if (
                optionalBenefitIdsByProduct
                    .get(productKey)
                    .contains(br.Benefit__c)
            ) {
                continue;
            }

            OptionalBenefitResponse optional =
                new OptionalBenefitResponse();

            optional.benefit_id =
                br.Benefit__r.Visa_External_Reference__c;

            optional.name =
                br.Benefit__r.Name;

            optional.description =
                br.Benefit__r.Benefit_Description__c;

            optional.cost =
                buildCost(br, currency);

            product.optional_benefits.add(optional);

            optionalBenefitIdsByProduct
                .get(productKey)
                .add(br.Benefit__c);
        }

        return productMap.values();
    }

    // ────────────────────────────────────────────────────────────────────────
    // PRODUCT FACTORY
    // ────────────────────────────────────────────────────────────────────────

    private static ProductResponse getOrCreateProduct(
        Map<String, ProductResponse> productMap,
        String productKey,
        String productName
    ) {
        if (!productMap.containsKey(productKey)) {
            ProductResponse product =
                new ProductResponse();

            product.product_reference = productKey;
            product.name = productName;
            product.core_benefits =
                new List<CoreBenefitResponse>();
            product.optional_benefits =
                new List<OptionalBenefitResponse>();

            productMap.put(productKey, product);
        }

        return productMap.get(productKey);
    }

    // ────────────────────────────────────────────────────────────────────────
    // COST
    // ────────────────────────────────────────────────────────────────────────

    private static Object buildCost(
        MN_BINRange_Benefit__c br,
        String currency
    ) {
        SimpleCostResponse cost =
            new SimpleCostResponse();

        cost.coverage_type =
            br.Coverage_structure__c;

        // TODO:
        // Confirmar campo monetário.
        //
        // cost.price =
        //     new AmountResponse(
        //         br.Value_limit__c,
        //         currency
        //     );

        return cost;
    }

    // ────────────────────────────────────────────────────────────────────────
    // RESPONSE CONTRACT
    // ────────────────────────────────────────────────────────────────────────

    private class ProductResponse {
        String product_reference;
        String name;
        List<CoreBenefitResponse> core_benefits;
        List<OptionalBenefitResponse> optional_benefits;
    }

    private class CoreBenefitResponse {
        String benefit_id;
        String name;
    }

    private class OptionalBenefitResponse {
        String benefit_id;
        String name;
        String description;
        Object cost;
    }

    private class AmountResponse {
        Decimal value;
        String currency;

        AmountResponse(
            Decimal value,
            String currency
        ) {
            this.value = value;
            this.currency = currency;
        }
    }

    private class SimpleCostResponse {
        String coverage_type;
        AmountResponse price;
    }

    private class UsageCoverageItem {
        String coverage_type;
        Integer incident_max;
        Integer annual_max;
        AmountResponse price;
    }

    private class PeriodCoverageItem {
        String coverage_type;
        String period;
        AmountResponse price;
    }
}
