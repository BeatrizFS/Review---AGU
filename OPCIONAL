    private static List<MN_Product_Benefit__c> fetchCoreBenefits(String productReference) {
        if (String.isNotBlank(productReference)) {
            return [
                SELECT Product__r.Key__c, Product__r.Name,
                       Benefit__r.Visa_External_Reference__c, Benefit__r.Name, Benefit__r.Benefit_Description__c
                FROM MN_Product_Benefit__c
                WHERE Product__r.Key__c = :productReference
                  AND Benefit__r.Active__c = true
                  AND Benefit__r.Visa_External_Reference__c != null
                WITH USER_MODE
                LIMIT :MAX_ITEMS
            ];
        }
        return [
            SELECT Product__r.Key__c, Product__r.Name,
                   Benefit__r.Visa_External_Reference__c, Benefit__r.Name, Benefit__r.Benefit_Description__c
            FROM MN_Product_Benefit__c
            WHERE Benefit__r.Active__c = true
              AND Benefit__r.Visa_External_Reference__c != null
            WITH USER_MODE
            LIMIT :MAX_ITEMS
        ];
    }

    private static List<MN_BINRange_Benefit__c> fetchOptionalBenefits(Id bankAccountId) {
        List<VG_BankIdentificationNumber__c> bins = [
            SELECT BIN_6FirstDigits__c, BIN_10FirstDigitsStdEnc__c
            FROM VG_BankIdentificationNumber__c
            WHERE Bank__c = :bankAccountId
              AND Status__c = 'Approved'
            WITH USER_MODE
        ];
        if (bins.isEmpty()) return new List<MN_BINRange_Benefit__c>();

        Set<String> bin6Set = new Set<String>();
        for (VG_BankIdentificationNumber__c b : bins) bin6Set.add(b.BIN_6FirstDigits__c);

        List<MN_BINRange_Benefit__c> candidates = [
            SELECT Benefit__r.Visa_External_Reference__c, Benefit__r.Name, Benefit__r.Benefit_Description__c,
                   BIN_Range__r.Min_Bin_Range_Enc__c, BIN_Range__r.Max_Bin_Range_Enc__c,
                   BIN_Range__r.IIN_Number__c, Remove_Core_Benefit__c,
                   Coverage_structure__c  // TODO: confirmar valores do picklist (SIMPLE/USAGE/PERIOD?)
                   /* Value_limit__c, Event_limit__c, Event_Quantity__c */ // TODO: confirmar mapeamento para cost
            FROM MN_BINRange_Benefit__c
            WHERE BIN_Range__r.IIN_Number__c IN :bin6Set
              AND Benefit__r.Active__c = true
              AND Benefit__r.Visa_External_Reference__c != null
            WITH USER_MODE
        ];

        // Filtro de range — padrao confirmado em BenefitCoreAndOpcional e WebportalSalesBinProductBenefits_V1
        List<MN_BINRange_Benefit__c> result = new List<MN_BINRange_Benefit__c>();
        for (VG_BankIdentificationNumber__c bin : bins) {
            for (MN_BINRange_Benefit__c br : candidates) {
                if (bin.BIN_10FirstDigitsStdEnc__c >= br.BIN_Range__r.Min_Bin_Range_Enc__c
                    && bin.BIN_10FirstDigitsStdEnc__c <= br.BIN_Range__r.Max_Bin_Range_Enc__c) {
                    result.add(br);
                }
            }
        }
        return result;
    }

