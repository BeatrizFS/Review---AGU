    private static List<ProductResponse> buildResponse(
        List<MN_Product_Benefit__c>  coreBenefits,
        List<MN_BINRange_Benefit__c> optionalBenefits,
        String currency
    ) {
        Map<String, ProductResponse> productMap = new Map<String, ProductResponse>();
        Set<String> coreRefs = new Set<String>();

        for (MN_Product_Benefit__c pb : coreBenefits) {
            String key = pb.Product__r.Key__c;
            if (!productMap.containsKey(key)) {
                ProductResponse pr    = new ProductResponse();
                pr.product_reference  = key;
                pr.name               = pb.Product__r.Name;
                pr.core_benefits      = new List<CoreBenefitResponse>();
                pr.optional_benefits  = new List<OptionalBenefitResponse>();
                productMap.put(key, pr);
            }
            CoreBenefitResponse core = new CoreBenefitResponse();
            core.benefit_id = pb.Benefit__r.Visa_External_Reference__c;
            core.name       = pb.Benefit__r.Name;
            productMap.get(key).core_benefits.add(core);
            coreRefs.add(pb.Benefit__r.Visa_External_Reference__c);
        }

        for (MN_BINRange_Benefit__c br : optionalBenefits) {
            if (br.Remove_Core_Benefit__c) continue;
            if (coreRefs.contains(br.Benefit__r.Visa_External_Reference__c)) continue;

            OptionalBenefitResponse opt = new OptionalBenefitResponse();
            opt.benefit_id  = br.Benefit__r.Visa_External_Reference__c;
            opt.name        = br.Benefit__r.Name;
            opt.description = br.Benefit__r.Benefit_Description__c;
            opt.cost        = buildCost(br, currency);

            // TODO: mapear ao produto correto
