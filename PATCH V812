    @isTest
    static void getBenefitPackageDetails() {
        ServiceContract contract = [SELECT Id FROM ServiceContract WHERE RecordType.DeveloperName = :BENEFIT_PACKAGE_RECORD_TYPE LIMIT 1];

        RestRequest req = new RestRequest();
        RestResponse res = new RestResponse();

        req.requestURI = BASE_URI + '/' + contract.Id;
        req.httpMethod = 'GET';
        req.headers.put('authorization2', 'Bearer ' + token);

        RestContext.request = req;
        RestContext.response = res;

        Test.starttest();
        BenefitsConfigAPIPackages_VEXP.doGet();
        Test.stoptest();

        System.assertEquals(200, RestContext.response.statuscode);

        BenefitsConfigAPIPackages_VEXP.BenefitPackage response =
            (BenefitsConfigAPIPackages_VEXP.BenefitPackage) JSON.deserialize(
                RestContext.response.responseBody.toString(),
                BenefitsConfigAPIPackages_VEXP.BenefitPackage.class
            );

        System.assertEquals(contract.Id, response.benefit_package_id);
        System.assertEquals('Draft', response.status);
        System.assertEquals('I_C_BR', response.product_reference);
        System.assertEquals(100, response.amount_of_policies);
        System.assertNotEquals(null, response.affected_policy_range);
        System.assertEquals('1000', response.affected_policy_range.external_number_start_at);
        System.assertEquals('1100', response.affected_policy_range.external_number_end_at);

        System.assertEquals(1, response.core_benefits.size());
        System.assertEquals('LACIEMS', response.core_benefits[0].benefit_id);
        System.assertEquals('(EMC) Emergency Medical Assistance', response.core_benefits[0].name);

        System.assertEquals(1, response.optional_benefits.size());
        System.assertEquals('LACCELPRO', response.optional_benefits[0].benefit_id);
        System.assertEquals('Cellphone Protection', response.optional_benefits[0].name);
        System.assertEquals('Optional benefit description', response.optional_benefits[0].description);

        System.assertEquals(1, response.legal_consents.size());
        System.assertEquals( 'legal_consent_I_understand', response.legal_consents[0].code);
        System.assertEquals( true, response.legal_consents[0].is_confirmed);
        System.assertNotEquals( null, response.legal_consents[0].consented_at);
    }

