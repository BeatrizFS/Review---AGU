private static void handlePatch(String benefitPackageId) {
    try {
        /*
         * 1. Authentication / authorization
         */
        WebportalAPITokenAuthentication_v1.parseAndValidateSecurityToken(
            RestContext.request,
            new Set<String>{
                'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.benefit_packages.write',
                'urn:axa.partners.benefits_platform.write'
            }
        );

        /*
         * 2. Validate request body
         */
        String requestBody = RestContext.request.requestBody.toString().trim();

        if (String.isBlank(requestBody)) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'Request body cannot be empty.'
            );
        }

        requestBody = WebportalApiUtility_v1.removeXMLInjections(requestBody);
        requestBody = WebportalApiUtility_v1.removeHtmlInjection(requestBody);

        BenefitPackage request =
            (BenefitPackage) JSON.deserializeStrict(
                requestBody,
                BenefitPackage.class
            );

        /*
         * PATCH contract currently receives the complete representation.
         * Therefore the same structural validation used by POST applies.
         */
        WebportalApiUtility_v1.runValidateRequiredFields(
            requestBody,
            POST_REQUIRED_FIELDS
        );

        Date startDate = request.active_start_at;
        Date endDate = request.active_end_at;

        validateCreateRequest(
            request,
            startDate,
            endDate
        );

        /*
         * 3. SOQL #1
         *
         * Load the package and its existing benefit lines in the same query.
         */
        List<ServiceContract> packages = [
            SELECT
                Id,
                Package_Status__c,
                Product_Reference__c,
                Product__c,
                Pricebook2Id,
                StartDate,
                EndDate,
                Term,
                Amount_of_Policies__c,
                Policy_Range_Start__c,
                Policy_Range_End__c,
                Legal_Consent_Code__c,
                Legal_Consent_Confirmed__c,
                Legal_Consent_Date__c,
                (
                    SELECT Id
                    FROM ContractLineItems
                )
            FROM ServiceContract
            WHERE Id = :benefitPackageId
            AND RecordType.DeveloperName = :BENEFIT_PACKAGE_RECORD_TYPE
            LIMIT 1
        ];

        if (packages.isEmpty()) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                404,
                'Not Found',
                'The searched resource was not found.'
            );
        }

        ServiceContract contract = packages[0];

        /*
         * 4. PATCH is only allowed while Draft.
         */
        if (contract.Package_Status__c != PACKAGE_STATUS.get('DRAFT')) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'Benefit package cannot be updated because its current status is ' +
                contract.Package_Status__c +
                '.'
            );
        }

        /*
         * 5. SOQL #2
         *
         * Resolve the product sent by the consumer.
         */
        Product__c product = getProduct(
            request.product_reference
        );

        /*
         * 6. SOQL #3
         *
         * Resolve all requested benefits.
         */
        Map<String, Benefit__c> benefitsByReference =
            getBenefitsByExternalReference(request);

        /*
         * 7. SOQL #4
         *
         * Resolve PricebookEntry + Product2 in one query.
         */
        Map<String, PricebookEntry> pricebookEntriesByBenefit =
            getPricebookEntriesByBenefitReference(
                benefitsByReference,
                contract.Pricebook2Id,
                'USD'
            );

        /*
         * 8. Update header + replace benefit lines.
         *
         * Everything is executed in the same Salesforce transaction.
         * If any DML fails, the transaction is rolled back.
         */
        updateBenefitPackage(
            contract,
            request,
            product,
            benefitsByReference,
            pricebookEntriesByBenefit
        );

        /*
         * 9. PATCH contract: no response body.
         */
        RestContext.response.statusCode = 204;
        RestContext.response.responseBody = null;

    } catch (WebportalApiUtility_v1.RequestAPIException ex) {

        RestContext.response.statusCode = ex.status_code;
        RestContext.response.responseBody = Blob.valueOf(
            JSON.serializePretty(
                new WebportalApiUtility_v1.ErrorMessage(
                    String.valueOf(ex.status_code),
                    ex.error,
                    ex.error_description
                )
            )
        );

    } catch (JSONException ex) {

        RestContext.response.statusCode = 400;
        RestContext.response.responseBody = Blob.valueOf(
            JSON.serializePretty(
                new WebportalApiUtility_v1.ErrorMessage(
                    '400',
                    'Bad Request',
                    'The input information received were not compliant with the endpoint specification.'
                )
            )
        );

    } catch (DMLException ex) {

        System.debug(
            LoggingLevel.ERROR,
            'DMLException: ' + ex.getMessage()
        );

        System.debug(
            LoggingLevel.ERROR,
            'DMLException stack trace: ' + ex.getStackTraceString()
        );

        RestContext.response.statusCode = 500;
        RestContext.response.responseBody = Blob.valueOf(
            JSON.serializePretty(
                new WebportalApiUtility_v1.ErrorMessage(
                    '500',
                    'database_internal_server_error',
                    'Error when try to update record in database.'
                )
            )
        );

    } catch (Exception ex) {

        System.debug(
            LoggingLevel.ERROR,
            'Exception type: ' + ex.getTypeName()
        );

        System.debug(
            LoggingLevel.ERROR,
            'Exception stack tracing: ' + ex.getStackTraceString()
        );

        RestContext.response.statusCode = 500;
        RestContext.response.responseBody = Blob.valueOf(
            JSON.serializePretty(
                new WebportalApiUtility_v1.ErrorMessage(
                    '500',
                    'Internal Server Error',
                    'Unexpected error updating the request: ' +
                    ex.getMessage()
                )
            )
        );
    }
}

private static void updateBenefitPackage(
    ServiceContract contract,
    BenefitPackage request,
    Product__c product,
    Map<String, Benefit__c> benefitsByReference,
    Map<String, PricebookEntry> pricebookEntriesByBenefit
) {
    /*
     * Update package header
     */
    contract.Product_Reference__c = request.product_reference;
    contract.Product__c = product.Id;

    contract.StartDate = request.active_start_at;
    contract.EndDate = request.active_end_at;

    contract.Term = calculateWholeMonthTerm(
        request.active_start_at,
        request.active_end_at
    );

    contract.Amount_of_Policies__c =
        request.amount_of_policies;

    /*
     * Policy range
     */
    if (request.affected_policy_range != null) {
        contract.Policy_Range_Start__c =
            request.affected_policy_range.external_number_start_at;

        contract.Policy_Range_End__c =
            request.affected_policy_range.external_number_end_at;
    } else {
        contract.Policy_Range_Start__c = null;
        contract.Policy_Range_End__c = null;
    }

    /*
     * Legal consent
     */
    populateLegalConsents(
        contract,
        request
    );

    /*
     * DML #1
     */
    update contract;

    /*
     * Replace benefit lines using the lines already
     * loaded by the parent SOQL query.
     */
    replaceBenefitLines(
        contract,
        request,
        benefitsByReference,
        pricebookEntriesByBenefit
    );
}

private static void replaceBenefitLines(
    ServiceContract contract,
    BenefitPackage request,
    Map<String, Benefit__c> benefitsByReference,
    Map<String, PricebookEntry> pricebookEntriesByBenefit
) {
    /*
     * Existing lines were loaded through the ServiceContract
     * relationship query.
     */
    List<ContractLineItem> existingLineItems =
        contract.ContractLineItems;

    /*
     * DML #2
     */
    if (!existingLineItems.isEmpty()) {
        delete existingLineItems;
    }

    /*
     * Build the replacement collection in memory.
     */
    List<ContractLineItem> lineItems =
        buildContractLineItems(
            contract.Id,
            request,
            request.active_start_at,
            request.active_end_at,
            benefitsByReference,
            pricebookEntriesByBenefit
        );

    /*
     * DML #3
     */
    if (!lineItems.isEmpty()) {
        insert lineItems;
    }
}

private static Map<String, PricebookEntry>
getPricebookEntriesByBenefitReference(
    Map<String, Benefit__c> benefitsByReference,
    Id pricebookId,
    String currencyIsoCode
) {
    Set<Id> benefitIds = new Set<Id>();

    for (Benefit__c benefit : benefitsByReference.values()) {
        benefitIds.add(benefit.Id);
    }

    /*
     * SOQL #4
     *
     * Product2 is obtained through PricebookEntry.
     */
    List<PricebookEntry> entries = [
        SELECT
            Id,
            Product2Id,
            Product2.Benefit__c,
            Product2.Benefit__r.Visa_External_Reference__c,
            Product2.Benefit__r.Name,
            Product2.Benefit__r.Benefit_Description__c,
            Product2.Family,
            Product2.IsActive,
            UnitPrice
        FROM PricebookEntry
        WHERE Pricebook2Id = :pricebookId
        AND Product2.Benefit__c IN :benefitIds
        AND Product2.Family = 'Benefit'
        AND Product2.IsActive = true
        AND CurrencyIsoCode = :currencyIsoCode
        AND IsActive = true
    ];

    Map<Id, PricebookEntry> entriesByBenefitId =
        new Map<Id, PricebookEntry>();

    for (PricebookEntry entry : entries) {
        Id benefitId = entry.Product2.Benefit__c;

        if (entriesByBenefitId.containsKey(benefitId)) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'More than one active PricebookEntry was found for Benefit ' +
                String.valueOf(benefitId) +
                '.'
            );
        }

        entriesByBenefitId.put(
            benefitId,
            entry
        );
    }

    Map<String, PricebookEntry> result =
        new Map<String, PricebookEntry>();

    for (String reference : benefitsByReference.keySet()) {
        Benefit__c benefit =
            benefitsByReference.get(reference);

        PricebookEntry entry =
            entriesByBenefitId.get(benefit.Id);

        if (entry == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'Benefit ' +
                reference +
                ' is not available in the Benefits Pricebook.'
            );
        }

        result.put(
            reference,
            entry
        );
    }

    return result;
}
