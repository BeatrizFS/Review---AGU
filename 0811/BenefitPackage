            System.debug(LoggingLevel.ERROR, 'Exception stack tracing: ' + ex.getStackTraceString());

            RestContext.response.statusCode = 500;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        '500',
                        'internal_server_error',
                        'Unexpected error retrieving benefit package.'
                    )
                )
            );
        }
    }

    private static DateRange validateCreateRequest(BenefitPackage request) {
        // Validate date format (ISO 8601) — parseDate throws RequestAPIException on invalid format
        Date startDate = WebportalApiUtility_v1.parseDate(request.active_start_at);
        Date endDate = WebportalApiUtility_v1.parseDate(request.active_end_at);

        // Validate amount_of_policies
        if (request.amount_of_policies == null || request.amount_of_policies < 1) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'amount_of_policies must be at least 1.');
        }

        // Validate date range
        if (endDate <= startDate) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'active_end_at must be after active_start_at.');
        }

        // Validate policy range if provided
        if (request.affected_policy_range != null) {
            if (String.isBlank(request.affected_policy_range.external_number_start_at)) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'affected_policy_range.external_number_start_at is required when policy range is specified.');
            }
            if (String.isBlank(request.affected_policy_range.external_number_end_at)) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'affected_policy_range.external_number_end_at is required when policy range is specified.');
            }
        }

        DateRange range = new DateRange();
        range.startDate = startDate;
        range.endDate = endDate;
        return range;
    }

    private static Map<String, Benefit__c> getBenefitsByExternalReference(BenefitPackage request) {
        // Collect all requested benefit IDs (no queries in loop)
        Set<String> requestedBenefitIds = new Set<String>();
        for (CoreBenefit coreBenefit : request.core_benefits) {
            requestedBenefitIds.add(coreBenefit.benefit_id);
        }
        if (request.optional_benefits != null) {
            for (OptionalBenefit optionalBenefit : request.optional_benefits) {
                requestedBenefitIds.add(optionalBenefit.benefit_id);
            }
        }

        // SOQL 2: Benefit bulk query (indexed on Visa_External_Reference__c)
        List<Benefit__c> benefits = [SELECT Id, Visa_External_Reference__c, Name, Benefit_Description__c FROM Benefit__c WHERE Visa_External_Reference__c IN :requestedBenefitIds];

        Map<String, Benefit__c> benefitsByReference = new Map<String, Benefit__c>();
        for (Benefit__c benefit : benefits) {
            benefitsByReference.put(benefit.Visa_External_Reference__c, benefit);
        }

        // Validate all requested benefits exist
        for (String benefitId : requestedBenefitIds) {
            if (!benefitsByReference.containsKey(benefitId)) {
                throw new WebportalApiUtility_v1.RequestAPIException(
                    400, 'bad_request', 'Benefit ' + benefitId + ' was not found in the catalogue.'
                );
            }
        }

        return benefitsByReference;
    }

    private static Map<String, PricebookEntry> getPricebookEntriesByBenefitReference(Map<String, Benefit__c> benefitsByReference, Id pricebookId, String currencyIsoCode) {
        // Collect benefit IDs in bulk (no queries in loop)
        Set<Id> benefitIds = new Set<Id>();
        for (Benefit__c benefit : benefitsByReference.values()) {
            benefitIds.add(benefit.Id);
        }

        // SOQL 3: Product2 by Benefit__c (indexed, bulk operation)
        List<Product2> products = [SELECT Id, Benefit__c FROM Product2 WHERE Benefit__c IN :benefitIds AND Family = 'Benefit' AND IsActive = true];

        Map<Id, Product2> productsByBenefitId = new Map<Id, Product2>();
        for (Product2 product : products) {
            if (productsByBenefitId.containsKey(product.Benefit__c)) {
                throw new WebportalApiUtility_v1.RequestAPIException(
                    400, 'bad_request', 'More than one active Product2 was found for Benefit ' + String.valueOf(product.Benefit__c)
                );
            }
            productsByBenefitId.put(product.Benefit__c, product);
        }

        // Validate all benefits have corresponding products
        for (String benefitReference : benefitsByReference.keySet()) {
            Benefit__c benefit = benefitsByReference.get(benefitReference);
            if (!productsByBenefitId.containsKey(benefit.Id)) {
                throw new WebportalApiUtility_v1.RequestAPIException(
                    400, 'bad_request', 'Product2 for benefit ' + benefitReference + ' was not found in the catalogue.'
                );
            }
        }

        // Collect product IDs in bulk (no queries in loop)
        Set<Id> productIds = new Set<Id>();
        for (Product2 product : productsByBenefitId.values()) {
            productIds.add(product.Id);
        }

        // SOQL 4: PricebookEntry in bulk (indexed on Product2Id, Pricebook2Id, CurrencyIsoCode)
        Map<Id, PricebookEntry> entriesByProductId = new Map<Id, PricebookEntry>();
        for (PricebookEntry entry : [
            SELECT Id, Product2Id, UnitPrice, IsActive
            FROM PricebookEntry
            WHERE Pricebook2Id = :pricebookId
                AND Product2Id IN :productIds
                AND CurrencyIsoCode = :currencyIsoCode
                AND IsActive = true
        ]) {
            entriesByProductId.put(entry.Product2Id, entry);
        }

        // Map results by benefit reference
        Map<String, PricebookEntry> result = new Map<String, PricebookEntry>();
        for (String benefitReference : benefitsByReference.keySet()) {
            Benefit__c benefit = benefitsByReference.get(benefitReference);
            Product2 product = productsByBenefitId.get(benefit.Id);
            PricebookEntry entry = entriesByProductId.get(product.Id);

            if (entry == null) {
                throw new WebportalApiUtility_v1.RequestAPIException(
                    400, 'bad_request', 'Benefit ' + benefitReference + ' is not available in the Benefits Pricebook.'
                );
            }

            result.put(benefitReference, entry);
        }

        return result;
    }

    private static List<ContractLineItem> buildContractLineItems(Id contractId, BenefitPackage request, Map<String, Benefit__c> benefitsByReference, Map<String, PricebookEntry> pricebookEntriesByBenefit, Date effectiveStartDate, Date effectiveEndDate) {
        List<ContractLineItem> lineItems = new List<ContractLineItem>();

        for (CoreBenefit coreBenefit : request.core_benefits) {
            Benefit__c benefit = benefitsByReference.get(coreBenefit.benefit_id);
            PricebookEntry pricebookEntry = pricebookEntriesByBenefit.get(coreBenefit.benefit_id);
            lineItems.add(buildContractLineItem(
                contractId,
                benefit,
                pricebookEntry,
                'Core',
                request.amount_of_policies,
                effectiveStartDate,
                effectiveEndDate,
                true
            ));
        }

        if (request.optional_benefits != null) {
            for (OptionalBenefit optionalBenefit : request.optional_benefits) {
                Benefit__c benefit = benefitsByReference.get(optionalBenefit.benefit_id);
                PricebookEntry pricebookEntry = pricebookEntriesByBenefit.get(optionalBenefit.benefit_id);
                lineItems.add(buildContractLineItem(
                    contractId,
                    benefit,
                    pricebookEntry,
                    'Optional',
                    request.amount_of_policies,
                    effectiveStartDate,
                    effectiveEndDate,
                    false
                ));
            }
        }

        return lineItems;
    }


    private static ContractLineItem buildContractLineItem(Id contractId, Benefit__c benefit, PricebookEntry pricebookEntry, String category, Integer quantity, Date startDate, Date endDate, Boolean zeroPriced) {
        if (benefit == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Benefit could not be resolved.');
        }
        if (pricebookEntry == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400, 'bad_request', 'No PricebookEntry was found for benefit ' + benefit.Name + ' in the Visa Benefits Pricebook.'
            );
        }

        ContractLineItem lineItem = new ContractLineItem();
        lineItem.ServiceContractId = contractId;
        lineItem.PricebookEntryId = pricebookEntry.Id;
        lineItem.Benefit__c = benefit.Id;
        lineItem.Benefit_Category__c = category;
        lineItem.Quantity = quantity;
        // ADR: Core benefits are zero-priced (included by definition); optional benefits use catalogue price
        lineItem.UnitPrice = zeroPriced ? 0 : pricebookEntry.UnitPrice;
        lineItem.StartDate = startDate;
        lineItem.EndDate = endDate;

        return lineItem;
    }

    private static List<SimplifiedBenefitPackage> buildBenefitPackageListResponse(List<ServiceContract> contracts) {
        List<SimplifiedBenefitPackage> response = new List<SimplifiedBenefitPackage>();

        for (ServiceContract contract : contracts) {
            SimplifiedBenefitPackage item = new SimplifiedBenefitPackage();
            item.status = contract.Package_Status__c;
            item.benefit_package_id = contract.Id;
            item.product_reference = contract.Product_Reference__c;
            item.active_start_at = contract.StartDate;
            item.active_end_at = contract.EndDate;
            item.amount_of_policies = contract.Amount_of_Policies__c == null ? null : Integer.valueOf(contract.Amount_of_Policies__c);
            response.add(item);
        }

        return response;
    }
    
    private static BenefitPackage buildBenefitPackageResponse(ServiceContract contract, List<ContractLineItem> lineItems) {
        BenefitPackage response = new BenefitPackage();
        response.status = contract.Package_Status__c;
        response.benefit_package_id = contract.Id;
        response.product_reference = contract.Product_Reference__c;
        response.active_start_at = contract.StartDate;
        response.active_end_at = contract.EndDate;
        response.amount_of_policies = contract.Amount_of_Policies__c == null ? null : Integer.valueOf(contract.Amount_of_Policies__c);
        response.affected_policy_range = new AffectedPolicyRange();
        response.affected_policy_range.external_number_start_at = contract.Policy_Range_Start__c;
        response.affected_policy_range.external_number_end_at = contract.Policy_Range_End__c;
        response.core_benefits = new List<CoreBenefit>();
        response.optional_benefits = new List<OptionalBenefit>();
        response.legal_consents = buildLegalConsentResponse(contract);

        for (ContractLineItem lineItem : lineItems) {
            if (lineItem.Benefit_Category__c == 'Core') {
                CoreBenefit coreBenefit = new CoreBenefit();
                coreBenefit.benefit_id = lineItem.Benefit__r.Visa_External_Reference__c;
                coreBenefit.name = lineItem.Benefit__r.Name;
                response.core_benefits.add(coreBenefit);
            } else if (lineItem.Benefit_Category__c == 'Optional') {
                OptionalBenefit optionalBenefit = new OptionalBenefit();
                optionalBenefit.benefit_id = lineItem.Benefit__r.Visa_External_Reference__c;
                optionalBenefit.name = lineItem.Benefit__r.Name;
                optionalBenefit.description = lineItem.Benefit__r.Benefit_Description__c;
                response.optional_benefits.add(optionalBenefit);
            }
        }

        return response;
    }

    private static List<LegalConsentItem> buildLegalConsentResponse(ServiceContract contract) {
        List<LegalConsentItem> legalConsents = new List<LegalConsentItem>();
        if (String.isBlank(contract.Legal_Consent_Code__c)) {
            return legalConsents;
        }

        LegalConsentItem consent = new LegalConsentItem();
        consent.code = contract.Legal_Consent_Code__c;
        consent.is_confirmed = contract.Legal_Consent_Confirmed__c;
        consent.consented_at = contract.Legal_Consent_Date__c == null ? null : contract.Legal_Consent_Date__c.formatGmt('yyyy-MM-dd\'T\'HH:mm:ss\'Z\'');
        legalConsents.add(consent);
        return legalConsents;
    }

    private static List<String> getResourceSegments(String resourcePath) {
        String requestUri = RestContext.request?.requestURI;

        if (String.isBlank(requestUri) || String.isBlank(resourcePath)) {
            return new List<String>();
        }

        requestUri = requestUri.split('\\?')[0];
        String suffix = requestUri.substringAfter(resourcePath);

        if (String.isBlank(suffix) || suffix == '/') {
            return new List<String>();
        }

        if (!suffix.startsWith('/')) {
            return new List<String>();
        }

        List<String> segments = new List<String>();
        for (String segment : suffix.split('/')) {
            if (String.isNotBlank(segment)) {
                segments.add(segment);
            }
        }

        return segments;
    }

