        }
    }

    private static void handleCreate() {
        try{
            WebportalAPITokenAuthentication_v1.parseAndValidateSecurityToken(
                RestContext.request,
                new Set<String>{
                    'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.benefit_packages.write',
                    'urn:axa.partners.benefits_platform.write'
                }
            );

            String requestBody = RestContext.request.requestBody.toString().trim();
            requestBody = WebportalApiUtility_v1.removeXMLInjections(requestBody);
            requestBody = WebportalApiUtility_v1.removeHtmlInjection(requestBody);

            BenefitPackage benefitPackageRequest = (BenefitPackage)JSON.deserializeStrict(requestBody, BenefitPackage.class);
            
            WebportalApiUtility_v1.validateRequestRequiredFields(requestBody, POST_REQUIRED_FIELDS);
            DateRange dateRange = validateCreateRequest(benefitPackageRequest);
            Date effectiveStartDate = dateRange.startDate;
            Date effectiveEndDate = dateRange.endDate;

            // Resolve product by reference (SOQL 1)
            List<Product__c> products = [SELECT Id FROM Product__c WHERE Key__c = :benefitPackageRequest.product_reference LIMIT 1];
            if (products.isEmpty()) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Product with reference ' + benefitPackageRequest.product_reference + ' not found.');
            }
            Product__c product = products[0];
            
            // Use cached pricebook ID (resolved at class initialization, no query needed)
            if (cachedBenefitsPricebookId == null) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Benefits pricebook is not configured.');
            }
            Id pricebookId = cachedBenefitsPricebookId;

            ServiceContract contract = buildServiceContract(benefitPackageRequest, product, pricebookId, effectiveStartDate, effectiveEndDate);

            Map<String, Benefit__c> benefitsByReference = getBenefitsByExternalReference(benefitPackageRequest);
            
            //Waiting definition - Get in token base_currency
            String currencyIsoCode = 'USD';

            Map<String, PricebookEntry> pricebookEntriesByBenefit = getPricebookEntriesByBenefitReference(benefitsByReference, pricebookId, currencyIsoCode);
            
            insert contract;

            List<ContractLineItem> lineItems = buildContractLineItems(contract.Id, benefitPackageRequest, benefitsByReference, pricebookEntriesByBenefit, effectiveStartDate, effectiveEndDate);
            insert lineItems;

            BenefitPackagePostResponse responsePayload = new BenefitPackagePostResponse();
            responsePayload.benefit_package_id = contract.Id;

            RestContext.response.statusCode = 201;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(responsePayload));
            
        } catch(WebportalApiUtility_v1.RequestAPIException ex) {
            RestContext.response.statusCode = ex.status_code;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        String.valueOf(ex.status_code),
                        ex.error, ex.error_description),
                        true
                    )
                );
        } catch (JSONException ex) {
            RestContext.response.statusCode = 400;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorMessage('400', 'Bad Request','The input information received were not compliant with the endpoint specification.')));
		} catch(DMLException ex) {
            System.debug(LoggingLevel.ERROR, 'DMLException: ' + ex.getMessage());
            RestContext.response.statusCode = 500;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage('500', 'database_internal_server_error', 'Error when try to insert record in database.')
                )
            );
        } catch(Exception ex) {
            System.debug(LoggingLevel.INFO, 'Exception type: ' + ex.getTypeName());
            System.debug(LoggingLevel.INFO, 'Exception stack tracing: ' + ex.getStackTraceString());
            RestContext.response.statusCode = 500;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage('500', 'Internal Server Error', 'Unexpected error creating the request: ' + ex.getMessage())
                )
            );
        }

    }

    private static ServiceContract buildServiceContract(BenefitPackage request, Product__c product, Id pricebookId, Date effectiveStartDate, Date effectiveEndDate) {
        ServiceContract contract = new ServiceContract();
        contract.Name = '-';
        contract.RecordTypeId = Schema.SObjectType.ServiceContract.getRecordTypeInfosByDeveloperName().get(BENEFIT_PACKAGE_RECORD_TYPE).getRecordTypeId();
        contract.Pricebook2Id = pricebookId;
        contract.Package_Status__c = PACKAGE_STATUS.get('DRAFT');
        contract.Product_Reference__c = request.product_reference;
        contract.Product__c = product.Id;
        contract.StartDate = effectiveStartDate;
        contract.EndDate = effectiveEndDate;
        contract.Term = calculateWholeMonthTerm(effectiveStartDate, effectiveEndDate);
        contract.Amount_of_Policies__c = request.amount_of_policies;

        if (request.affected_policy_range != null) {
            contract.Policy_Range_Start__c = request.affected_policy_range.external_number_start_at;
            contract.Policy_Range_End__c = request.affected_policy_range.external_number_end_at;
        }

        populateLegalConsents(contract, request);
        return contract;
    }

    private static Integer calculateWholeMonthTerm(Date startDate, Date endDate) {
        Integer months = ((endDate.year() - startDate.year()) * 12) + (endDate.month() - startDate.month());
        if (endDate.day() < startDate.day()) {
            months--;
        }
        return months < 1 ? 1 : months;
    }

    private static void populateLegalConsents(ServiceContract contract, BenefitPackage request) {
        if (request.legal_consents != null && !request.legal_consents.isEmpty()) {
            LegalConsentItem consent = request.legal_consents[0];

            contract = (ServiceContract) WebportalApiUtility_v1.setSObjectField(contract, 'Legal_Consent_Code__c', consent.code, false);
            contract = (ServiceContract) WebportalApiUtility_v1.setSObjectField(contract, 'Legal_Consent_Confirmed__c', consent.is_confirmed != null ? consent.is_confirmed : false);

            // Parse ISO 8601 datetime (e.g. 2026-08-11T10:30:45Z)
            Datetime consentDateTime = null;
            if (consent.consented_at != null) {
                try {
                    String iso8601 = consent.consented_at;
                    // Remove 'Z' and replace 'T' with space for Salesforce datetime parsing
                    if (iso8601.endsWith('Z')) {
                        iso8601 = iso8601.substring(0, iso8601.length() - 1);
                    }
                    iso8601 = iso8601.replace('T', ' ');
                    consentDateTime = Datetime.valueOfGmt(iso8601);
                } catch (Exception ex) {
                    System.debug(LoggingLevel.WARN, 'Failed to parse Legal_Consent_Date__c: ' + ex.getMessage());
                }
            }

            contract = (ServiceContract) WebportalApiUtility_v1.setSObjectField(
                contract,
                'Legal_Consent_Date__c',
                consentDateTime,
                false
            );
        }
    }

    private static void handleGet() {
        try {
            WebportalAPITokenAuthentication_v1.parseAndValidateSecurityToken(
                RestContext.request,
                new Set<String>{
                    'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.benefit_packages.read_only',
                    'urn:axa.partners.benefits_platform.read_only'
                }
            );
            Map<String, String> requestParams = RestContext.request.params;
            Map<String, Integer> paginationParams = WebportalApiUtility_v1.validatePaginationQueryParams(requestParams, 100);

            if (paginationParams.get('start_index') > 2000) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'start_index cannot be greater than 2000.');
            }

            Integer startIndex = paginationParams.get('start_index');
            Integer maxResults = paginationParams.get('max_results');

            List<ServiceContract> benefitPackages = [
                SELECT Id, Package_Status__c, Product_Reference__c, StartDate, EndDate, Amount_of_Policies__c
                FROM ServiceContract
                WHERE RecordType.DeveloperName = :BENEFIT_PACKAGE_RECORD_TYPE
                ORDER BY CreatedDate DESC
                LIMIT :maxResults OFFSET :startIndex
            ];

            RestContext.response.statusCode = 200;
            RestContext.response.addHeader('Content-Range', WebportalApiUtility_v1.getContentRangeHeader(startIndex, benefitPackages.size(), benefitPackages.size()));
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(buildBenefitPackageListResponse(benefitPackages), true));

        } catch (WebportalApiUtility_v1.RequestAPIException ex) {
            RestContext.response.statusCode = ex.status_code;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        String.valueOf(ex.status_code),
                        ex.error,
                        ex.error_description
                    )
                )
            );
        } catch(Exception ex) {
            System.debug(LoggingLevel.INFO, 'Exception type: ' + ex.getTypeName());
            System.debug(LoggingLevel.INFO, 'Exception stack tracing: ' + ex.getStackTraceString());
            RestContext.response.statusCode = 500;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        '500',
                        'Internal Server Error',
                        'Unexpected error retrieving benefit packages: ' + ex.getMessage()
                    )
                )
            );
        }
    }

    private static void handleGetDetails(String benefitPackageId) {
        try {
            WebportalAPITokenAuthentication_v1.parseAndValidateSecurityToken(
                RestContext.request,
                new Set<String>{
                    'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.benefit_packages.read_only',
