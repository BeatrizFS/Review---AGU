@RestResource(urlMapping='/sales/enterprise/transversal/benefits_configuration/vexp/benefit_packages/*')
global with sharing class BenefitsConfigAPIPackages_VEXP {

    private static final String RESOURCE_PATH = '/benefit_packages';
    private static final String ACTION_CANCEL = 'cancel';
    private static final String ACTION_COMPLETE = 'complete';
    private static final String BENEFITS_PRICEBOOK_NAME = 'Visa Benefits';
    private static final String BENEFIT_PACKAGE_RECORD_TYPE = 'Benefit_Package';
    
    // Cache pricebook ID to avoid extra SOQL query (resolved at class init)
    private static Id cachedBenefitsPricebookId;
    static {
        List<Pricebook2> pricebooks = [SELECT Id FROM Pricebook2 WHERE Name = :BENEFITS_PRICEBOOK_NAME AND IsActive = true LIMIT 1];
        if (!pricebooks.isEmpty()) {
            cachedBenefitsPricebookId = pricebooks[0].Id;
        }
    }

    private static final Set<String> POST_REQUIRED_FIELDS = new Set<String>{
        'product_reference',
        'active_start_at',
        'active_end_at',
        'amount_of_policies',
        'core_benefits',
        'optional_benefits',
        'legal_consents'
        //'name' - NAME - Missing from the YAML, but required to create the Service Contract.
    };

    private static final Map<String, String> PACKAGE_STATUS = new Map<String, String>{
        'DRAFT' => 'Draft',
        'AWAITING_START' => 'Awaiting Start',
        'ACTIVE' => 'Active',
        'CANCELLED' => 'Cancelled',
        'EXPIRED' => 'Expired'
        //'AWAITING_AGENT_SIGNATURE' => 'Awaiting Agent Signature' //Not documented in the ARD, but present in the YAML.
    };

