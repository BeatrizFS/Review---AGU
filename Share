public class MNAccountBINTriggerHandler {
    public static Boolean ignoreHandler = false;
    @TestVisible
    private static Map<Id, Partner_Product_Sharing_Setting__mdt> productPartnerSharing;
    @TestVisible
    private static Map<String, Partner_BIN_Range_Sharing_Setting__mdt> binRangePartnerSharing;
    @TestVisible
    private static List<String> binsList;

    public static void shareAccWithPartnerByProduct(Set<Id> newMnAccountBinIds) {
        if (ignoreHandler) {
            return;
        }

        initProductPartnerSharing();

        List<AccountShare> sharesToCreateByAccountId = new List<AccountShare>();
        List<Account> accountsToUpdate = new List<Account>();
        List<Certificates__Share> certSharesToCreate = new List<Certificates__Share>();
        
        List<Account> accountList = [
            SELECT Id, Partner_Account__c, 
            (
                SELECT BIN__r.Product_Version__c, BIN__r.BIN_Number__c 
                FROM MN_Account_BIN__r
                WHERE Is_Deleted__c = false
                    AND Id IN :newMnAccountBinIds 
                    AND (BIN__r.Product_Version__c IN :productPartnerSharing.keySet() 
                    OR BIN__r.BIN_6FirstDigits__c IN: binsList)
                ORDER BY BIN__r.Product_Version__r.Privilege__c DESC, CreatedDate ASC
            ),
            (
                SELECT Id
                FROM Certificates__r 
                WHERE Name LIKE 'CERT%'
                    AND Owner.Profile.UserType != 'CspLitePortal'
            ),
            (
                SELECT Id
                FROM Accounts__r
            )
            FROM Account
            WHERE Id IN (
                SELECT Customer__c
                FROM MN_Account_BIN__c
                WHERE Is_Deleted__c = false 
                    AND Id IN :newMnAccountBinIds 
                    AND (BIN__r.Product_Version__c IN :productPartnerSharing.keySet()
                    OR BIN__r.BIN_6FirstDigits__c IN: binsList)
            )
            AND Partner_Account__c = null
            AND ParentCustomerId__c = null
            AND Inactive__c = false
        ];

        if (!accountList.isEmpty()) {
            for (Account account : accountList) {
                Id partnerAccountId;
                Id groupId;
                Boolean isPrivilege = false;
                
                Partner_Product_Sharing_Setting__mdt productSetting = productPartnerSharing.get(account.MN_Account_BIN__r[0].BIN__r.Product_Version__c);
                
                if (productSetting == null || productSetting.Partner_Account__r == null || productSetting.Partner_Account__r.Group_Id__c == null) {
                    Partner_BIN_Range_Sharing_Setting__mdt binRangeSetting = new Partner_BIN_Range_Sharing_Setting__mdt();
                    String binNumber = account.MN_Account_BIN__r[0].BIN__r.BIN_Number__c;

                    if (binRangePartnerSharing.containsKey(binNumber.left(8))) {
                        binRangeSetting = binRangePartnerSharing.get(binNumber.left(8));
                    } else if (binRangePartnerSharing.containsKey(binNumber.left(6))) {
                        binRangeSetting = binRangePartnerSharing.get(binNumber.left(6));
                    } else {
                        continue;
                    }

                    partnerAccountId = binRangeSetting.Partner_Account__r.Partner_Account_Id__c;
                    groupId = binRangeSetting.Partner_Account__r.Group_Id__c;
                    isPrivilege = binRangeSetting.Partner_Account__r.Is_Privilege_Scope__c;

                    sharesToCreateByAccountId.add(PrivilegeUtils.buildAccountShare(account.Id, groupId));
                } else {
                    partnerAccountId = productSetting.Partner_Account__r.Partner_Account_Id__c;
                    groupId = productSetting.Partner_Account__r.Group_Id__c;
                    isPrivilege = productSetting.Partner_Account__r.Is_Privilege_Scope__c;

                    sharesToCreateByAccountId.add(PrivilegeUtils.buildAccountShare(account.Id, productSetting.Partner_Account__r.Group_Id__c));
                }
                
                for (Certificates__c cert : account.Certificates__r) {
                    certSharesToCreate.add(PrivilegeUtils.buildCertificateShare(cert.Id, groupId));
                }

                if(account.Accounts__r != null){
                    for(Account dependent : account.Accounts__r){
                        sharesToCreateByAccountId.add(PrivilegeUtils.buildAccountShare(dependent.Id, groupId));         
                    }
                }                

                accountsToUpdate.add(
                new Account(
                    Id = account.Id,
                    Partner_Account__c = partnerAccountId,
                    Privilege__c = isPrivilege
                )
            );
            }
        }

        if (!sharesToCreateByAccountId.isEmpty()) {
            insert sharesToCreateByAccountId;

            if (!certSharesToCreate.isEmpty()) {
                insert certSharesToCreate;
            }

            c_functionsAccount.ignoreHandler = true;
            update accountsToUpdate;
            c_functionsAccount.ignoreHandler = false;
        }
    }

    @TestVisible
    private static void initProductPartnerSharing() {
        if (Test.isRunningTest() && productPartnerSharing != null && binRangePartnerSharing != null) {
            return;
        }

        if (productPartnerSharing == null || binRangePartnerSharing == null) {
            productPartnerSharing = new Map<Id, Partner_Product_Sharing_Setting__mdt>();
            binRangePartnerSharing = new Map<String, Partner_BIN_Range_Sharing_Setting__mdt>();
            binsList = new List<String>();

            for (Partner_Sharing_Setting__mdt setup : [
                SELECT Id,
                    (SELECT BIN__c, Partner_Account__r.Group_Id__c, Partner_Account__r.Partner_Account_Id__c, Partner_Account__r.Is_Privilege_Scope__c, Is_8_Digit_Bin__c
                        FROM Partner_BIN_Range_Sharing_Settings__r), 
                    (SELECT Product_Id__c, Partner_Account__r.Group_Id__c, Partner_Account__r.Partner_Account_Id__c, Partner_Account__r.Is_Privilege_Scope__c
                        FROM Partner_Product_Sharing_Setting__r) 
                FROM Partner_Sharing_Setting__mdt
            ]) {
                if (!setup.Partner_Product_Sharing_Setting__r.isEmpty()) {
                    for (Partner_Product_Sharing_Setting__mdt productSettings : setup.Partner_Product_Sharing_Setting__r) {
                        productPartnerSharing.put(productSettings.Product_Id__c, productSettings);
                    }
                }
                
                if (!setup.Partner_BIN_Range_Sharing_Settings__r.isEmpty()) {
                    for (Partner_BIN_Range_Sharing_Setting__mdt binRangeSettings : setup.Partner_BIN_Range_Sharing_Settings__r) {
                        if (!binRangePartnerSharing.containsKey(binRangeSettings.BIN__c)) {
                            binRangePartnerSharing.put(binRangeSettings.BIN__c, binRangeSettings);
                            binsList.add(binRangeSettings.BIN__c.left(6));
                        }
                    }
                }
            }
        }
    }
}

