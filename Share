   public static void shareWithPartners(List<Certificates__c> certificates) {
        if (ignoreHandler) return;

        Set<Id> accountIds = new Set<Id>();
        for (Certificates__c cert : certificates) {
            if (cert.Certificate__c != null) {
                accountIds.add(cert.Certificate__c);
            }
        }

        if (accountIds.isEmpty()) return;

        initPartnerSharing();

        Map<Id, Account> accountsMap = new Map<Id, Account>([
            SELECT Id, Partner_Account__c
            FROM Account
            WHERE Id IN :accountIds
        ]);

        List<Certificates__Share> sharesToInsert = new List<Certificates__Share>();
        for (Certificates__c cert : certificates) {
            Account account = accountsMap.get(cert.Certificate__c);
            if (account != null && account.Partner_Account__c != null) {
                Id groupId = partnerSharing.get(account.Partner_Account__c);

                sharesToInsert.add(PrivilegeUtils.buildCertificateShare(cert.Id, groupId));
            }
        }

        if (!sharesToInsert.isEmpty()) {
            insert sharesToInsert;
        }
    }

    private static void initPartnerSharing() {
        if (partnerSharing != null) return;

        partnerSharing = new Map<Id, Id>();
        for (Partner_Sharing_Setting__mdt setting : [
            SELECT Partner_Account_Id__c, Group_Id__c
            FROM Partner_Sharing_Setting__mdt
        ]) {
            partnerSharing.put(setting.Partner_Account_Id__c, setting.Group_Id__c);
        }
    }

