public without sharing class ShareAccountWithPartnersCTRL {
    private static Map<Id, Partner_Sharing_Setting__mdt> partnerSharingByGroupId {
        get {
            if (partnerSharingByGroupId == null) {
                partnerSharingByGroupId = new Map<Id, Partner_Sharing_Setting__mdt>();
                for (Partner_Sharing_Setting__mdt setting : Partner_Sharing_Setting__mdt.getAll().values()) {
                    if (setting.Group_Id__c != null) {
                        partnerSharingByGroupId.put(setting.Group_Id__c, setting);
                    }
                }
            }
            return partnerSharingByGroupId;
        }

        private set;
    }

    @AuraEnabled(cacheable=true)
    public static List<PartnersSharingSettings> getPartnersSharingSettings() {
        List<PartnersSharingSettings> partnersSharingSettings = new List<PartnersSharingSettings>();
        for (Partner_Sharing_Setting__mdt setting : partnerSharingByGroupId.values()) {
            PartnersSharingSettings partnerSetting = new PartnersSharingSettings();
            partnerSetting.partnerAccountName = setting.MasterLabel;
            partnerSetting.partnerAccountId = setting.Partner_Account_Id__c;
            partnerSetting.groupId = setting.Group_Id__c;
            partnerSetting.description = setting.Description__c;
            partnerSetting.isPrivilegeScope = setting.Is_Privilege_Scope__c;
            partnersSharingSettings.add(partnerSetting);
        }

        return partnersSharingSettings;
    }

    @AuraEnabled
    public static Boolean canShareWithPartner(Id accountId) {
        try {
            Account account = [
                SELECT ParentCustomerId__c, RecordType.DeveloperName
                FROM Account
                WHERE Id = :accountId
                LIMIT 1
            ];

            if (account.RecordType.DeveloperName != 'PersonAccount') {
                throw new AuraHandledException('Only Person Accounts can be shared with partners');
            }

            if (account.ParentCustomerId__c != null) {
                throw new AuraHandledException('Only CardHolder Accounts can be shared this way with partners');
            }

            Set<Id> partnerGroupIds = partnerSharingByGroupId.keySet();
            if (partnerGroupIds.isEmpty()) {
                throw new AuraHandledException('No partner groups found');
            }

            List<AccountShare> shares = [
                SELECT Id
                FROM AccountShare
                WHERE AccountId = :accountId
                    AND UserOrGroupId IN :partnerGroupIds
                    AND RowCause = 'Manual'
                LIMIT 1
            ];

            return shares.isEmpty();
        } catch (QueryException error) {
            throw new AuraHandledException('Account not found');
        }
    }

    @AuraEnabled
    public static void updateAndShareWithPartner(Id accountId, PartnersSharingSettings setting) {
        Savepoint sp = Database.setSavepoint();
        try {
            c_functionsAccount.ignoreHandler = true;
            update new Account(
                Id = accountId,
                Partner_Account__c = setting.partnerAccountId,
                Privilege__c = setting.isPrivilegeScope
            );
            c_functionsAccount.ignoreHandler = false;

            insert PrivilegeUtils.buildAccountShare(accountId, setting.groupId);
            createCertificateShare(accountId, setting.groupId);
            createDependentShare(accountId, setting.groupId);
        } catch (DmlException ex) {
            Database.rollback(sp);
            System.debug(LoggingLevel.ERROR, ex.getMessage());
            System.debug(LoggingLevel.FINEST, ex.getStackTraceString());
            throw new AuraHandledException('Error sharing account with partner');
        }
    }

    private static void createCertificateShare(Id accountId, Id groupId) {
        List<Certificates__Share> certSharesToCreate = new List<Certificates__Share>();
        List<Certificates__c> certificateList = [SELECT Id FROM Certificates__c WHERE Certificate__c =: accountId AND Name LIKE 'CERT%' AND Owner.Profile.UserType != 'CspLitePortal'];

        if (!certificateList.isEmpty()) {
            for (Certificates__c cert : certificateList) {
                certSharesToCreate.add(PrivilegeUtils.buildCertificateShare(cert.Id, groupId));
            }

            if (!certSharesToCreate.isEmpty()) {
                insert certSharesToCreate;
            }
        }
    }

    private static void createDependentShare(Id accountId, Id groupId){
        List<Account> dependents = [SELECT Id FROM Account WHERE ParentCustomerId__c =: accountId];
        List<AccountShare> sharesToCreate = new List<AccountShare>();

        if(!dependents.isEmpty()){
            for(Account dependent : dependents){
                sharesToCreate.add(PrivilegeUtils.buildAccountShare(dependent.Id, groupId));
            }

            if(!sharesToCreate.isEmpty()){
                insert sharesToCreate;
            }
        }

    }

    @TestVisible
    private class PartnersSharingSettings {
        @AuraEnabled public String partnerAccountName { get; set; }
        @AuraEnabled public String partnerAccountId { get; set; }
        @AuraEnabled public Id groupId { get; set; }
        @AuraEnabled public String description { get; set; }
        @AuraEnabled public Boolean isPrivilegeScope { get; set; }
    }
}



