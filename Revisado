    private static String getSanitizedRequestBody() {

        if (
            RestContext.request == null ||
            RestContext.request.requestBody == null
        ) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                ERROR_BAD_REQUEST,
                MESSAGE_INVALID_REQUEST
            );
        }

        String requestBody =
            RestContext.request.requestBody
                .toString()
                .trim();

        if (String.isBlank(requestBody)) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                ERROR_BAD_REQUEST,
                MESSAGE_INVALID_REQUEST
            );
        }

        requestBody =
            WebportalApiUtility_v1.removeXMLInjections(
                requestBody
            );

        requestBody =
            WebportalApiUtility_v1.removeHtmlInjection(
                requestBody
            );

        return requestBody;
    }


    private static List<String> getResourceSegments(
        String resourcePath
    ) {

        String requestUri =
            RestContext.request?.requestURI;

        if (
            String.isBlank(requestUri) ||
            String.isBlank(resourcePath)
        ) {
            return new List<String>();
        }

        requestUri =
            requestUri.split('\\?')[0];

        String suffix =
            requestUri.substringAfter(resourcePath);

        if (
            String.isBlank(suffix) ||
            suffix == '/'
        ) {
            return new List<String>();
        }

        if (!suffix.startsWith('/')) {
            return new List<String>();
        }

        List<String> segments =
            new List<String>();

        for (String segment :
            suffix.split('/')
        ) {

            if (String.isNotBlank(segment)) {
                segments.add(segment);
            }
        }

        return segments;
    }


    // ============================================================
