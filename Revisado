    private static void writeErrorResponse(
        Integer statusCode,
        String error,
        String description
    ) {

        RestContext.response.statusCode =
            statusCode;

        RestContext.response.responseBody =
            Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        String.valueOf(statusCode),
                        error,
                        description
                    )
                )
            );
    }


    private static void writeInternalServerError(
        String message,
        Exception ex
    ) {

        System.debug(
            LoggingLevel.ERROR,
            'Exception type: ' +
            ex.getTypeName()
        );

        System.debug(
            LoggingLevel.ERROR,
            'Exception message: ' +
            ex.getMessage()
        );

        System.debug(
            LoggingLevel.ERROR,
            'Exception stack trace: ' +
            ex.getStackTraceString()
        );

        writeErrorResponse(
            500,
            ERROR_INTERNAL_SERVER,
            message
        );
    }


