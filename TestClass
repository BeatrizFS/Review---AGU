    // Cobre a validação de start_index acima do limite permitido.
    @IsTest
    static void testFailGetBenefitPackagesWithInvalidStartIndex() {

        RestContext.request = new RestRequest();
        RestContext.request.requestURI =
            '/sales/enterprise/transversal/benefits_configuration/vexp/benefit_packages';
        RestContext.request.httpMethod = 'GET';

        RestContext.request.params.put(
            'start_index',
            '2001'
        );

        RestContext.request.params.put(
            'max_results',
            '100'
        );

        RestContext.request.headers.put(
            'authorization2',
            'Bearer ' + TOKEN
        );

        RestContext.response = new RestResponse();

        Test.startTest();
        BenefitsConfigAPIPackages_VEXP.doGet();
        Test.stopTest();

        System.assertEquals(
            400,
            RestContext.response.statusCode,
            'Expected HTTP 400 when start_index is greater than 2000.'
        );

        WebportalApiUtility_v1.ErrorMessage response =
            (WebportalApiUtility_v1.ErrorMessage) JSON.deserialize(
                RestContext.response.responseBody.toString(),
                WebportalApiUtility_v1.ErrorMessage.class
            );

        System.assertEquals(
            '400',
            response.status_code
        );

        System.assertEquals(
            'start_index cannot be greater than 2000.',
            response.error_description
        );
    }

    // Cobre o caminho inválido após /benefit_packages.
    @IsTest
    static void testFailGetBenefitPackagesWithInvalidPath() {

        RestContext.request = new RestRequest();
        RestContext.request.requestURI =
            '/sales/enterprise/transversal/benefits_configuration/vexp/benefit_packages/'
            + 'invalid/extra';
        RestContext.request.httpMethod = 'GET';
        RestContext.request.headers.put(
            'authorization2',
            'Bearer ' + TOKEN
        );

        RestContext.response = new RestResponse();

        Test.startTest();

        try {
            BenefitsConfigAPIPackages_VEXP.doGet();
        } catch (WebportalApiUtility_v1.RequestAPIException ex) {
            RestContext.response.statusCode = ex.status_code;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        String.valueOf(ex.status_code),
                        ex.error,
                        ex.error_description
                    )
                )
            );
        }

        Test.stopTest();

        System.assertEquals(
            404,
            RestContext.response.statusCode,
            'Expected HTTP 404 for an invalid resource path.'
        );
    }

    // Cobre o cenário em que o Benefit Package não possui Legal Consent.
    @IsTest
    static void testGetBenefitPackageDetailsWithoutLegalConsent() {

        ServiceContract benefitPackage = [
            SELECT Id
            FROM ServiceContract
            WHERE RecordType.DeveloperName = 'Benefit_Package'
            LIMIT 1
        ];

        benefitPackage.Legal_Consent_Code__c = null;
        benefitPackage.Legal_Consent_Confirmed__c = null;
        benefitPackage.Legal_Consent_Date__c = null;

        update benefitPackage;

        RestContext.request = new RestRequest();
        RestContext.request.requestURI =
            '/sales/enterprise/transversal/benefits_configuration/vexp/benefit_packages/'
            + benefitPackage.Id;
        RestContext.request.httpMethod = 'GET';
        RestContext.request.headers.put(
            'authorization2',
            'Bearer ' + TOKEN
        );

        RestContext.response = new RestResponse();

        Test.startTest();
        BenefitsConfigAPIPackages_VEXP.doGet();
        Test.stopTest();

        System.assertEquals(
            200,
            RestContext.response.statusCode,
            'Expected HTTP 200 when the package has no legal consent.'
        );

        BenefitsConfigAPIPackages_VEXP.BenefitPackage response =
            (BenefitsConfigAPIPackages_VEXP.BenefitPackage) JSON.deserialize(
                RestContext.response.responseBody.toString(),
                BenefitsConfigAPIPackages_VEXP.BenefitPackage.class
            );

        System.assertNotEquals(
            null,
            response.legal_consents,
            'The legal_consents collection should be initialized.'
        );

        System.assertEquals(
            0,
            response.legal_consents.size(),
            'The response should not contain legal consents when none is configured.'
        );
    }

