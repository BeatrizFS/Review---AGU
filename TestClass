    // Cobre o GET da lista de Benefit Packages com sucesso.
    @isTest
    static void testSuccessGetBenefitPackages() {

        ServiceContract benefitPackage = [
            SELECT Id
            FROM ServiceContract
            WHERE RecordType.DeveloperName = 'Benefit_Package'
            LIMIT 1
        ];

        RestContext.request = new RestRequest();
        RestContext.request.requestURI =
            '/sales/enterprise/transversal/benefits_configuration/vexp/benefit_packages';
        RestContext.request.httpMethod = 'GET';
        RestContext.request.headers.put(
            'authorization2',
            'Bearer ' + token
        );

        RestContext.response = new RestResponse();

        Test.startTest();
        BenefitsConfigAPIPackages_VEXP.doGet();
        Test.stopTest();

        System.assertEquals(
            200,
            RestContext.response.statusCode
        );

        List<Object> response =
            (List<Object>) JSON.deserializeUntyped(
                RestContext.response.responseBody.toString()
            );

        System.assertEquals(1, response.size());

        Map<String, Object> benefitPackageResponse =
            (Map<String, Object>) response[0];

        System.assertEquals(
            benefitPackage.Id,
            benefitPackageResponse.get('benefit_package_id')
        );

        System.assertEquals(
            'Active',
            benefitPackageResponse.get('status')
        );

        System.assertEquals(
            'PRODUCT-TEST',
            benefitPackageResponse.get('product_reference')
        );

        System.assertEquals(
            '100',
            String.valueOf(
                benefitPackageResponse.get('amount_of_policies')
            )
        );
    }

