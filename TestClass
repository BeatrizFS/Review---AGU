@isTest
private class Test_BenefitsConfigAPIPackages_VEXP {

    private static final String TOKEN = 'test-token';

    @testSetup
    static void setup() {
        Benefit__c coreBenefit = new Benefit__c(
            Name = 'Core Benefit',
            Visa_External_Reference__c = 'CORE-001',
            Benefit_Description__c = 'Core benefit description'
        );

        Benefit__c optionalBenefit = new Benefit__c(
            Name = 'Optional Benefit',
            Visa_External_Reference__c = 'OPT-001',
            Benefit_Description__c = 'Optional benefit description'
        );

        insert new List<Benefit__c>{ coreBenefit, optionalBenefit };

        Id benefitPackageRecordTypeId = Schema.SObjectType.ServiceContract.getRecordTypeInfosByDeveloperName().get('Benefit_Package').getRecordTypeId();

        ServiceContract benefitPackage = new ServiceContract(
            RecordTypeId = benefitPackageRecordTypeId,
            Name = 'Benefit Package Test',
            StartDate = Date.today(),
            EndDate = Date.today().addYears(1),
            Product_Reference__c = 'I_C_BR',
            Package_Status__c = 'Draft',
            Amount_of_Policies__c = 100,
            Policy_Range_Start__c = '1000',
            Policy_Range_End__c = '1100',
            Legal_Consent_Code__c = 'legal_consent_I_understand',
            Legal_Consent_Confirmed__c = true,
            Legal_Consent_Date__c = Datetime.newInstanceGmt(Date.today(), Time.newInstance(10, 0, 0, 0))
        );

        insert benefitPackage;

        insert new List<ContractLineItem>{
            new ContractLineItem(
                ServiceContractId = benefitPackage.Id,
                Benefit__c = coreBenefit.Id,
                Benefit_Category__c = 'Core'
            ),
            new ContractLineItem(
                ServiceContractId = benefitPackage.Id,
                Benefit__c = optionalBenefit.Id,
                Benefit_Category__c = 'Optional'
            )
        };
    }

    @isTest
    static void testSuccessGetBenefitPackages() {
        RestContext.request = new RestRequest();
        RestContext.request.requestURI = '/sales/enterprise/transversal/benefits_configuration/vexp/benefit_packages';
        RestContext.request.httpMethod = 'GET';
        RestContext.request.headers.put('authorization2', 'Bearer ' + TOKEN);

        RestContext.response = new RestResponse();

        Test.startTest();
        BenefitsConfigAPIPackages_VEXP.doGet();
        Test.stopTest();

        System.assertEquals(200, RestContext.response.statusCode);

        List<Object> response = (List<Object>) JSON.deserializeUntyped(RestContext.response.responseBody.toString());
        System.assertEquals(1, response.size());

        Map<String, Object> benefitPackageResponse = (Map<String, Object>) response[0];
        System.assertEquals('Draft', benefitPackageResponse.get('status')); 
        System.assertEquals('I_C_BR', benefitPackageResponse.get('product_reference'));
        System.assertEquals('100', String.valueOf(benefitPackageResponse.get('amount_of_policies')));
    }

    @isTest
    static void testSuccessGetBenefitPackageDetails() {
        ServiceContract benefitPackage = [
            SELECT Id
            FROM ServiceContract
            WHERE RecordType.DeveloperName = 'Benefit_Package'
            LIMIT 1
        ];

        RestContext.request = new RestRequest();
        RestContext.request.requestURI =
            '/sales/enterprise/transversal/benefits_configuration/vexp/benefit_packages/' + benefitPackage.Id;
        RestContext.request.httpMethod = 'GET';
        RestContext.request.headers.put('authorization2', 'Bearer ' + TOKEN);

        RestContext.response = new RestResponse();

        Test.startTest();
        BenefitsConfigAPIPackages_VEXP.doGet();
        Test.stopTest();

        System.assertEquals(200, RestContext.response.statusCode);

        BenefitsConfigAPIPackages_VEXP.BenefitPackage response =
            (BenefitsConfigAPIPackages_VEXP.BenefitPackage) JSON.deserialize(
                RestContext.response.responseBody.toString(),
                BenefitsConfigAPIPackages_VEXP.BenefitPackage.class
            );

        System.assertEquals(benefitPackage.Id, response.benefit_package_id);
        System.assertEquals('Draft', response.status);
        System.assertEquals('I_C_BR', response.product_reference);
        System.assertEquals(100, response.amount_of_policies);
        System.assertNotEquals(null, response.affected_policy_range);
        System.assertEquals('1000', response.affected_policy_range.external_number_start_at);
        System.assertEquals('1100', response.affected_policy_range.external_number_end_at);
        System.assertEquals(1, response.legal_consents.size());
        System.assertEquals('legal_consent_I_understand', response.legal_consents[0].code);
        System.assertEquals(true, response.legal_consents[0].is_confirmed);
    }

    @isTest
    static void testFailGetBenefitPackageDetailsNotFound() {
        RestContext.request = new RestRequest();
        RestContext.request.requestURI = '/sales/enterprise/transversal/benefits_configuration/vexp/benefit_packages/001000000000000AAA';
        RestContext.request.httpMethod = 'GET';
        RestContext.request.headers.put('authorization2', 'Bearer ' + TOKEN);

        RestContext.response = new RestResponse();

        Test.startTest();
        BenefitsConfigAPIPackages_VEXP.doGet();
        Test.stopTest();

        System.assertEquals(404, RestContext.response.statusCode);

        WebportalApiUtility_v1.ErrorMessage response =
            (WebportalApiUtility_v1.ErrorMessage) JSON.deserialize(
                RestContext.response.responseBody.toString(),
                WebportalApiUtility_v1.ErrorMessage.class
            );

        System.assertEquals('404', response.status_code);
        System.assertEquals('Not Found', response.error);
    }
}

