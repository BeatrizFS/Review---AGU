@IsTest
private class Test_BenefitsConfigAPIPackages_VEXP {

    private static final String TOKEN = 'test-token';

    @TestSetup
    static void setup() {

        Benefit__c coreBenefit = new Benefit__c(
            Name = 'Core Benefit',
            Visa_External_Reference__c = 'CORE-001',
            Benefit_Description__c = 'Core benefit description'
        );

        Benefit__c optionalBenefit = new Benefit__c(
            Name = 'Optional Benefit',
            Visa_External_Reference__c = 'OPT-001',
            Benefit_Description__c = 'Optional benefit description'
        );

        insert new List<Benefit__c>{
            coreBenefit,
            optionalBenefit
        };

        Id benefitPackageRecordTypeId =
            Schema.SObjectType.ServiceContract
                .getRecordTypeInfosByDeveloperName()
                .get('Benefit_Package')
                .getRecordTypeId();

        ServiceContract benefitPackage = new ServiceContract(
            RecordTypeId = benefitPackageRecordTypeId,
            Name = 'Benefit Package Test',
            StartDate = Date.today(),
            EndDate = Date.today().addYears(1),
            Product_Reference__c = 'I_C_BR',
            Package_Status__c = 'Draft',
            Amount_of_Policies__c = 100,
            Policy_Range_Start__c = '1000',
            Policy_Range_End__c = '1100',
            Legal_Consent_Code__c = 'legal_consent_I_understand',
            Legal_Consent_Confirmed__c = true,
            Legal_Consent_Date__c = Datetime.newInstanceGmt(
                Date.today(),
                Time.newInstance(10, 0, 0, 0)
            )
        );

        insert benefitPackage;

        insert new List<ContractLineItem>{
            new ContractLineItem(
                ServiceContractId = benefitPackage.Id,
                Benefit__c = coreBenefit.Id,
                Benefit_Category__c = 'Core'
            ),
            new ContractLineItem(
                ServiceContractId = benefitPackage.Id,
                Benefit__c = optionalBenefit.Id,
                Benefit_Category__c = 'Optional'
            )
        };
    }

    // Cobre o GET da lista de Benefit Packages com sucesso.
    @IsTest
    static void testSuccessGetBenefitPackages() {

        RestContext.request = new RestRequest();
        RestContext.request.requestURI =
            '/sales/enterprise/transversal/benefits_configuration/vexp/benefit_packages';
        RestContext.request.httpMethod = 'GET';
        RestContext.request.headers.put(
            'authorization2',
            'Bearer ' + TOKEN
        );

        RestContext.response = new RestResponse();

        Test.startTest();
        BenefitsConfigAPIPackages_VEXP.doGet();
        Test.stopTest();

        System.assertEquals(
            200,
            RestContext.response.statusCode,
            'Expected the list endpoint to return HTTP 200.'
        );

        List<Object> response =
            (List<Object>) JSON.deserializeUntyped(
                RestContext.response.responseBody.toString()
            );

        System.assertEquals(
            1,
            response.size(),
            'Expected a single benefit package in the list response.'
        );

        Map<String, Object> benefitPackageResponse =
            (Map<String, Object>) response[0];

        System.assertEquals(
            'Draft',
            benefitPackageResponse.get('status'),
            'The list response should expose the package status.'
        );

        System.assertEquals(
            'I_C_BR',
            benefitPackageResponse.get('product_reference'),
            'The list response should expose the product reference.'
        );

        System.assertEquals(
            '100',
            String.valueOf(benefitPackageResponse.get('amount_of_policies')),
            'The list response should expose the amount of policies.'
        );
    }

    // Cobre o GET de detalhes com Core, Optional e Legal Consent.
    @IsTest
    static void testSuccessGetBenefitPackageDetails() {

        ServiceContract benefitPackage = [
            SELECT Id
            FROM ServiceContract
            WHERE RecordType.DeveloperName = 'Benefit_Package'
            LIMIT 1
        ];

        RestContext.request = new RestRequest();
        RestContext.request.requestURI =
            '/sales/enterprise/transversal/benefits_configuration/vexp/benefit_packages/'
            + benefitPackage.Id;
        RestContext.request.httpMethod = 'GET';
        RestContext.request.headers.put(
            'authorization2',
            'Bearer ' + TOKEN
        );

        RestContext.response = new RestResponse();

        Test.startTest();
        BenefitsConfigAPIPackages_VEXP.doGet();
        Test.stopTest();

        System.assertEquals(
            200,
            RestContext.response.statusCode,
            'Expected the details endpoint to return HTTP 200.'
        );

        BenefitsConfigAPIPackages_VEXP.BenefitPackage response =
            (BenefitsConfigAPIPackages_VEXP.BenefitPackage) JSON.deserialize(
                RestContext.response.responseBody.toString(),
                BenefitsConfigAPIPackages_VEXP.BenefitPackage.class
            );

        System.assertEquals(
            benefitPackage.Id,
            response.benefit_package_id,
            'The response should expose the benefit package id.'
        );

        System.assertEquals(
            'Draft',
            response.status,
            'The response should expose the package status.'
        );

        System.assertEquals(
            'I_C_BR',
            response.product_reference,
            'The response should expose the product reference.'
        );

        System.assertEquals(
            100,
            response.amount_of_policies,
            'The response should expose the amount of policies.'
        );

        System.assertNotEquals(
            null,
            response.affected_policy_range,
            'The response should include the affected policy range.'
        );

        System.assertEquals(
            '1000',
            response.affected_policy_range.external_number_start_at,
            'The response should include the policy range start.'
        );

        System.assertEquals(
            '1100',
            response.affected_policy_range.external_number_end_at,
            'The response should include the policy range end.'
        );

        System.assertEquals(
            1,
            response.core_benefits.size(),
            'The response should include one core benefit.'
        );

        System.assertEquals(
            'CORE-001',
            response.core_benefits[0].benefit_id,
            'The core benefit id should come from Visa_External_Reference__c.'
        );

        System.assertEquals(
            'Core Benefit',
            response.core_benefits[0].name,
            'The core benefit name should come from Benefit__c.Name.'
        );

        System.assertEquals(
            1,
            response.optional_benefits.size(),
            'The response should include one optional benefit.'
        );

        System.assertEquals(
            'OPT-001',
            response.optional_benefits[0].benefit_id,
            'The optional benefit id should come from Visa_External_Reference__c.'
        );

        System.assertEquals(
            'Optional Benefit',
            response.optional_benefits[0].name,
            'The optional benefit name should come from Benefit__c.Name.'
        );

        System.assertEquals(
            'Optional benefit description',
            response.optional_benefits[0].description,
            'The optional benefit description should be returned.'
        );

        System.assertEquals(
            1,
            response.legal_consents.size(),
            'The response should include one legal consent.'
        );

        System.assertEquals(
            'legal_consent_I_understand',
            response.legal_consents[0].code,
            'The legal consent code should match the package data.'
        );

        System.assertEquals(
            true,
            response.legal_consents[0].is_confirmed,
            'The legal consent confirmation should match the package data.'
        );

        System.assertNotEquals(
            null,
            response.legal_consents[0].consented_at,
            'The response should include the consent date.'
        );
    }

    // Cobre o GET de detalhes quando o Benefit Package não existe.
