    private static List<ContractLineItem> buildContractLineItems(
        Id contractId,
        BenefitPackage request,
        Map<String, Benefit__c> benefitsByReference,
        Map<String, PricebookEntry> pricebookEntriesByBenefit,
        Date effectiveStartDate
    ) {
        List<ContractLineItem> lineItems = new List<ContractLineItem>();

        for (CoreBenefit coreBenefit : request.core_benefits) {
            lineItems.add(buildContractLineItem(contractId, benefitsByReference.get(coreBenefit.benefit_id), pricebookEntriesByBenefit.get(coreBenefit.benefit_id), 'Core', request.amount_of_policies, effectiveStartDate, request.active_end_at, true));
        }

        if (request.optional_benefits != null) {
            for (OptionalBenefit optionalBenefit : request.optional_benefits) {
                lineItems.add(buildContractLineItem(contractId, benefitsByReference.get(optionalBenefit.benefit_id), pricebookEntriesByBenefit.get(optionalBenefit.benefit_id), 'Optional', request.amount_of_policies, effectiveStartDate, request.active_end_at, false));
            }
        }

        return lineItems;
    }


