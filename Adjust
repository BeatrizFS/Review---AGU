private static void handleCreate() {
    try {
        RestContext.response.addHeader('Content-Type', 'application/json');

        WebportalAPITokenAuthentication_v1.parseAndValidateSecurityToken(
            RestContext.request,
            new Set<String>{
                'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.benefit_packages.write',
                'urn:axa.partners.benefits_platform.write'
            }
        );

        String requestBody = RestContext.request.requestBody.toString().trim();
        requestBody = WebportalApiUtility_v1.removeXMLInjections(requestBody);
        requestBody = WebportalApiUtility_v1.removeHtmlInjection(requestBody);

        BenefitPackage benefitPackageRequest =
            (BenefitPackage) JSON.deserializeStrict(
                requestBody,
                BenefitPackage.class
            );

        WebportalApiUtility_v1.validateRequestRequiredFields(
            requestBody,
            POST_REQUIRED_FIELDS
        );

        /*
         * 1. Find the Product__c associated with the package
         */
        Product__c product =
            getProductByReference(
                benefitPackageRequest.product_reference
            );

        /*
         * 2. Get the Visa Benefits Pricebook
         */
        Id pricebookId = getBenefitsPricebookId();

        /*
         * 3. If the date is in the past, it will be set to today
         */
        Date effectiveStartDate =
            Date.valueOf(
                benefitPackageRequest.active_start_at
            );

        /*
         * 4. Build ServiceContract
         */
        ServiceContract contract =
            buildServiceContract(
                benefitPackageRequest,
                product,
                pricebookId,
                effectiveStartDate
            );

        /*
         * 5. Get Benefit__c records from the catalogue
         */
        Map<String, Benefit__c> benefitsByReference =
            getBenefitsByExternalReference(
                benefitPackageRequest
            );

        /*
         * 6. Get/Create PricebookEntry for each Product2
         *    in the Visa Benefits Pricebook.
         *
         *    Benefit__c
         *       ↓
         *    Product2
         *       ↓
         *    PricebookEntry
         *       ↓
         *    Visa Benefits
         */
        String currencyIsoCode = 'USD';

        Map<String, PricebookEntry> pricebookEntriesByBenefit =
            getOrCreatePricebookEntriesByBenefitReference(
                benefitsByReference,
                pricebookId,
                currencyIsoCode
            );

        /*
         * 7. Insert the contract
         */
        insert contract;

        /*
         * 8. Create one ContractLineItem per benefit
         */
        List<ContractLineItem> lineItems =
            buildContractLineItems(
                contract.Id,
                benefitPackageRequest,
                benefitsByReference,
                pricebookEntriesByBenefit,
                effectiveStartDate
            );

        if (!lineItems.isEmpty()) {
            insert lineItems;
        }

        /*
         * 9. Response
         */
        BenefitPackagePostResponse responsePayload =
            new BenefitPackagePostResponse();

        responsePayload.benefit_package_id = contract.Id;

        RestContext.response.statusCode = 201;
        RestContext.response.responseBody =
            Blob.valueOf(
                JSON.serializePretty(responsePayload)
            );

    } catch (WebportalApiUtility_v1.RequestAPIException ex) {

        RestContext.response.statusCode = ex.status_code;

        RestContext.response.responseBody =
            Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        String.valueOf(ex.status_code),
                        ex.error,
                        ex.error_description
                    ),
                    true
                )
            );

    } catch (JSONException ex) {

        RestContext.response.statusCode = 400;

        RestContext.response.responseBody =
            Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        '400',
                        'Bad Request',
                        'The input information received were not compliant with the endpoint specification.'
                    )
                )
            );

    } catch (DMLException ex) {

        System.debug(
            LoggingLevel.ERROR,
            'DMLException: ' + ex.getMessage()
        );

        RestContext.response.statusCode = 500;

        RestContext.response.responseBody =
            Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        '500',
                        'database_internal_server_error',
                        'Error when try to insert record in database.'
                    )
                )
            );

    } catch (Exception ex) {

        System.debug(
            LoggingLevel.INFO,
            'Exception type: ' + ex.getTypeName()
        );

        System.debug(
            LoggingLevel.INFO,
            'Exception stack tracing: ' + ex.getStackTraceString()
        );

        RestContext.response.statusCode = 500;

        RestContext.response.responseBody =
            Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        '500',
                        'Internal Server Error',
                        'Unexpected error creating the request: ' +
                        ex.getMessage()
                    )
                )
            );
    }
}


/*
 * ============================================================
 * PRODUCT
 * ============================================================
 */

private static Product__c getProductByReference(
    String productReference
) {
    List<Product__c> products = [
        SELECT Id
        FROM Product__c
        WHERE Key__c = :productReference
        LIMIT 1
    ];

    if (products.isEmpty()) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            'Product with reference ' +
            productReference +
            ' not found.'
        );
    }

    return products[0];
}


/*
 * ============================================================
 * VISA BENEFITS PRICEBOOK
 * ============================================================
 */

private static Id getBenefitsPricebookId() {

    List<Pricebook2> pricebooks = [
        SELECT Id, Name, IsActive
        FROM Pricebook2
        WHERE Name = :BENEFITS_PRICEBOOK_NAME
          AND IsActive = true
        LIMIT 1
    ];

    if (pricebooks.isEmpty()) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            'Benefits pricebook is not configured.'
        );
    }

    return pricebooks[0].Id;
}


/*
 * ============================================================
 * BENEFITS
 * ============================================================
 */

private static Map<String, Benefit__c> getBenefitsByExternalReference(
    BenefitPackage request
) {
    Set<String> requestedBenefitIds = new Set<String>();

    for (CoreBenefit coreBenefit : request.core_benefits) {
        requestedBenefitIds.add(coreBenefit.benefit_id);
    }

    if (request.optional_benefits != null) {
        for (OptionalBenefit optionalBenefit : request.optional_benefits) {
            requestedBenefitIds.add(optionalBenefit.benefit_id);
        }
    }

    List<Benefit__c> benefits = [
        SELECT
            Id,
            Visa_External_Reference__c,
            Name,
            Benefit_Description__c
        FROM Benefit__c
        WHERE Visa_External_Reference__c IN :requestedBenefitIds
    ];

    Map<String, Benefit__c> benefitsByReference =
        new Map<String, Benefit__c>();

    for (Benefit__c benefit : benefits) {
        benefitsByReference.put(
            benefit.Visa_External_Reference__c,
            benefit
        );
    }

    for (String benefitId : requestedBenefitIds) {
        if (!benefitsByReference.containsKey(benefitId)) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'Benefit ' +
                benefitId +
                ' was not found in the catalogue.'
            );
        }
    }

    return benefitsByReference;
}


/*
 * ============================================================
 * PRODUCT2 + PRICEBOOK ENTRY
 * ============================================================
 *
 * For every Benefit__c:
 *
 * Benefit__c
 *      ↓ Benefit__c
 * Product2
 *      ↓ Product2Id
 * PricebookEntry
 *      ↓ Pricebook2Id
 * Visa Benefits
 *
 * If the PricebookEntry already exists, reuse it.
 * Otherwise, create it.
 */

private static Map<String, PricebookEntry>
getOrCreatePricebookEntriesByBenefitReference(
    Map<String, Benefit__c> benefitsByReference,
    Id pricebookId,
    String currencyIsoCode
) {

    Set<Id> benefitIds = new Set<Id>();

    for (Benefit__c benefit : benefitsByReference.values()) {
        benefitIds.add(benefit.Id);
    }


    /*
     * --------------------------------------------------------
     * 1. Find Product2 associated with each Benefit__c
     * --------------------------------------------------------
     */

    List<Product2> products = [
        SELECT
            Id,
            Name,
            Benefit__c,
            Family,
            IsActive,
            CurrencyIsoCode
        FROM Product2
        WHERE Benefit__c IN :benefitIds
          AND Family = 'Benefit'
          AND IsActive = true
    ];


    /*
     * Map:
     *
     * Benefit__c.Id → Product2
     */
    Map<Id, Product2> productsByBenefitId =
        new Map<Id, Product2>();

    for (Product2 product : products) {

        if (productsByBenefitId.containsKey(product.Benefit__c)) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'More than one active Product2 was found for Benefit ' +
                String.valueOf(product.Benefit__c)
            );
        }

        productsByBenefitId.put(
            product.Benefit__c,
            product
        );
    }


    /*
     * --------------------------------------------------------
     * 2. Validate that every Benefit has a Product2
     * --------------------------------------------------------
     */

    for (String benefitReference : benefitsByReference.keySet()) {

        Benefit__c benefit =
            benefitsByReference.get(benefitReference);

        if (!productsByBenefitId.containsKey(benefit.Id)) {

            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'Product2 for benefit ' +
                benefitReference +
                ' was not found in the catalogue.'
            );
        }
    }


    /*
     * --------------------------------------------------------
     * 3. Get existing PricebookEntries
     * --------------------------------------------------------
     */

    Set<Id> productIds = new Set<Id>();

    for (Product2 product : productsByBenefitId.values()) {
        productIds.add(product.Id);
    }

    List<PricebookEntry> existingEntries = [
        SELECT
            Id,
            Product2Id,
            Pricebook2Id,
            UnitPrice,
            IsActive,
            CurrencyIsoCode
        FROM PricebookEntry
        WHERE Pricebook2Id = :pricebookId
          AND Product2Id IN :productIds
          AND CurrencyIsoCode = :currencyIsoCode
    ];


    /*
     * Map:
     *
     * Product2.Id → PricebookEntry
     */
    Map<Id, PricebookEntry> entriesByProductId =
        new Map<Id, PricebookEntry>();

    for (PricebookEntry entry : existingEntries) {
        entriesByProductId.put(
            entry.Product2Id,
            entry
        );
    }


    /*
     * --------------------------------------------------------
     * 4. Create missing PricebookEntries
     * --------------------------------------------------------
     */

    List<PricebookEntry> entriesToInsert =
        new List<PricebookEntry>();

    for (Product2 product : productsByBenefitId.values()) {

        if (!entriesByProductId.containsKey(product.Id)) {

            PricebookEntry entry =
                new PricebookEntry();

            entry.Pricebook2Id = pricebookId;
            entry.Product2Id = product.Id;

            /*
             * TODO:
             * Replace 100 with the actual source of the
             * benefit price when that rule is defined.
             */
            entry.UnitPrice = 100;

            entry.IsActive = true;
            entry.CurrencyIsoCode = currencyIsoCode;

            entriesToInsert.add(entry);
        }
    }

    if (!entriesToInsert.isEmpty()) {
        insert entriesToInsert;

        for (PricebookEntry entry : entriesToInsert) {
            entriesByProductId.put(
                entry.Product2Id,
                entry
            );
        }
    }


    /*
     * --------------------------------------------------------
     * 5. Return:
     *
     * Benefit External Reference → PricebookEntry
     * --------------------------------------------------------
     */

    Map<String, PricebookEntry> entriesByBenefitReference =
        new Map<String, PricebookEntry>();

    for (String benefitReference : benefitsByReference.keySet()) {

        Benefit__c benefit =
            benefitsByReference.get(benefitReference);

        Product2 product =
            productsByBenefitId.get(benefit.Id);

        PricebookEntry entry =
            entriesByProductId.get(product.Id);

        if (entry == null || !entry.IsActive) {

            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'Benefit ' +
                benefitReference +
                ' is not available in the Visa Benefits Pricebook.'
            );
        }

        entriesByBenefitReference.put(
            benefitReference,
            entry
        );
    }

    return entriesByBenefitReference;
}


/*
 * ============================================================
 * CONTRACT LINE ITEMS
 * ============================================================
 */

private static List<ContractLineItem> buildContractLineItems(
    Id contractId,
    BenefitPackage request,
    Map<String, Benefit__c> benefitsByReference,
    Map<String, PricebookEntry> pricebookEntriesByBenefit,
    Date effectiveStartDate
) {
    List<ContractLineItem> lineItems =
        new List<ContractLineItem>();


    /*
     * One ContractLineItem per Core Benefit
     */
    for (CoreBenefit coreBenefit : request.core_benefits) {

        Benefit__c benefit =
            benefitsByReference.get(
                coreBenefit.benefit_id
            );

        PricebookEntry pricebookEntry =
            pricebookEntriesByBenefit.get(
                coreBenefit.benefit_id
            );

        lineItems.add(
            buildContractLineItem(
                contractId,
                benefit,
                pricebookEntry,
                'Core',
                request.amount_of_policies,
                effectiveStartDate,
                request.active_end_at,
                true
            )
        );
    }


    /*
     * One ContractLineItem per Optional Benefit
     */
    if (request.optional_benefits != null) {

        for (OptionalBenefit optionalBenefit :
             request.optional_benefits) {

            Benefit__c benefit =
                benefitsByReference.get(
                    optionalBenefit.benefit_id
                );

            PricebookEntry pricebookEntry =
                pricebookEntriesByBenefit.get(
                    optionalBenefit.benefit_id
                );

            lineItems.add(
                buildContractLineItem(
                    contractId,
                    benefit,
                    pricebookEntry,
                    'Optional',
                    request.amount_of_policies,
                    effectiveStartDate,
                    request.active_end_at,
                    false
                )
            );
        }
    }

    return lineItems;
}


/*
 * ============================================================
 * CONTRACT LINE ITEM
 * ============================================================
 */

private static ContractLineItem buildContractLineItem(
    Id contractId,
    Benefit__c benefit,
    PricebookEntry pricebookEntry,
    String category,
    Integer quantity,
    Date startDate,
    Date endDate,
    Boolean zeroPriced
) {

    if (benefit == null) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            'Benefit could not be resolved.'
        );
    }

    if (pricebookEntry == null) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            'No PricebookEntry was found for benefit ' +
            benefit.Name +
            ' in the Visa Benefits Pricebook.'
        );
    }

    ContractLineItem lineItem =
        new ContractLineItem();

    lineItem.ServiceContractId = contractId;

    /*
     * This is the important Salesforce relationship:
     *
     * ContractLineItem
     *       ↓
     * PricebookEntry
     *       ↓
     * Product2
     *       ↓
     * Benefit__c
     */
    lineItem.PricebookEntryId =
        pricebookEntry.Id;

    lineItem.Benefit__c =
        benefit.Id;

    lineItem.Benefit_Category__c =
        category;

    lineItem.Quantity =
        quantity;

    /*
     * Core benefits are zero-priced.
     * Optional benefits use the price configured
     * in the Visa Benefits PricebookEntry.
     */
    lineItem.UnitPrice =
        zeroPriced
            ? 0
            : pricebookEntry.UnitPrice;

    lineItem.StartDate =
        startDate;

    lineItem.EndDate =
        endDate;

    return lineItem;
}
