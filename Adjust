    //========================= Improvement this method to handle more complex resource paths if needed
    private static List<String> getResourceSegments(String resourcePath) {
        String requestUri = RestContext.request.requestURI;
        Integer resourceIndex = requestUri.indexOf(resourcePath);
        if (resourceIndex < 0) {
            return new List<String>();
        }

        String suffix = requestUri.substring(resourceIndex + resourcePath.length());
        if (suffix.startsWith('/')) {
            suffix = suffix.substring(1);
        }
        if (String.isBlank(suffix)) {
            return new List<String>();
        }

        List<String> rawSegments = suffix.split('/');
        List<String> cleanedSegments = new List<String>();
        for (String rawSegment : rawSegments) {
            if (String.isNotBlank(rawSegment)) {
                cleanedSegments.add(rawSegment);
            }
        }
        return cleanedSegments;
    }   
