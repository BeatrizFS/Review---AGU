private static Map<String, PricebookEntry>
getOrCreatePricebookEntriesByBenefitReference(
    Map<String, Benefit__c> benefitsByReference,
    Id pricebookId,
    String currencyIsoCode
) {
    Set<Id> benefitIds = new Set<Id>();

    for (Benefit__c benefit : benefitsByReference.values()) {
        benefitIds.add(benefit.Id);
    }

    /*
     * ============================================================
     * 1. Get Product2 associated with each Benefit__c
     * ============================================================
     */
    List<Product2> products = [
        SELECT
            Id,
            Name,
            Benefit__c,
            Family,
            IsActive,
            CurrencyIsoCode
        FROM Product2
        WHERE Benefit__c IN :benefitIds
          AND Family = 'Benefit'
          AND IsActive = true
    ];

    Map<Id, Product2> productsByBenefitId =
        new Map<Id, Product2>();

    for (Product2 product : products) {

        if (productsByBenefitId.containsKey(product.Benefit__c)) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'More than one active Product2 was found for Benefit ' +
                String.valueOf(product.Benefit__c)
            );
        }

        productsByBenefitId.put(
            product.Benefit__c,
            product
        );
    }

    /*
     * ============================================================
     * 2. Validate Product2 exists for every Benefit
     * ============================================================
     */
    for (String benefitReference : benefitsByReference.keySet()) {

        Benefit__c benefit =
            benefitsByReference.get(benefitReference);

        if (!productsByBenefitId.containsKey(benefit.Id)) {

            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'Product2 for benefit ' +
                benefitReference +
                ' was not found in the catalogue.'
            );
        }
    }

    Set<Id> productIds = new Set<Id>();

    for (Product2 product : productsByBenefitId.values()) {
        productIds.add(product.Id);
    }


    /*
     * ============================================================
     * 3. Get Standard Price Book
     * ============================================================
     */
    Id standardPricebookId;

    if (Test.isRunningTest()) {
        standardPricebookId = Test.getStandardPricebookId();
    } else {
        standardPricebookId = [
            SELECT Id
            FROM Pricebook2
            WHERE IsStandard = true
            LIMIT 1
        ].Id;
    }


    /*
     * ============================================================
     * 4. Find existing Standard PricebookEntries
     * ============================================================
     */
    Map<Id, PricebookEntry> standardEntriesByProduct =
        new Map<Id, PricebookEntry>();

    for (PricebookEntry entry : [
        SELECT
            Id,
            Product2Id,
            UnitPrice,
            IsActive,
            CurrencyIsoCode
        FROM PricebookEntry
        WHERE Pricebook2Id = :standardPricebookId
          AND Product2Id IN :productIds
          AND CurrencyIsoCode = :currencyIsoCode
    ]) {
        standardEntriesByProduct.put(
            entry.Product2Id,
            entry
        );
    }


    /*
     * ============================================================
     * 5. Create missing Standard PricebookEntries
     * ============================================================
     *
     * This MUST happen before creating entries in Visa Benefits.
     */
    List<PricebookEntry> standardEntriesToInsert =
        new List<PricebookEntry>();

    for (Product2 product : productsByBenefitId.values()) {

        if (!standardEntriesByProduct.containsKey(product.Id)) {

            PricebookEntry standardEntry =
                new PricebookEntry();

            standardEntry.Pricebook2Id =
                standardPricebookId;

            standardEntry.Product2Id =
                product.Id;

            /*
             * TODO:
             * Replace 100 with the real benefit price.
             */
            standardEntry.UnitPrice =
                100;

            standardEntry.IsActive =
                true;

            standardEntry.CurrencyIsoCode =
                currencyIsoCode;

            standardEntriesToInsert.add(
                standardEntry
            );
        }
    }

    if (!standardEntriesToInsert.isEmpty()) {
        insert standardEntriesToInsert;

        for (PricebookEntry entry : standardEntriesToInsert) {
            standardEntriesByProduct.put(
                entry.Product2Id,
                entry
            );
        }
    }


    /*
     * ============================================================
     * 6. Find existing Visa Benefits PricebookEntries
     * ============================================================
     */
    Map<Id, PricebookEntry> visaEntriesByProduct =
        new Map<Id, PricebookEntry>();

    for (PricebookEntry entry : [
        SELECT
            Id,
            Product2Id,
            Pricebook2Id,
            UnitPrice,
            IsActive,
            CurrencyIsoCode
        FROM PricebookEntry
        WHERE Pricebook2Id = :pricebookId
          AND Product2Id IN :productIds
          AND CurrencyIsoCode = :currencyIsoCode
    ]) {
        visaEntriesByProduct.put(
            entry.Product2Id,
            entry
        );
    }


    /*
     * ============================================================
     * 7. Create missing Visa Benefits PricebookEntries
     * ============================================================
     */
    List<PricebookEntry> visaEntriesToInsert =
        new List<PricebookEntry>();

    for (Product2 product : productsByBenefitId.values()) {

        if (!visaEntriesByProduct.containsKey(product.Id)) {

            /*
             * Get the standard price.
             */
            PricebookEntry standardEntry =
                standardEntriesByProduct.get(product.Id);

            PricebookEntry visaEntry =
                new PricebookEntry();

            visaEntry.Pricebook2Id =
                pricebookId;

            visaEntry.Product2Id =
                product.Id;

            visaEntry.UnitPrice =
                standardEntry.UnitPrice;

            visaEntry.IsActive =
                true;

            visaEntry.CurrencyIsoCode =
                currencyIsoCode;

            visaEntriesToInsert.add(
                visaEntry
            );
        }
    }

    if (!visaEntriesToInsert.isEmpty()) {
        insert visaEntriesToInsert;

        for (PricebookEntry entry : visaEntriesToInsert) {
            visaEntriesByProduct.put(
                entry.Product2Id,
                entry
            );
        }
    }


    /*
     * ============================================================
     * 8. Return:
     *
     * Benefit External Reference → Visa PricebookEntry
     * ============================================================
     */
    Map<String, PricebookEntry> result =
        new Map<String, PricebookEntry>();

    for (String benefitReference : benefitsByReference.keySet()) {

        Benefit__c benefit =
            benefitsByReference.get(benefitReference);

        Product2 product =
            productsByBenefitId.get(benefit.Id);

        PricebookEntry visaEntry =
            visaEntriesByProduct.get(product.Id);

        if (visaEntry == null || !visaEntry.IsActive) {

            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'Benefit ' +
                benefitReference +
                ' is not available in the Visa Benefits Pricebook.'
            );
        }

        result.put(
            benefitReference,
            visaEntry
        );
    }

    return result;
}
