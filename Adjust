   private static void handleCreate() {
        try{
            RestContext.response.addHeader('Content-Type', 'application/json');

            WebportalAPITokenAuthentication_v1.parseAndValidateSecurityToken(
                RestContext.request,
                new Set<String>{
                    'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.benefit_packages.write',
                    'urn:axa.partners.benefits_platform.write'
                }
            );

            String requestBody = RestContext.request.requestBody.toString().trim();
            requestBody = WebportalApiUtility_v1.removeXMLInjections(requestBody);
            requestBody = WebportalApiUtility_v1.removeHtmlInjection(requestBody);

            BenefitPackage benefitPackageRequest = (BenefitPackage)JSON.deserializeStrict(requestBody, BenefitPackage.class);
            
            WebportalApiUtility_v1.validateRequestRequiredFields(requestBody, POST_REQUIRED_FIELDS);

            Product__c product = getProductByReference(benefitPackageRequest.product_reference);
            
            //SEARCH - how the pricebook works
            Id pricebookId = getBenefitsPricebookId();

            //N.B. If the date is in the past, it will be set to today
            Date effectiveStartDate = Date.valueOf(benefitPackageRequest.active_start_at);

            ServiceContract contract = buildServiceContract(benefitPackageRequest, product, pricebookId, effectiveStartDate);

            Map<String, Benefit__c> benefitsByReference = getBenefitsByExternalReference(benefitPackageRequest);
            
            //It is necessary to structure the Pricebook for the VISA BENEFIT.
            //context.baseCurrency
            Map<String, PricebookEntry> pricebookEntriesByBenefit = getPricebookEntriesByBenefitReference(
                benefitsByReference.keySet(), 
                pricebookId
            );
            
            insert contract;

            List<ContractLineItem> lineItems = buildContractLineItems(
                contract.Id, 
                benefitPackageRequest, 
                benefitsByReference, 
                pricebookEntriesByBenefit, 
                effectiveStartDate
            );

            if (!lineItems.isEmpty()) {
                insert lineItems;
            }

            BenefitPackagePostResponse responsePayload = new BenefitPackagePostResponse();
            responsePayload.benefit_package_id = contract.Id;

            RestContext.response.statusCode = 201;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(responsePayload));
            
        } catch(WebportalApiUtility_v1.RequestAPIException ex) {
            RestContext.response.statusCode = ex.status_code;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        String.valueOf(ex.status_code),
                        ex.error, ex.error_description),
                        true
                    )
                );
        } catch (JSONException ex) {
            RestContext.response.statusCode = 400;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorMessage('400', 'Bad Request','The input information received were not compliant with the endpoint specification.')));
		} catch(DMLException ex) {
            System.debug(LoggingLevel.ERROR, 'DMLException: ' + ex.getMessage());
            RestContext.response.statusCode = 500;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage('500', 'database_internal_server_error', 'Error when try to insert record in database.')
                )
            );
        } catch(Exception ex) {
            System.debug(LoggingLevel.INFO, 'Exception type: ' + ex.getTypeName());
            System.debug(LoggingLevel.INFO, 'Exception stack tracing: ' + ex.getStackTraceString());
            RestContext.response.statusCode = 500;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage('500', 'Internal Server Error', 'Unexpected error creating the request: ' + ex.getMessage())
                )
            );
        }

    }    

    private static Product__c getProductByReference(String productReference) {
        List<Product__c> products = [SELECT Id FROM Product__c WHERE Key__c = :productReference LIMIT 1];
        if (products.isEmpty()) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Product with reference ' + productReference + ' not found.');
        }
        return products[0];
    }

    private static Id getBenefitsPricebookId() {
        List<Pricebook2> pricebooks = [SELECT Id FROM Pricebook2 WHERE Name = :BENEFITS_PRICEBOOK_NAME AND IsActive = true LIMIT 1];
        if (pricebooks.isEmpty()) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Benefits pricebook is not configured.');
        }
        return pricebooks[0].Id;
    }

   private static Map<String, Benefit__c> getBenefitsByExternalReference(BenefitPackage request) {
        Set<String> requestedBenefitIds = new Set<String>();

        for (CoreBenefit coreBenefit : request.core_benefits) {
            requestedBenefitIds.add(coreBenefit.benefit_id);
        }
        if (request.optional_benefits != null) {
            for (OptionalBenefit optionalBenefit : request.optional_benefits) {
                requestedBenefitIds.add(optionalBenefit.benefit_id);
            }
        }

        List<Benefit__c> benefits = [
            SELECT Id, Visa_External_Reference__c, Name, Benefit_Description__c
            FROM Benefit__c
            WHERE Visa_External_Reference__c IN :requestedBenefitIds
        ];

        Map<String, Benefit__c> benefitsByReference = new Map<String, Benefit__c>();
        for (Benefit__c benefit : benefits) {
            benefitsByReference.put(benefit.Visa_External_Reference__c, benefit);
        }

        for (String benefitId : requestedBenefitIds) {
            if (!benefitsByReference.containsKey(benefitId)) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'bad_request', 'Benefit ' + benefitId + ' was not found in the catalogue.');
            }
        }

        return benefitsByReference;
    }

