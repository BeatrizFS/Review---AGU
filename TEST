private static ResolvedBenefits resolveBenefits(
    ServiceContract benefitPackage,
    List<MN_Product_Benefit__c> coreBenefitRecords,
    List<MN_BINRange_Benefit__c> optionalBenefitRecords
) {

    ResolvedBenefits response = new ResolvedBenefits();

    Map<Id, MN_Product_Benefit__c> coreBenefitsMap =
        new Map<Id, MN_Product_Benefit__c>();

    Map<Id, MN_BINRange_Benefit__c> optionalBenefitsMap =
        new Map<Id, MN_BINRange_Benefit__c>();

    Set<Id> benefitsToRemove = getBenefitsToExclude(benefitPackage);

    /*
     * Core Benefits
     */
    for (MN_Product_Benefit__c productBenefit : coreBenefitRecords) {

        if (!benefitsToRemove.contains(productBenefit.Benefit__c)) {

            coreBenefitsMap.put(
                productBenefit.Benefit__c,
                productBenefit
            );

        }
    }

    /*
     * Optional Benefits
     */
    for (MN_BINRange_Benefit__c optionalBenefit : optionalBenefitRecords) {

        if (benefitsToRemove.contains(optionalBenefit.Benefit__c)) {
            continue;
        }

        if (!coreBenefitsMap.containsKey(optionalBenefit.Benefit__c)
            && !optionalBenefit.Remove_Core_Benefit__c) {

            optionalBenefitsMap.put(
                optionalBenefit.Benefit__c,
                optionalBenefit
            );
        }

        if (optionalBenefitsMap.containsKey(optionalBenefit.Benefit__c)
            && optionalBenefit.Remove_Core_Benefit__c) {

            optionalBenefitsMap.remove(optionalBenefit.Benefit__c);
            benefitsToRemove.add(optionalBenefit.Benefit__c);
        }
    }

    response.coreBenefits.addAll(coreBenefitsMap.values());
    response.optionalBenefits.addAll(optionalBenefitsMap.values());

    return response;
}
