    @AuraEnabled
    public static BenefitsWrapper getBenefits(String creditCardToken, String binNumber) {
        try {
            if (String.isBlank(binNumber)) {
                throw new SearchCustomerCTRLException('Get Benefits error: BIN Number cannot be null');
            }

            VG_BankIdentificationNumber__c bin = WebportalApiUtility_v1.getBIN(binNumber);

            Map<Id, Benefit__c> coreBenefitsMap = new Map<Id, Benefit__c>();
            Map<Id, Benefit__c> optionalBenefitsMap = new Map<Id, Benefit__c>();

            Set<Id> benefitsToRemove = new Set<Id>();
            for (Benefit_Country_Exception__c benefitCountryException : [SELECT Benefit__c FROM Benefit_Country_Exception__c WHERE Country__c IN (SELECT Id FROM Country__c WHERE Name LIKE :bin.BIN_Country__c)]) {
                benefitsToRemove.add(benefitCountryException.Benefit__c);
            }

            for (MN_Product_Benefit__c productBenefit : [SELECT Benefit__r.Name FROM MN_Product_Benefit__c WHERE Product__c = :bin.Product_Version__c AND Benefit__r.Name NOT IN ('Informational', 'Other') AND Benefit__c NOT IN :benefitsToRemove]) {
                coreBenefitsMap.put(productBenefit.Benefit__c, productBenefit.Benefit__r);
            }
            System.debug('core benefits' + coreBenefitsMap);

            for (MN_BINRange_Benefit__c binRangeBenefit : [SELECT Benefit__r.Name, Remove_Core_Benefit__c, BIN_Range__r.Min_Bin_Range_Enc__c,BIN_Range__r.Max_Bin_Range_Enc__c FROM MN_BINRange_Benefit__c WHERE BIN_Range__r.IIN_Number__c = :bin.BIN_6FirstDigits__c AND Benefit__c NOT IN :benefitsToRemove]) {
                if (binRangeBenefit.BIN_Range__r.Min_Bin_Range_Enc__c <= bin.BIN_10FirstDigitsStdEnc__c && bin.BIN_10FirstDigitsStdEnc__c <= binRangeBenefit.BIN_Range__r.Max_Bin_Range_Enc__c) {
                    if (!coreBenefitsMap.containsKey(binRangeBenefit.Benefit__c) && !binRangeBenefit.Remove_Core_Benefit__c) {
                        optionalBenefitsMap.put(binRangeBenefit.Benefit__c, binRangeBenefit.Benefit__r);
                    }

                    if (optionalBenefitsMap.containsKey(binRangeBenefit.Benefit__c) && binRangeBenefit.Remove_Core_Benefit__c) {
                        optionalBenefitsMap.remove(binRangeBenefit.Benefit__c);
                        benefitsToRemove.add(binRangeBenefit.Benefit__c);
                    }
                }
            }
            System.debug('optional benefits' + optionalBenefitsMap);
            System.debug('core benefits' + coreBenefitsMap);

            List<Benefit__c> notCoveredbenefits = [SELECT Id, Name FROM Benefit__c WHERE Id NOT IN :coreBenefitsMap.keySet() AND Id NOT IN :optionalBenefitsMap.keySet() AND Id NOT IN :benefitsToRemove];

            return new BenefitsWrapper(coreBenefitsMap.values(), optionalBenefitsMap.values(), notCoveredbenefits);
        } catch (SearchCustomerCTRLException ex) {
            throw new AuraHandledException(ex.getMessage());
        } catch (WebportalApiUtility_v1.RequestAPIException ex) {
            return new BenefitsWrapper(new List<Benefit__c>(), new List<Benefit__c>(), new List<Benefit__c>());
        } catch (Exception ex) {
            System.debug(LoggingLevel.INFO, 'Exception type: ' + ex.getTypeName());
            System.debug(LoggingLevel.INFO, 'Exception stack tracing: ' + ex.getStackTraceString());
            throw new AuraHandledException('Get Benefits unmmaped error: ' + ex.getMessage());
        }
    }

