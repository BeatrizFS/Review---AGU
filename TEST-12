@isTest
private class Test_BenefitsConfigAPIProducts_VEXP {

    private static String token = '';

    @testSetup
    static void setup() {

        // ================================================================
        // PRODUCT
        // ================================================================

        MN_Product__c product = new MN_Product__c(
            Name = 'Signature Business Card',
            Key__c = 'I_C_BR'
        );
        insert product;

        // ================================================================
        // BENEFIT
        // ================================================================

        Benefit__c benefit = new Benefit__c(
            Name = 'International Emergency Medical Services',
            Active__c = true,
            Visa_External_Reference__c =
                '6fd155eb-c93e-4390-8671-8831f2b6ab57'
        );
        insert benefit;

        // ================================================================
        // PRODUCT BENEFIT
        // ================================================================

        insert new MN_Product_Benefit__c(
            Product__c = product.Id,
            Benefit__c = benefit.Id
        );
    }

    @isTest
    static void testSuccess() {

        RestContext.request = new RestRequest();
        RestContext.request.requestURI =
            '/sales/enterprise/transversal/benefits_configuration/vexp/products';
        RestContext.request.httpMethod = 'GET';
        RestContext.request.headers.put(
            'authorization2',
            'Bearer ' + token
        );

        RestContext.response = new RestResponse();

        Test.startTest();
        BenefitsConfigAPIProducts_VEXP.doGet();
        Test.stopTest();

        List<BenefitsConfigAPIProducts_VEXP.ProductResponse> response =
            (List<BenefitsConfigAPIProducts_VEXP.ProductResponse>)
                JSON.deserialize(
                    RestContext.response.responseBody.toString(),
                    List<BenefitsConfigAPIProducts_VEXP.ProductResponse>.class
                );

        System.assertEquals(
            200,
            RestContext.response.statusCode
        );

        System.assertEquals(
            1,
            response.size()
        );

        System.assertEquals(
            'I_C_BR',
            response[0].product_reference
        );

        System.assertEquals(
            'Signature Business Card',
            response[0].name
        );

        System.assertEquals(
            1,
            response[0].core_benefits.size()
        );

        System.assertEquals(
            '6fd155eb-c93e-4390-8671-8831f2b6ab57',
            response[0].core_benefits[0].benefit_id
        );

        System.assertEquals(
            'International Emergency Medical Services',
            response[0].core_benefits[0].name
        );
    }

    @isTest
    static void testUnauthorized() {

        RestContext.request = new RestRequest();
        RestContext.request.requestURI =
            '/sales/enterprise/transversal/benefits_configuration/vexp/products';
        RestContext.request.httpMethod = 'GET';

        RestContext.response = new RestResponse();

        Test.startTest();
        BenefitsConfigAPIProducts_VEXP.doGet();
        Test.stopTest();

        System.assertEquals(
            401,
            RestContext.response.statusCode
        );
    }
}
