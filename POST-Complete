private static void handleComplete(String benefitPackageId) {
    try {
        WebportalAPITokenAuthentication_v1.parseAndValidateSecurityToken(
            RestContext.request,
            new Set<String>{
                'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.benefit_packages.write',
                'urn:axa.partners.benefits_platform.write'
            }
        );

        List<ServiceContract> packages = [
            SELECT Id,
                Package_Status__c,
                Product_Reference__c,
                StartDate,
                EndDate,
                Amount_of_Policies__c,
                Policy_Range_Start__c,
                Policy_Range_End__c,
                Bank_Identification_Number__c
            FROM ServiceContract
            WHERE Id = :benefitPackageId
            AND RecordType.DeveloperName = :BENEFIT_PACKAGE_RECORD_TYPE
            LIMIT 1
        ];

        if (packages.isEmpty()) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                404,
                'Not Found',
                'The searched resource was not found.'
            );
        }

        ServiceContract contract = packages[0];

        validateCompleteStatus(contract);
        validateCompletePackage(contract);
        validateCompleteCoreBenefits(contract);

        contract.Package_Status__c = PACKAGE_STATUS.get('AWAITING_START');

        update contract;

        RestContext.response.statusCode = 204;

    } catch (WebportalApiUtility_v1.RequestAPIException ex) {
        RestContext.response.statusCode = ex.status_code;
        RestContext.response.responseBody = Blob.valueOf(
            JSON.serializePretty(
                new WebportalApiUtility_v1.ErrorMessage(
                    String.valueOf(ex.status_code),
                    ex.error,
                    ex.error_description
                )
            )
        );
    } catch (Exception ex) {
        System.debug(
            LoggingLevel.ERROR,
            'Unexpected error completing benefit package: ' +
            ex.getMessage()
        );
        System.debug(
            LoggingLevel.ERROR,
            'Error Line: ' + ex.getLineNumber()
        );

        RestContext.response.statusCode = 500;
        RestContext.response.responseBody = Blob.valueOf(
            JSON.serializePretty(
                new WebportalApiUtility_v1.ErrorMessage(
                    '500',
                    'Internal Server Error',
                    'Unexpected error completing the benefit package.'
                )
            )
        );
    }
}

private static void validateCompleteStatus(ServiceContract contract) {
    if (contract.Package_Status__c != PACKAGE_STATUS.get('DRAFT')) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            'Benefit package cannot be completed from status ' +
            contract.Package_Status__c + '.'
        );
    }
}

private static void validateCompletePackage(ServiceContract contract) {
    if (String.isBlank(contract.Product_Reference__c)) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            'product_reference is required.'
        );
    }

    if (
        contract.Amount_of_Policies__c == null ||
        contract.Amount_of_Policies__c < 1
    ) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            'amount_of_policies must be at least 1.'
        );
    }

    if (contract.StartDate == null) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            'active_start_at is required.'
        );
    }

    if (contract.EndDate == null) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            'active_end_at is required.'
        );
    }

    if (contract.EndDate <= contract.StartDate) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            'active_end_at must be greater than active_start_at.'
        );
    }

    if (String.isBlank(contract.Policy_Range_Start__c)) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            'affected_policy_range.external_number_start_at is required.'
        );
    }

    if (String.isBlank(contract.Policy_Range_End__c)) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            'affected_policy_range.external_number_end_at is required.'
        );
    }

    if (String.isBlank(contract.Bank_Identification_Number__c)) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            'bank_identification_number is required.'
        );
    }
}

private static void validateCompleteCoreBenefits(
    ServiceContract contract
) {
    Integer coreBenefits = [
        SELECT COUNT()
        FROM ContractLineItem
        WHERE ServiceContractId = :contract.Id
        AND Benefit_Category__c = 'Core'
    ];

    if (coreBenefits == 0) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            'At least one core benefit is required.'
        );
    }
}
