// ============================================================
// POST
// ============================================================

@HttpPost
global static void doPost() {
    RestContext.response.addHeader('Content-Type', 'application/json');

    List<String> segments = getResourceSegments(RESOURCE_PATH);

    if (segments.isEmpty()) {
        handleCreate();
    } else if (segments.size() == 2 && segments[1] == 'complete') {
        handleComplete(segments[0]);
    } else {
        throw new WebportalApiUtility_v1.RequestAPIException(
            404,
            'not_found',
            'Unknown resource path'
        );
    }
}


// ============================================================
// POST - COMPLETE
// ============================================================

private static void handleComplete(String benefitPackageId) {
    try {
        WebportalAPITokenAuthentication_v1.AccessTokenData accessTokenData =
            WebportalAPITokenAuthentication_v1.parseAndValidateSecurityToken(
                RestContext.request,
                new Set<String>{
                    'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.benefit_packages.write',
                    'urn:axa.partners.benefits_platform.write'
                }
            );

        /*
         * Resolve aqui o banco do caller a partir do token.
         *
         * Exemplo:
         * Id bankId = ...;
         *
         * A query abaixo deve utilizar o relacionamento real
         * entre ServiceContract e o banco.
         */

        List<ServiceContract> packages = [
            SELECT Id,
                Package_Status__c,
                Product_Reference__c,
                StartDate,
                EndDate,
                Amount_of_Policies__c,
                Policy_Range_Start__c,
                Policy_Range_End__c,
                Bank_Identification_Number__c
            FROM ServiceContract
            WHERE Id = :benefitPackageId
            AND RecordType.DeveloperName = :BENEFIT_PACKAGE_RECORD_TYPE
            LIMIT 1
        ];

        if (packages.isEmpty()) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                404,
                'Not Found',
                'The searched resource was not found.'
            );
        }

        ServiceContract contract = packages[0];

        validateCompleteStatus(contract);
        validateCompleteCoreBenefits(contract);
        validateCompleteBin(contract);

        /*
         * As regras de:
         * - EndDate > StartDate
         * - Amount_of_Policies__c >= 1
         * - Policy Range Start <= End
         * - BIN obrigatório
         *
         * já possuem Validation Rules na org.
         *
         * Portanto, não duplicamos essas regras aqui.
         */

        contract.Package_Status__c =
            PACKAGE_STATUS.get('AWAITING_START');

        contract.Completed_At__c = Datetime.now();

        update contract;

        RestContext.response.statusCode = 204;

    } catch (WebportalApiUtility_v1.RequestAPIException ex) {
        RestContext.response.statusCode = ex.status_code;
        RestContext.response.responseBody = Blob.valueOf(
            JSON.serializePretty(
                new WebportalApiUtility_v1.ErrorMessage(
                    String.valueOf(ex.status_code),
                    ex.error,
                    ex.error_description
                )
            )
        );

    } catch (DMLException ex) {
        System.debug(
            LoggingLevel.ERROR,
            'DMLException: ' + ex.getMessage()
        );

        RestContext.response.statusCode = 500;
        RestContext.response.responseBody = Blob.valueOf(
            JSON.serializePretty(
                new WebportalApiUtility_v1.ErrorMessage(
                    '500',
                    'database_internal_server_error',
                    'Error when try to update record in database.'
                )
            )
        );

    } catch (Exception ex) {
        System.debug(
            LoggingLevel.ERROR,
            'Exception type: ' + ex.getTypeName()
        );
        System.debug(
            LoggingLevel.ERROR,
            'Exception stack tracing: ' +
            ex.getStackTraceString()
        );

        RestContext.response.statusCode = 500;
        RestContext.response.responseBody = Blob.valueOf(
            JSON.serializePretty(
                new WebportalApiUtility_v1.ErrorMessage(
                    '500',
                    'Internal Server Error',
                    'Unexpected error completing the benefit package.'
                )
            )
        );
    }
}


// ============================================================
// COMPLETE - STATUS VALIDATION
// ============================================================

private static void validateCompleteStatus(
    ServiceContract contract
) {
    if (contract.Package_Status__c != PACKAGE_STATUS.get('DRAFT')) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            'Benefit package cannot be completed from status ' +
            contract.Package_Status__c + '.'
        );
    }
}


// ============================================================
// COMPLETE - CORE BENEFITS VALIDATION
// ============================================================

private static void validateCompleteCoreBenefits(
    ServiceContract contract
) {
    Integer coreBenefits = [
        SELECT COUNT()
        FROM ContractLineItem
        WHERE ServiceContractId = :contract.Id
        AND Benefit_Category__c = 'Core'
    ];

    if (coreBenefits == 0) {
        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'bad_request',
            'At least one core benefit is required.'
        );
    }
}


