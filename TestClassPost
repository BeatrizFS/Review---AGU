@IsTest
private class Test_BenefitsConfigAPIPackages_VEXP {

    private static final String TOKEN = 'test-token';
    private static final String PRICEBOOK_NAME = 'Visa Benefits';
    private static final String PRODUCT_REFERENCE = 'I_C_BR';
    private static final String CORE_BENEFIT_REFERENCE = 'CORE-001';
    private static final String OPTIONAL_BENEFIT_REFERENCE = 'OPT-001';

    @TestSetup
    static void setup() {

        // Pricebook utilizado pelo endpoint para criar os ContractLineItems.
        Pricebook2 benefitsPricebook = new Pricebook2(
            Name = PRICEBOOK_NAME,
            IsActive = true
        );
        insert benefitsPricebook;

        // Benefits utilizados no request.
        Benefit__c coreBenefit = new Benefit__c(
            Name = 'Core Benefit',
            Visa_External_Reference__c = CORE_BENEFIT_REFERENCE,
            Benefit_Description__c = 'Core benefit description'
        );

        Benefit__c optionalBenefit = new Benefit__c(
            Name = 'Optional Benefit',
            Visa_External_Reference__c = OPTIONAL_BENEFIT_REFERENCE,
            Benefit_Description__c = 'Optional benefit description'
        );

        insert new List<Benefit__c>{
            coreBenefit,
            optionalBenefit
        };

        // Product utilizado para resolver product_reference.
        Product__c product = new Product__c(
            Name = 'Test Product',
            Key__c = PRODUCT_REFERENCE
        );
        insert product;

        // Product2 utilizado pelo catálogo de benefícios.
        Product2 coreProduct = new Product2(
            Name = 'Core Benefit Product',
            ProductCode = 'CORE-PRODUCT',
            Family = 'Benefit',
            IsActive = true,
            Benefit__c = coreBenefit.Id
        );

        Product2 optionalProduct = new Product2(
            Name = 'Optional Benefit Product',
            ProductCode = 'OPTIONAL-PRODUCT',
            Family = 'Benefit',
            IsActive = true,
            Benefit__c = optionalBenefit.Id
        );

        insert new List<Product2>{
            coreProduct,
            optionalProduct
        };

        // Pricebook Entries necessários para os benefícios.
        insert new List<PricebookEntry>{
            new PricebookEntry(
                Pricebook2Id = benefitsPricebook.Id,
                Product2Id = coreProduct.Id,
                UnitPrice = 0,
                IsActive = true,
                CurrencyIsoCode = 'USD'
            ),
            new PricebookEntry(
                Pricebook2Id = benefitsPricebook.Id,
                Product2Id = optionalProduct.Id,
                UnitPrice = 50,
                IsActive = true,
                CurrencyIsoCode = 'USD'
            )
        };
    }

    // Cobre a criação completa de um Benefit Package com Core, Optional,
    // affected policy range e legal consent.
    @IsTest
    static void testSuccessCreateBenefitPackage() {

        RestContext.request = new RestRequest();
        RestContext.request.requestURI =
            '/sales/enterprise/transversal/benefits_configuration/vexp/benefit_packages';
        RestContext.request.httpMethod = 'POST';
        RestContext.request.headers.put(
            'authorization2',
            'Bearer ' + TOKEN
        );

        RestContext.request.requestBody = Blob.valueOf(
            '{' +
                '"product_reference":"I_C_BR",' +
                '"active_start_at":"2026-09-01",' +
                '"active_end_at":"2027-09-01",' +
                '"amount_of_policies":100,' +
                '"affected_policy_range":{' +
                    '"external_number_start_at":"1000",' +
                    '"external_number_end_at":"1100"' +
                '},' +
                '"core_benefits":[' +
                    '{' +
                        '"benefit_id":"CORE-001"' +
                    '}' +
                '],' +
                '"optional_benefits":[' +
                    '{' +
                        '"benefit_id":"OPT-001"' +
                    '}' +
                '],' +
                '"legal_consents":[' +
                    '{' +
                        '"code":"legal_consent_I_understand",' +
                        '"is_confirmed":true,' +
                        '"consented_at":"2026-08-11T10:30:45Z"' +
                    '}' +
                ']' +
            '}'
        );

        RestContext.response = new RestResponse();

        Test.startTest();
        BenefitsConfigAPIPackages_VEXP.doPost();
        Test.stopTest();

        System.assertEquals(
            201,
            RestContext.response.statusCode,
            'Expected HTTP 201 when the benefit package is created.'
        );

        BenefitsConfigAPIPackages_VEXP.BenefitPackagePostResponse response =
            (BenefitsConfigAPIPackages_VEXP.BenefitPackagePostResponse) JSON.deserialize(
                RestContext.response.responseBody.toString(),
                BenefitsConfigAPIPackages_VEXP.BenefitPackagePostResponse.class
            );

        System.assertNotEquals(
            null,
            response.benefit_package_id,
            'The response should contain the created benefit package id.'
        );

        ServiceContract contract = [
            SELECT Id,
                   Package_Status__c,
                   Product_Reference__c,
                   Product__c,
                   StartDate,
                   EndDate,
                   Term,
                   Amount_of_Policies__c,
                   Policy_Range_Start__c,
                   Policy_Range_End__c,
                   Legal_Consent_Code__c,
                   Legal_Consent_Confirmed__c,
                   Legal_Consent_Date__c,
                   Pricebook2Id
            FROM ServiceContract
            WHERE Id = :response.benefit_package_id
            LIMIT 1
        ];

        System.assertEquals(
            'Draft',
            contract.Package_Status__c,
            'The created package should have Draft status.'
        );

        System.assertEquals(
            PRODUCT_REFERENCE,
            contract.Product_Reference__c,
            'The product reference should be persisted.'
        );

        System.assertNotEquals(
            null,
            contract.Product__c,
            'The product should be associated with the package.'
        );

        System.assertEquals(
            Date.newInstance(2026, 9, 1),
            contract.StartDate,
            'The start date should be persisted.'
        );

        System.assertEquals(
            Date.newInstance(2027, 9, 1),
            contract.EndDate,
            'The end date should be persisted.'
        );

        System.assertEquals(
            12,
            contract.Term,
            'The contract term should contain the number of whole months.'
        );

        System.assertEquals(
            100,
            Integer.valueOf(contract.Amount_of_Policies__c),
            'The amount of policies should be persisted.'
        );

        System.assertEquals(
            '1000',
            contract.Policy_Range_Start__c,
            'The policy range start should be persisted.'
        );

        System.assertEquals(
            '1100',
            contract.Policy_Range_End__c,
            'The policy range end should be persisted.'
        );

        System.assertEquals(
            'legal_consent_I_understand',
            contract.Legal_Consent_Code__c,
            'The legal consent code should be persisted.'
        );

        System.assertEquals(
            true,
            contract.Legal_Consent_Confirmed__c,
            'The legal consent confirmation should be persisted.'
        );

        System.assertNotEquals(
            null,
            contract.Legal_Consent_Date__c,
            'The legal consent date should be persisted.'
        );

        System.assertNotEquals(
            null,
            contract.Pricebook2Id,
            'The package should use the Benefits Pricebook.'
        );

        List<ContractLineItem> lineItems = [
            SELECT Id,
                   Benefit__c,
                   Benefit_Category__c,
                   Quantity,
                   UnitPrice,
                   StartDate,
                   EndDate
            FROM ContractLineItem
            WHERE ServiceContractId = :contract.Id
            ORDER BY Benefit_Category__c ASC
        ];

        System.assertEquals(
            2,
            lineItems.size(),
            'The package should contain one Core and one Optional benefit.'
        );

        ContractLineItem coreLineItem;
        ContractLineItem optionalLineItem;

        for (ContractLineItem lineItem : lineItems) {
            if (lineItem.Benefit_Category__c == 'Core') {
                coreLineItem = lineItem;
            } else if (lineItem.Benefit_Category__c == 'Optional') {
                optionalLineItem = lineItem;
            }
        }

        System.assertNotEquals(
            null,
            coreLineItem,
            'The Core benefit should be created.'
        );

        System.assertEquals(
            0,
            coreLineItem.UnitPrice,
            'Core benefits should have zero price.'
        );

        System.assertEquals(
            100,
            Integer.valueOf(coreLineItem.Quantity),
            'The Core benefit quantity should match amount_of_policies.'
        );

        System.assertNotEquals(
            null,
            optionalLineItem,
            'The Optional benefit should be created.'
        );

        System.assertEquals(
            50,
            optionalLineItem.UnitPrice,
            'Optional benefits should use the PricebookEntry price.'
        );

        System.assertEquals(
            100,
            Integer.valueOf(optionalLineItem.Quantity),
            'The Optional benefit quantity should match amount_of_policies.'
        );
    }

