@RestResource(urlMapping='/sales/enterprise/transversal/benefits_configuration/vexp/benefit_packages/*')
global with sharing class BenefitsConfigAPIPackages_VEXP {

    private static final String RESOURCE_PATH = '/benefit_packages';
    private static final String BENEFITS_PRICEBOOK_NAME = 'Visa Benefits';
    private static final String BENEFIT_PACKAGE_RECORD_TYPE = 'Benefit_Package';

    private static Id benefitsPricebookId;

    private static final Set<String> POST_REQUIRED_FIELDS = new Set<String>{
        'product_reference',
        'active_start_at',
        'active_end_at',
        'amount_of_policies',
        'core_benefits',
        'legal_consents'
    };

    private static final Map<String, String> PACKAGE_STATUS = new Map<String, String>{
        'DRAFT' => 'Draft',
        'AWAITING_START' => 'Awaiting Start',
        'ACTIVE' => 'Active',
        'CANCELLED' => 'Cancelled',
        'EXPIRED' => 'Expired'
    };

    @HttpGet
    global static void doGet() {
        RestContext.response.addHeader('Content-Type', 'application/json');

        List<String> segments = getResourceSegments(RESOURCE_PATH);

        if (segments.isEmpty()) {
            handleGet();
        } else if (segments.size() == 1) {
            handleGetDetails(segments[0]);
        } else {
            throw new WebportalApiUtility_v1.RequestAPIException(
                404,
                'not_found',
                'Unknown resource path'
            );
        }
    }

    @HttpPost
    global static void doPost() {
        RestContext.response.addHeader('Content-Type', 'application/json');

        List<String> segments = getResourceSegments(RESOURCE_PATH);

        if (segments.isEmpty()) {
            handleCreate();
        } else {
            throw new WebportalApiUtility_v1.RequestAPIException(
                404,
                'not_found',
                'Unknown resource path'
            );
        }
    }

    private static void handleCreate() {
        try {
            WebportalAPITokenAuthentication_v1.parseAndValidateSecurityToken(
                RestContext.request,
                new Set<String>{
                    'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.benefit_packages.write',
                    'urn:axa.partners.benefits_platform.write'
                }
            );

            String requestBody = RestContext.request.requestBody.toString().trim();
            requestBody = WebportalApiUtility_v1.removeXMLInjections(requestBody);
            requestBody = WebportalApiUtility_v1.removeHtmlInjection(requestBody);

            BenefitPackage request =
                (BenefitPackage) JSON.deserializeStrict(
                    requestBody,
                    BenefitPackage.class
                );

            WebportalApiUtility_v1.validateRequestRequiredFields(
                requestBody,
                POST_REQUIRED_FIELDS
            );

            Date startDate = request.active_start_at;
            Date endDate = request.active_end_at;

            validateCreateRequest(request, startDate, endDate);

            Product__c product = getProduct(request.product_reference);
            Id pricebookId = getBenefitsPricebookId();

            // Waiting - Get from token base_currency
            String currencyIsoCode = 'USD';

            ServiceContract contract = buildServiceContract(
                request,
                product,
                pricebookId,
                startDate,
                endDate
            );

            Map<String, Benefit__c> benefitsByReference =
                getBenefitsByExternalReference(request);

            Map<String, PricebookEntry> pricebookEntriesByBenefit =
                getPricebookEntriesByBenefitReference(
                    benefitsByReference,
                    pricebookId,
                    currencyIsoCode
                );

            insert contract;

            List<ContractLineItem> lineItems = buildContractLineItems(
                contract.Id,
                request,
                startDate,
                endDate,
                benefitsByReference,
                pricebookEntriesByBenefit
            );

            insert lineItems;

            BenefitPackagePostResponse response =
                new BenefitPackagePostResponse();

            response.benefit_package_id = contract.Id;

            RestContext.response.statusCode = 201;
            RestContext.response.responseBody =
                Blob.valueOf(JSON.serializePretty(response));

        } catch (WebportalApiUtility_v1.RequestAPIException ex) {
            RestContext.response.statusCode = ex.status_code;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        String.valueOf(ex.status_code),
                        ex.error,
                        ex.error_description
                    )
                )
            );

        } catch (JSONException ex) {
            RestContext.response.statusCode = 400;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        '400',
                        'Bad Request',
                        'The input information received were not compliant with the endpoint specification.'
                    )
                )
            );

        } catch (DMLException ex) {
            System.debug(
                LoggingLevel.ERROR,
                'DMLException: ' + ex.getMessage()
            );

            RestContext.response.statusCode = 500;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        '500',
                        'database_internal_server_error',
                        'Error when try to insert record in database.'
                    )
                )
            );

        } catch (Exception ex) {
            System.debug(
                LoggingLevel.INFO,
                'Exception type: ' + ex.getTypeName()
            );
            System.debug(
                LoggingLevel.INFO,
                'Exception stack tracing: ' + ex.getStackTraceString()
            );

            RestContext.response.statusCode = 500;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        '500',
                        'Internal Server Error',
                        'Unexpected error creating the request: ' + ex.getMessage()
                    )
                )
            );
        }
    }

    private static void validateCreateRequest(
        BenefitPackage request,
        Date startDate,
        Date endDate
    ) {
        if (startDate == null || endDate == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'active_start_at and active_end_at must be valid dates.'
            );
        }

        if (endDate <= startDate) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'active_end_at must be greater than active_start_at.'
            );
        }

        if (
            request.amount_of_policies == null ||
            request.amount_of_policies < 1
        ) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'amount_of_policies must be a positive integer.'
            );
        }

        if (
            request.core_benefits == null ||
            request.core_benefits.isEmpty()
        ) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'core_benefits must contain at least one item.'
            );
        }

        validateCoreBenefits(request.core_benefits);
        validateOptionalBenefits(request.optional_benefits);
        validatePolicyRange(request.affected_policy_range);
    }

    private static void validateCoreBenefits(
        List<CoreBenefit> coreBenefits
    ) {
        for (CoreBenefit benefit : coreBenefits) {
            if (benefit == null || String.isBlank(benefit.benefit_id)) {
                throw new WebportalApiUtility_v1.RequestAPIException(
                    400,
                    'bad_request',
                    'core_benefits.benefit_id is required.'
                );
            }
        }
    }

    private static void validateOptionalBenefits(
        List<OptionalBenefit> optionalBenefits
    ) {
        // optional_benefits itself is optional.
        // When it is provided, every item must contain benefit_id.
        if (optionalBenefits == null) {
            return;
        }

        for (OptionalBenefit benefit : optionalBenefits) {
            if (benefit == null || String.isBlank(benefit.benefit_id)) {
                throw new WebportalApiUtility_v1.RequestAPIException(
                    400,
                    'bad_request',
                    'optional_benefits.benefit_id is required when optional_benefits is specified.'
                );
            }
        }
    }

    private static void validatePolicyRange(
        AffectedPolicyRange policyRange
    ) {
        if (policyRange == null) {
            return;
        }

        if (String.isBlank(policyRange.external_number_start_at)) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'affected_policy_range.external_number_start_at is required when policy range is specified.'
            );
        }

        if (String.isBlank(policyRange.external_number_end_at)) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'affected_policy_range.external_number_end_at is required when policy range is specified.'
            );
        }
    }

    private static Id getBenefitsPricebookId() {
        if (benefitsPricebookId == null) {
            List<Pricebook2> pricebooks = [
                SELECT Id
                FROM Pricebook2
                WHERE Name = :BENEFITS_PRICEBOOK_NAME
                AND IsActive = true
                LIMIT 1
            ];

            if (pricebooks.isEmpty()) {
                throw new WebportalApiUtility_v1.RequestAPIException(
                    400,
                    'bad_request',
                    'Benefits pricebook is not configured.'
                );
            }

            benefitsPricebookId = pricebooks[0].Id;
        }

        return benefitsPricebookId;
    }

    private static Product__c getProduct(String productReference) {
        List<Product__c> products = [
            SELECT Id
            FROM Product__c
            WHERE Key__c = :productReference
            LIMIT 1
        ];

        if (products.isEmpty()) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'Product with reference ' + productReference + ' not found.'
            );
        }

        return products[0];
    }

    private static Integer calculateWholeMonthTerm(
        Date startDate,
        Date endDate
    ) {
        Integer months =
            ((endDate.year() - startDate.year()) * 12) +
            (endDate.month() - startDate.month());

        if (endDate.day() < startDate.day()) {
            months--;
        }

        return months < 1 ? 1 : months;
    }

    private static void populateLegalConsents(
        ServiceContract contract,
        BenefitPackage request
    ) {
        if (
            request.legal_consents == null ||
            request.legal_consents.isEmpty()
        ) {
            return;
        }

        LegalConsentItem consent = request.legal_consents[0];

        contract = (ServiceContract) WebportalApiUtility_v1.setSObjectField(
            contract,
            'Legal_Consent_Code__c',
            consent.code,
            false
        );

        contract = (ServiceContract) WebportalApiUtility_v1.setSObjectField(
            contract,
            'Legal_Consent_Confirmed__c',
            consent.is_confirmed != null
                ? consent.is_confirmed
                : false
        );

        String consentedAt = consent.consented_at;

        if (
            consentedAt != null &&
            consentedAt.contains('T') &&
            consentedAt.contains('Z')
        ) {
            consentedAt = consentedAt.replace('T', ' ');
            consentedAt = consentedAt.replace('Z', '');
        }

        contract = (ServiceContract) WebportalApiUtility_v1.setSObjectField(
            contract,
            'Legal_Consent_Date__c',
            consentedAt != null
                ? Datetime.valueOfGmt(consentedAt)
                : null,
            false
        );
    }

    private static Map<String, Benefit__c> getBenefitsByExternalReference(
        BenefitPackage request
    ) {
        Set<String> requestedBenefitIds = new Set<String>();

        for (CoreBenefit benefit : request.core_benefits) {
            requestedBenefitIds.add(benefit.benefit_id);
        }

        if (request.optional_benefits != null) {
            for (OptionalBenefit benefit : request.optional_benefits) {
                requestedBenefitIds.add(benefit.benefit_id);
            }
        }

        List<Benefit__c> benefits = [
            SELECT
                Id,
                Visa_External_Reference__c,
                Name,
                Benefit_Description__c
            FROM Benefit__c
            WHERE Visa_External_Reference__c IN :requestedBenefitIds
        ];

        Map<String, Benefit__c> benefitsByReference =
            new Map<String, Benefit__c>();

        for (Benefit__c benefit : benefits) {
            benefitsByReference.put(
                benefit.Visa_External_Reference__c,
                benefit
            );
        }

        for (String benefitId : requestedBenefitIds) {
            if (!benefitsByReference.containsKey(benefitId)) {
                throw new WebportalApiUtility_v1.RequestAPIException(
                    400,
                    'bad_request',
                    'Benefit ' + benefitId + ' was not found in the catalogue.'
                );
            }
        }

        return benefitsByReference;
    }

    private static Map<String, PricebookEntry>
    getPricebookEntriesByBenefitReference(
        Map<String, Benefit__c> benefitsByReference,
        Id pricebookId,
        String currencyIsoCode
    ) {
        Set<Id> benefitIds = new Set<Id>();

        for (Benefit__c benefit : benefitsByReference.values()) {
            benefitIds.add(benefit.Id);
        }

        List<Product2> products = [
            SELECT Id, Benefit__c
            FROM Product2
            WHERE Benefit__c IN :benefitIds
            AND Family = 'Benefit'
            AND IsActive = true
        ];

        Map<Id, Product2> productsByBenefitId =
            new Map<Id, Product2>();

        Set<Id> productIds = new Set<Id>();

        for (Product2 product : products) {
            if (productsByBenefitId.containsKey(product.Benefit__c)) {
                throw new WebportalApiUtility_v1.RequestAPIException(
                    400,
                    'bad_request',
                    'More than one active Product2 was found for Benefit ' +
                    String.valueOf(product.Benefit__c)
                );
            }

            productsByBenefitId.put(product.Benefit__c, product);
            productIds.add(product.Id);
        }

        Map<Id, PricebookEntry> entriesByProductId =
            new Map<Id, PricebookEntry>();

        for (PricebookEntry entry : [
            SELECT Id, Product2Id, UnitPrice
            FROM PricebookEntry
            WHERE Pricebook2Id = :pricebookId
            AND Product2Id IN :productIds
            AND CurrencyIsoCode = :currencyIsoCode
            AND IsActive = true
        ]) {
            entriesByProductId.put(entry.Product2Id, entry);
        }

        Map<String, PricebookEntry> result =
            new Map<String, PricebookEntry>();

        for (String reference : benefitsByReference.keySet()) {
            Benefit__c benefit = benefitsByReference.get(reference);
            Product2 product = productsByBenefitId.get(benefit.Id);

            if (product == null) {
                throw new WebportalApiUtility_v1.RequestAPIException(
                    400,
                    'bad_request',
                    'Product2 for benefit ' +
                    benefit.Visa_External_Reference__c +
                    ' was not found in the catalogue.'
                );
            }

            PricebookEntry entry = entriesByProductId.get(product.Id);

            if (entry == null) {
                throw new WebportalApiUtility_v1.RequestAPIException(
                    400,
                    'bad_request',
                    'Benefit ' +
                    reference +
                    ' is not available in the Benefits Pricebook.'
                );
            }

            result.put(reference, entry);
        }

        return result;
    }

    private static void handleGet() {
        try {
            WebportalAPITokenAuthentication_v1.parseAndValidateSecurityToken(
                RestContext.request,
                new Set<String>{
                    'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.benefit_packages.read_only',
                    'urn:axa.partners.benefits_platform.read_only'
                }
            );

            Map<String, String> requestParams =
                RestContext.request.params;

            Map<String, Integer> paginationParams =
                validateGetRequest(requestParams);

            Integer startIndex = paginationParams.get('start_index');
            Integer maxResults = paginationParams.get('max_results');

            List<ServiceContract> benefitPackages = [
                SELECT
                    Id,
                    Package_Status__c,
                    Product_Reference__c,
                    StartDate,
                    EndDate,
                    Amount_of_Policies__c
                FROM ServiceContract
                WHERE RecordType.DeveloperName = :BENEFIT_PACKAGE_RECORD_TYPE
                ORDER BY CreatedDate DESC
                LIMIT :maxResults
                OFFSET :startIndex
            ];

            RestContext.response.statusCode = 200;

            RestContext.response.addHeader(
                'Content-Range',
                WebportalApiUtility_v1.getContentRangeHeader(
                    startIndex,
                    benefitPackages.size(),
                    benefitPackages.size()
                )
            );

            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    buildBenefitPackageListResponse(benefitPackages),
                    true
                )
            );

        } catch (WebportalApiUtility_v1.RequestAPIException ex) {
            RestContext.response.statusCode = ex.status_code;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        String.valueOf(ex.status_code),
                        ex.error,
                        ex.error_description
                    )
                )
            );

        } catch (Exception ex) {
            System.debug(
                LoggingLevel.INFO,
                'Exception type: ' + ex.getTypeName()
            );
            System.debug(
                LoggingLevel.INFO,
                'Exception stack tracing: ' + ex.getStackTraceString()
            );

            RestContext.response.statusCode = 500;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        '500',
                        'Internal Server Error',
                        'Unexpected error retrieving benefit packages: ' +
                        ex.getMessage()
                    )
                )
            );
        }
    }

    private static Map<String, Integer> validateGetRequest(
