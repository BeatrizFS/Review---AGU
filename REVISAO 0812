    private static List<ContractLineItem> buildContractLineItems(
        Id contractId,
        BenefitPackage request,
        Date startDate,
        Date endDate,
        Map<String, Benefit__c> benefitsByReference,
        Map<String, PricebookEntry> pricebookEntriesByBenefit
    ) {
        List<ContractLineItem> lineItems =
            new List<ContractLineItem>();

        Integer quantity = request.amount_of_policies;

        addCoreLineItems(
            lineItems,
            contractId,
            quantity,
            startDate,
            endDate,
            request.core_benefits,
            benefitsByReference,
            pricebookEntriesByBenefit
        );

        addOptionalLineItems(
            lineItems,
            contractId,
            quantity,
            startDate,
            endDate,
            request.optional_benefits,
            benefitsByReference,
            pricebookEntriesByBenefit
        );

        return lineItems;
    }

    private static void addCoreLineItems(
        List<ContractLineItem> lineItems,
        Id contractId,
        Integer quantity,
        Date startDate,
        Date endDate,
        List<CoreBenefit> coreBenefits,
        Map<String, Benefit__c> benefitsByReference,
        Map<String, PricebookEntry> pricebookEntriesByBenefit
    ) {
        for (CoreBenefit benefit : coreBenefits) {
            lineItems.add(
                buildContractLineItem(
                    contractId,
                    quantity,
                    startDate,
                    endDate,
                    benefitsByReference.get(benefit.benefit_id),
                    pricebookEntriesByBenefit.get(benefit.benefit_id),
                    'Core',
                    0
                )
            );
        }
    }

    private static void addOptionalLineItems(
        List<ContractLineItem> lineItems,
        Id contractId,
        Integer quantity,
        Date startDate,
        Date endDate,
        List<OptionalBenefit> optionalBenefits,
        Map<String, Benefit__c> benefitsByReference,
        Map<String, PricebookEntry> pricebookEntriesByBenefit
    ) {
        if (optionalBenefits == null) {
            return;
        }

        for (OptionalBenefit benefit : optionalBenefits) {
            PricebookEntry pricebookEntry =
                pricebookEntriesByBenefit.get(benefit.benefit_id);

            lineItems.add(
                buildContractLineItem(
                    contractId,
                    quantity,
                    startDate,
                    endDate,
                    benefitsByReference.get(benefit.benefit_id),
                    pricebookEntry,
                    'Optional',
                    pricebookEntry == null
                        ? null
                        : pricebookEntry.UnitPrice
                )
            );
        }
    }

    private static ServiceContract buildServiceContract(
        BenefitPackage request,
        Product__c product,
        Id pricebookId,
        Date startDate,
        Date endDate
    ) {
        ServiceContract contract = new ServiceContract();

        contract.Name = '-';
        contract.RecordTypeId =
            Schema.SObjectType.ServiceContract
                .getRecordTypeInfosByDeveloperName()
                .get(BENEFIT_PACKAGE_RECORD_TYPE)
                .getRecordTypeId();

        contract.Pricebook2Id = pricebookId;
        contract.Package_Status__c = PACKAGE_STATUS.get('DRAFT');
        contract.Product_Reference__c = request.product_reference;
        contract.Product__c = product.Id;
        contract.StartDate = startDate;
        contract.EndDate = endDate;
        contract.Term = calculateWholeMonthTerm(startDate, endDate);
        contract.Amount_of_Policies__c = request.amount_of_policies;

        populatePolicyRange(
            contract,
            request.affected_policy_range
        );

        populateLegalConsents(
            contract,
            request
        );

        return contract;
    }

    private static ContractLineItem buildContractLineItem(
        Id contractId,
        Integer quantity,
        Date startDate,
        Date endDate,
        Benefit__c benefit,
        PricebookEntry pricebookEntry,
        String category,
        Decimal unitPrice
    ) {
        if (benefit == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'Benefit could not be resolved.'
            );
        }

        if (pricebookEntry == null) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'bad_request',
                'No PricebookEntry was found for benefit ' +
                benefit.Name +
                ' in the Visa Benefits Pricebook.'
            );
        }

        return new ContractLineItem(
            ServiceContractId = contractId,
            PricebookEntryId = pricebookEntry.Id,
            Benefit_Category__c = category,
            Quantity = quantity,
            UnitPrice = unitPrice,
            StartDate = startDate,
            EndDate = endDate
        );
    }

    private static List<SimplifiedBenefitPackage>
    buildBenefitPackageListResponse(
        List<ServiceContract> contracts
    ) {
        List<SimplifiedBenefitPackage> response =
            new List<SimplifiedBenefitPackage>();

        for (ServiceContract contract : contracts) {
            SimplifiedBenefitPackage item =
                new SimplifiedBenefitPackage();

            item.status = contract.Package_Status__c;
            item.benefit_package_id = contract.Id;
