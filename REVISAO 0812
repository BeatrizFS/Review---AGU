        return [
            SELECT Id
            FROM ServiceContract
            WHERE RecordType.DeveloperName =
                :BENEFIT_PACKAGE_RECORD_TYPE
            LIMIT 1
        ];
    }

    private static PricebookEntry getPricebookEntry(
        Id pricebookId,
        Id productId
    ) {
        return [
            SELECT Id
            FROM PricebookEntry
            WHERE Pricebook2Id = :pricebookId
            AND Product2Id = :productId
            AND IsActive = true
            LIMIT 1
        ];
    }
