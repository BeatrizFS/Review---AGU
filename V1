private static void handlePatch() {
    try {
        RestContext.response.addHeader('Content-Type', 'application/json');

        WebportalAPITokenAuthentication_v1.parseAndValidateSecurityToken(
            RestContext.request,
            new Set<String>{
                'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.banks.agents.write'
            }
        );

        String requestUri = RestContext.request.requestURI;
        String bankId = requestUri.substringBetween('/banks/', '/agents/');
        String agentId = requestUri.substringAfter('/agents/');

        String requestBody = RestContext.request.requestBody.toString().trim();
        requestBody = WebportalApiUtility_v1.removeXMLInjections(requestBody);
        requestBody = WebportalApiUtility_v1.removeHtmlInjection(requestBody);

        if (String.isBlank(bankId) || String.isBlank(agentId)) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'Bad Request',
                'The input information received were not compliant with the endpoint specification.'
            );
        }

        AgentData agentRequest =
            (AgentData) JSON.deserializeStrict(requestBody, AgentData.class);

        validateRequiredPatchFields(requestBody, agentRequest);

        Account bank = [
            SELECT Id
            FROM Account
            WHERE Id = :bankId
            AND RecordType.DeveloperName = 'Issuer_Bank'
            LIMIT 1
        ];

        Contact agent = [
            SELECT Id, AccountId, FirstName, LastName, Email
            FROM Contact
            WHERE Id = :agentId
            AND AccountId = :bank.Id
            LIMIT 1
        ];

        if (agentRequest.communication_subscriptions != null &&
            agentRequest.communication_subscriptions.benefit_packages != null) {

            updateBenefitPackageSubscription(
                bank.Id,
                agent.Id,
                agentRequest.communication_subscriptions.benefit_packages
            );
        }

        RestContext.response.statusCode = 200;
        RestContext.response.responseBody =
            Blob.valueOf(
                JSON.serializePretty(buildAgentResponse(agent), true)
            );

    } catch (QueryException ex) {

        throw new WebportalApiUtility_v1.RequestAPIException(
            404,
            'Not Found',
            'The searched resource was not found.'
        );

    } catch (WebportalApiUtility_v1.RequestAPIException ex) {

        // seu tratamento atual

    } catch (Exception ex) {

        // seu tratamento atual
    }
}

private static void updateBenefitPackageSubscription(
    Id accountId,
    Id contactId,
    Boolean enabled
) {

    Communication_Subscription__c subscription =
        getCommunicationSubscription(
            contactId,
            CHANNEL_PUSH_NOTIFICATION,
            RELATED_TO_BENEFIT_PACKAGE
        );

    if (enabled) {

        if (subscription == null) {
            createCommunicationSubscription(
                accountId,
                contactId,
                CHANNEL_PUSH_NOTIFICATION,
                RELATED_TO_BENEFIT_PACKAGE
            );
        }

    } else if (subscription != null) {

        delete subscription;
    }
}


