    private static void handlePatch() {
        try {
            RestContext.response.addHeader('Content-Type', 'application/json');

            WebportalAPITokenAuthentication_v1.parseAndValidateSecurityToken(
                RestContext.request,
                new Set<String>{
                    'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.banks.agents.write'
                }
            );

            String requestUri = RestContext.request.requestURI;
            String bankId = requestUri.substringBetween('/banks/', '/agents/');
            String agentId = requestUri.substringAfter('/agents/');

            String requestBody = RestContext.request.requestBody.toString().trim();
            requestBody = WebportalApiUtility_v1.removeXMLInjections(requestBody);
            requestBody = WebportalApiUtility_v1.removeHtmlInjection(requestBody);

            if (String.isBlank(bankId) || String.isBlank(agentId)) {
                throw new WebportalApiUtility_v1.RequestAPIException(400, 'Bad Request', 'The input information received were not compliant with the endpoint specification.');
            }

            AgentData agentRequest = (AgentData) JSON.deserializeStrict(requestBody, AgentData.class);

            List<Contact> agentRecords = [SELECT Id, AccountId, FirstName, LastName, Email FROM Contact WHERE Id = :agentId AND AccountId = :bankId AND Account.RecordType.DeveloperName = 'Issuer_Bank' LIMIT 1];

            if (agentRecords.isEmpty()) {
                throw new WebportalApiUtility_v1.RequestAPIException(404, 'Not Found', 'The searched resource was not found.');
            }

            Contact agent = agentRecords[0];

            if (agentRequest.communication_subscriptions != null &&
                agentRequest.communication_subscriptions.benefit_packages != null) {

                updateBenefitPackageSubscription(bankId, agent.Id, agentRequest.communication_subscriptions.benefit_packages);
            }

            RestContext.response.statusCode = 200;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(buildAgentResponse(agent), true));

        } catch (WebportalApiUtility_v1.RequestAPIException ex) {
            RestContext.response.statusCode = ex.status_code;

            if (ex.status_code == 401) {
                RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorMessage('401', 'Unauthorized', 'Header "authorization" is not a valid JSON Web Token.')));
            } else if (ex.status_code == 403) {
                RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorMessage('403','Forbidden','The right to access this endpoint has not been granted in the JSON Web Token.')));
            } else {
                RestContext.response.responseBody = Blob.valueOf(
                    JSON.serializePretty(
                        new WebportalApiUtility_v1.ErrorMessage(
                            String.valueOf(ex.status_code),
                            ex.error,
                            ex.error_description
                        )
                    )
                );
            }

        } catch (Exception ex) {
            System.debug(LoggingLevel.ERROR, ex.getStackTraceString());
            RestContext.response.statusCode = 500;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorMessage('500','Internal Server Error','Unexpected error updating agent information.')));
        }
    }

    private static Communication_Subscription__c getCommunicationSubscription(Id contactId, String channel, String relatedTo) {
        List<Communication_Subscription__c> subscriptions;
        if (channel == CHANNEL_EMAIL) {
            subscriptions = [SELECT Id, Channel__c, Related_To__c 
                FROM Communication_Subscription__c 
                WHERE Contact__c = :contactId 
                AND Channel__c = :channel LIMIT 1];
        } else {
            subscriptions = [SELECT Id, Channel__c, Related_To__c 
                FROM Communication_Subscription__c 
                WHERE Contact__c = :contactId 
                AND Channel__c = :channel 
                AND Related_To__c = :relatedTo LIMIT 1];
        }
        return subscriptions.isEmpty() ? null : subscriptions[0];
    }

    private static AgentData buildAgentResponse(Contact agent) {
        AgentData response = new AgentData();
        response.first_name = agent.FirstName;
        response.last_name = agent.LastName;
        response.email = agent.Email;

        Communication_Subscription__c emailSubscription = getCommunicationSubscription(agent.Id, CHANNEL_EMAIL, null);

        if (emailSubscription != null) {
            response.communication_subscriptions = new CommunicationSubscriptions();
            response.communication_subscriptions.email = true;
        }

        return response;
    }

    private static void updateBenefitPackageSubscription(Id accountId, Id contactId, Boolean isSubscribed) {

        Communication_Subscription__c subscription = getCommunicationSubscription(contactId, CHANNEL_PUSH_NOTIFICATION, RELATED_TO_BENEFIT_PACKAGE);

        if (isSubscribed) {
            if (subscription == null) {
                createCommunicationSubscription(accountId, contactId, CHANNEL_PUSH_NOTIFICATION, RELATED_TO_BENEFIT_PACKAGE);
            }
        } else if (subscription != null) {
            delete subscription;
        }
    }

    private static void createCommunicationSubscription(Id accountId, Id contactId, String channel, String relatedTo) {
        Communication_Subscription__c communicationSubscription = 
            new Communication_Subscription__c(
                Customer__c = accountId,
                Contact__c = contactId,
                Channel__c = channel
        );

        if(String.isNotBlank(relatedTo)) {
            communicationSubscription.Related_To__c = relatedTo;
        }

        insert communicationSubscription;
    }

