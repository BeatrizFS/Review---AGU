        response.first_name = agent.FirstName;
        response.last_name = agent.LastName;
        response.email = agent.Email;

        return response;
    }

    private static void validateRequiredPostFields(String requestBody, AgentData agentRequest) {
        String errorRequiredFieldsMessage = WebportalApiUtility_v1.validateJSONRequiredFields(requestBody, postRequiredFields);

        if(String.isNotBlank(errorRequiredFieldsMessage)) {
            throw new WebportalApiUtility_v1.RequestAPIException(400, 'Bad Request', 'Field ' + errorRequiredFieldsMessage + ' is required');            
