                requestBody =
                    WebportalApiUtility_v1.decryptRequestBody(clientId, RestContext.request.requestBody.toString());
            }

            requestBody = requestBody.trim();
            requestBody = WebportalApiUtility_v1.removeXMLInjections(requestBody);
            requestBody = WebportalApiUtility_v1.removeHtmlInjection(requestBody);

            WebportalApiUtility_v1.validateRequestRequiredFields(requestBody, POST_REQUIRED_FIELDS);

            ContactUsRequestBody ctuRequestBody = (ContactUsRequestBody) JSON.deserializeStrict(
                WebportalApiUtility_v1.parseJSONBodyRequest(
