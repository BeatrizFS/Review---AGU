@isTest
static void testSuccessPATCHDeleteBenefitPackageSubscriptionAlreadyDeleted() {

    Account bank = [
        SELECT Id,
               (SELECT Id FROM Contacts LIMIT 1)
        FROM Account
        WHERE RecordType.DeveloperName = 'Bank'
        LIMIT 1
    ];

    Contact agent = bank.Contacts[0];

    // Garante que não existe subscription
    delete [
        SELECT Id
        FROM Communication_Subscription__c
        WHERE Contact__c = :agent.Id
        AND Channel__c = 'PUSH_NOTIFICATION'
        AND Related_To__c = 'BENEFIT_PACKAGES'
    ];

    RestContext.request = new RestRequest();
    RestContext.request.requestURI =
        '/sales/enterprise/transversal/benefits_configuration/vexp/banks/'
        + bank.Id + '/agents/' + agent.Id;
    RestContext.request.httpMethod = 'PATCH';
    RestContext.request.headers.put('authorization2', 'Bearer ' + token);
    RestContext.request.requestBody = Blob.valueOf(
        '{"communication_subscriptions":{"benefit_packages":false}}'
    );

    RestContext.response = new RestResponse();

    Test.startTest();
    WebportalSalesBanksAgents_VEXP.doPatch();
    Test.stopTest();

    System.assertEquals(200, RestContext.response.statusCode);

    Integer countSubscriptions = [
        SELECT COUNT()
        FROM Communication_Subscription__c
        WHERE Contact__c = :agent.Id
        AND Channel__c = 'PUSH_NOTIFICATION'
        AND Related_To__c = 'BENEFIT_PACKAGES'
    ];

    System.assertEquals(0, countSubscriptions);

    WebportalSalesBanksAgents_VEXP.BenefitPackageSubscriptionResponse response =
        (WebportalSalesBanksAgents_VEXP.BenefitPackageSubscriptionResponse)
        JSON.deserialize(
            RestContext.response.responseBody.toString(),
            WebportalSalesBanksAgents_VEXP.BenefitPackageSubscriptionResponse.class
        );

    System.assertEquals(false, response.communication_subscriptions.benefit_packages);
}

