    global static void doGet(){
        handleGet();
    }

    @HttpPost
    global static void doPost() {
        handlePost();
    }

    @HttpPatch
    global static void doPatch() {
        handlePatch();
    }

    private static void handleGet() {
        RestContext.response.addHeader('Content-Type', 'application/json');
        List<String> segments = getResourceSegments(RESOURCE_PATH);
        if (segments.size() == 1) {
            handleBankGet(segments[0]);
        } else if (segments.size() == 3 && segments[1] == ACTION_AGENTS) {
            handleAgentGet(segments[0], segments[2]);
        } else {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'Bad Request',
                'The input information received were not compliant with the endpoint specification.'
            );
        }
    }

    private static void handlePost() {
        RestContext.response.addHeader('Content-Type', 'application/json');
        List<String> segments = getResourceSegments(RESOURCE_PATH);

        if (segments.size() == 2 && segments[1] == ACTION_AGENTS) {
            handleAgentPost(segments[0]);
            return;
        }

        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'Bad Request',
            'The input information received were not compliant with the endpoint specification.'
        );
    }

    private static void handlePatch() {
        RestContext.response.addHeader('Content-Type', 'application/json');
        List<String> segments = getResourceSegments(RESOURCE_PATH);

        if (segments.size() == 3 && segments[1] == ACTION_AGENTS) {
            handleAgentPatch(segments[0], segments[2]);
            return;
        }

        throw new WebportalApiUtility_v1.RequestAPIException(
            400,
            'Bad Request',
            'The input information received were not compliant with the endpoint specification.'
        );
    }

