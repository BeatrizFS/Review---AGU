@isTest
static void testSuccessGETWithEmailSubscription() {

    Account bank = [SELECT Id FROM Account WHERE RecordType.DeveloperName = 'Bank' LIMIT 1];
    Contact agent = [SELECT Id FROM Contact WHERE AccountId = :bank.Id LIMIT 1];

    insert new Communication_Subscription__c(
        Customer__c = bank.Id,
        Contact__c = agent.Id,
        Channel__c = 'EMAIL'
    );

    RestContext.request = new RestRequest();
    RestContext.request.requestURI =
        '/sales/enterprise/transversal/benefits_configuration/vexp/banks/' +
        bank.Id +
        '/agents/' +
        agent.Id;
    RestContext.request.httpMethod = 'GET';
    RestContext.request.headers.put('authorization2', 'Bearer ' + token);

    RestContext.response = new RestResponse();

    Test.startTest();
    WebportalSalesBanksAgents_VEXP.doGet();
    Test.stopTest();

    WebportalSalesBanksAgents_VEXP.AgentData response =
        (WebportalSalesBanksAgents_VEXP.AgentData)
            JSON.deserialize(
                RestContext.response.responseBody.toString(),
                WebportalSalesBanksAgents_VEXP.AgentData.class
            );

    System.assertEquals(200, RestContext.response.statusCode);
    System.assertNotEquals(null, response.communication_subscriptions);
    System.assertEquals(true, response.communication_subscriptions.email);
}

System.assertEquals(
    null,
    response.communication_subscriptions
);

System.assert(
    response.communication_subscriptions == null
);
