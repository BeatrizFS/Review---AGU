            'application/json'
        );

        try {

            authenticate();

            BenefitPackage request =
                parseRequest();

            ServiceContract contract =
                buildServiceContract(request);

            insert contract;

            List<ContractLineItem> contractLines =
                buildContractLineItems(
                    contract,
                    request
                );

            if (!contractLines.isEmpty()) {
                insert contractLines;
            }

            saveLegalConsents(
                contract,
                request
            );

            BenefitPackagePostResponse response =
                new BenefitPackagePostResponse();

            response.benefit_package_id =
                contract.Id;

            RestContext.response.statusCode = 201;
            RestContext.response.responseBody =
                Blob.valueOf(
                    JSON.serializePretty(response)
                );

        } catch (Exception ex) {

            handleException(ex);

        }
    }

