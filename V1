                WebportalAPITokenAuthentication_v1.getClientConfiguration(accessTokenData);

            if (accessTokenData.customData != null) {
                isAcgToken = true;
                clientId = accessTokenData.aud;
                cn = accessTokenData.customData.cn;
            }

            if (!isAcgToken) {
                try {
                    WebportalAPITokenAuthentication_v1.AccessTokenClientCredentials accessTokenDataCC =
                        WebportalAPITokenAuthentication_v1.parseAndValidateClientCredentialToken(
                            RestContext.Request,
