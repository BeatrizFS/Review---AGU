    private static ServiceContract buildServiceContract(BenefitPackage request){
        ServiceContract contract = new ServiceContract();
        contract.Product_Reference__c = request.product_reference;
        contract.Product__c = getProductId(request.product_reference);
        contract.StartDate = request.active_start_at;
        contract.EndDate = request.active_end_at;
        contract.Amount_of_Policies__c = request.amount_of_policies;

        if(request.status != null && !request.status.isEmpty()){
            contract.Package_Status__c =
                getPackageStatus(request.status[0]);
        }

        if(request.affected_policy_range != null){
            contract.Policy_Range_Start__c = request.affected_policy_range.external_number_start_at;
            contract.Policy_Range_End__c = request.affected_policy_range.external_number_end_at;
        }

        return contract;
    }

