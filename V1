    @TestVisible
    private static Account validateAcgRequestBody(ContactUsRequestBody body, String cn) {
        String linkedEntityId = body.request.linked_entity_identifier;

        Boolean isIdentifierRequired = (
            body.request.category == Category.CERTIFICATES || 
            body.request.category == Category.EMERGENCY_MEDICAL_ASSISTANCE
        );

        if (isIdentifierRequired && String.isBlank(body.request.linked_entity_identifier)) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'Bad Request',
                'The linked_entity_identifier field is mandatory for this category.'
            );
        }

        List<Account> customer = [
            SELECT Id, PersonContactId,
                (SELECT Id FROM Cases WHERE Id = :linkedEntityId LIMIT 1),
                (SELECT Id FROM Certificates__r WHERE Id = :linkedEntityId LIMIT 1),
                (SELECT Id FROM Trip_Assistances__r WHERE Id = :linkedEntityId LIMIT 1),
                (
                    SELECT Id, BIN__c
                    FROM MN_Account_BIN__r
                    WHERE Credit_Card_Token__c = :body.product_criteria.credit_card_token
                        OR BIN__r.BIN_Number__c = :body.product_criteria.bank_identification_number
                    LIMIT 1
                )
            FROM Account
            WHERE Customer_Identifier__c = :cn
                AND Inactive__c = false
            ORDER BY LastModifiedDate DESC
            LIMIT 1
        ];

        if (customer.isEmpty()) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                404,
                'Not Found',
                'Resource not found: customer'
            );
        } else if (customer[0].MN_Account_BIN__r.isEmpty()) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                404,
                'Not Found',
                'Resource not found: product_criteria.credit_card_token'
            );
        }


        if (String.isNotBlank(linkedEntityId)) {
            Schema.SObjectType sType = Id.valueOf(linkedEntityId).getSObjectType();

            if (sType != Case.sObjectType && sType != Certificates__c.sObjectType && sType != Trip_Assistance__c.sObjectType) {
                throw new WebportalApiUtility_v1.RequestAPIException(
                    400,
                    'Bad Request',
                    'The linked_entity_identifier must be a valid Case, Certificate or Trip Assistance ID.'
                );
            }

            Boolean notFound =
                (sType == Case.sObjectType && customer[0].Cases.isEmpty()) ||
                (sType == Certificates__c.sObjectType && customer[0].Certificates__r.isEmpty()) ||
                (sType == Trip_Assistance__c.sObjectType && customer[0].Trip_Assistances__r.isEmpty());

            if (notFound) {
                throw new WebportalApiUtility_v1.RequestAPIException(
                    404,
                    'Not Found',
                    'Resource not found: linked_entity_identifier'
                );
            }
        }

        if (String.isBlank(body.product_criteria.credit_card_token) && String.isBlank(body.product_criteria.bank_identification_number)) {
            throw new WebportalApiUtility_v1.RequestAPIException(
                400,
                'Bad Request',
                'Invalid request body. Mandatory field: product_criteria'
            );
        }

        return customer[0];
    }

