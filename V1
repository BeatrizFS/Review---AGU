private static BenefitPackageSubscriptionResponse buildBenefitPackageSubscriptionResponse(
    Boolean benefitPackages
) {
    BenefitPackageSubscriptionResponse response =
        new BenefitPackageSubscriptionResponse();

    response.communication_subscriptions =
        new CommunicationSubscriptions();

    response.communication_subscriptions.benefit_packages =
        benefitPackages;

    return response;
}

RestContext.response.statusCode = 200;
RestContext.response.responseBody =
    Blob.valueOf(
        JSON.serializePretty(
            buildBenefitPackageSubscriptionResponse(
                agentRequest.communication_subscriptions.benefit_packages
            ),
            true
        )
    );

private static void updateBenefitPackageSubscription(
    Id accountId,
    Id contactId,
    Boolean isSubscribed
) {

    Communication_Subscription__c subscription =
        getCommunicationSubscription(
            contactId,
            CHANNEL_PUSH_NOTIFICATION,
            RELATED_TO_BENEFIT_PACKAGE
        );

    if (isSubscribed && subscription == null) {
        createCommunicationSubscription(
            accountId,
            contactId,
            CHANNEL_PUSH_NOTIFICATION,
            RELATED_TO_BENEFIT_PACKAGE
        );
        return;
    }

    if (!isSubscribed && subscription != null) {
        delete subscription;
    }
}
