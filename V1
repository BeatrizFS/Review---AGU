            handleAgentGet(segments[0], segments[2]);
        } else {
            writeError(404, 'not_found', 'Unknown resource path');
        }
    }

    @HttpPost
    global static void doPost() {
        RestContext.response.addHeader('Content-Type', 'application/json');
        List<String> segments = getResourceSegments(RESOURCE_PATH);

        if (segments.size() == 2 && segments[1] == ACTION_AGENTS) {
            handleAgentPost(segments[0]);
        } else {
            writeError(404, 'not_found', 'Unknown resource path');
        }
    }

    @HttpPatch
    global static void doPatch() {
        RestContext.response.addHeader('Content-Type', 'application/json');
        List<String> segments = getResourceSegments(RESOURCE_PATH);

        if (segments.size() == 3 && segments[1] == ACTION_AGENTS) {
            handleAgentPatch(segments[0], segments[2]);
        } else {
            writeError(404, 'not_found', 'Unknown resource path');
        }
    }

