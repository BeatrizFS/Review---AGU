    private static void updateBenefitPackageSubscription(Id accountId, Id contactId, Boolean enabled) {

        Communication_Subscription__c subscription = getCommunicationSubscription(contactId, CHANNEL_PUSH_NOTIFICATION, RELATED_TO_BENEFIT_PACKAGE);

        if (enabled) {
            if (subscription == null) {
                createCommunicationSubscription(accountId, contactId, CHANNEL_PUSH_NOTIFICATION, RELATED_TO_BENEFIT_PACKAGE);
            }
        } else if (subscription != null) {
            delete subscription;
        }
    }
