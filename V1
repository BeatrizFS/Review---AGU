@isTest
static void testSuccessPOSTWithEmailSubscription() {

    Account bank = [SELECT Id FROM Account WHERE RecordType.DeveloperName = 'Bank' LIMIT 1];

    RestContext.request = new RestRequest();
    RestContext.request.requestURI = '/sales/enterprise/transversal/benefits_configuration/vexp/banks/' + bank.Id + '/agents';
    RestContext.request.httpMethod = 'POST';
    RestContext.request.headers.put('authorization2', 'Bearer ' + token);

    RestContext.request.requestBody = Blob.valueOf(
        '{' +
        '"first_name":"Maria",' +
        '"last_name":"Silva",' +
        '"email":"maria.subscription@test.com",' +
        '"communication_subscriptions":{' +
            '"email":true' +
        '}' +
        '}'
    );

    RestContext.response = new RestResponse();

    Test.startTest();
    WebportalSalesBanksAgents_VEXP.doPost();
    Test.stopTest();

    System.assertEquals(200, RestContext.response.statusCode);

    Contact contact = [
        SELECT Id, AccountId
        FROM Contact
        WHERE Email = 'maria.subscription@test.com'
        LIMIT 1
    ];

    List<Communication_Subscription__c> subscriptions = [
        SELECT Customer__c, Contact__c, Channel__c
        FROM Communication_Subscription__c
        WHERE Contact__c = :contact.Id
    ];

    System.assertEquals(1, subscriptions.size());
    System.assertEquals(bank.Id, subscriptions[0].Customer__c);
    System.assertEquals(contact.Id, subscriptions[0].Contact__c);
    System.assertEquals('EMAIL', subscriptions[0].Channel__c);
}

