private static Communication_Subscription__c getCommunicationSubscription(
    Id contactId,
    String channel,
    String relatedTo
) {
    String query =
        'SELECT Id, Channel__c, Related_To__c ' +
        'FROM Communication_Subscription__c ' +
        'WHERE Contact__c = :contactId ' +
        'AND Channel__c = :channel';

    if (String.isNotBlank(relatedTo)) {
        query += ' AND Related_To__c = :relatedTo';
    }

    List<Communication_Subscription__c> subscriptions =
        Database.query(query);

    return subscriptions.isEmpty() ? null : subscriptions[0];
}

private static void updateBenefitPackageSubscription(
    Id accountId,
    Id contactId,
    Boolean enabled
) {

    Communication_Subscription__c subscription =
        getBenefitPackageSubscription(contactId);

    if (enabled) {

        if (subscription == null) {

            createCommunicationSubscription(
                accountId,
                contactId,
                'PUSH_NOTIFICATION',
                'BENEFIT_PACKAGE'
            );
        }

    } else {

        if (subscription != null) {
            delete subscription;
        }

    }
}

