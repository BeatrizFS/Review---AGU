	public static JSONWebEncryption JWE() {
        String clientId = '6d09b1ab';
        Client_Key__c key = [Select AES_Key__c, AES_IV__c, Mac_Key__c, RSA_Key__c, Encryption_Scheme__c, CEK_Scheme__c,KID__c from Client_Key__c where ClientID__c = :clientId];
		
        JSONWebEncryption.JOSEHeader header = new JSONWebEncryption.JOSEHeader();
        header.alg = key.CEK_Scheme__c;
        header.enc = key.Encryption_Scheme__c;
        header.kid = key.KID__c;
        
        JSONWebEncryption jwe = new JSONWebEncryption();
        jwe.setProtectedHeader( header );
        
        if( key.CEK_Scheme__c == 'dir' ) {
            jwe.setContentEncrytionKeySecret( key.Mac_Key__c + key.AES_Key__c );
            jwe.setInitializationVector( key.AES_IV__c );
        } else {
            JSONWebEncryption.JWK jwkKey = (JSONWebEncryption.JWK) JSON.deserialize( key.RSA_Key__c, JSONWebEncryption.JWK.class );
            jwe.setCEKAlgorithmKey( jwkKey );
        }
        
        return jwe;
    }
