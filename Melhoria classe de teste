	@isTest static void updateAccount() {
		String jsonRequest = JSON.serialize( WebportalCustomerAPI_V3.createCustomerMock() );

		RestRequest req = new RestRequest();
		RestResponse res = new RestResponse();
		
		req.requestURI = '/specific/visagateway/v3/customers/';
		req.httpMethod = 'POST';
		req.headers.put('authorization2', 'Bearer ' + token);

		JSONWebEncryption jweToken = JWE();

		WebportalCustomerAPI_V3.EncryptedData encrypt = new WebportalCustomerAPI_V3.EncryptedData();
        encrypt.encrypted_data = jweToken.encrypt(jsonRequest);
            
        req.requestBody = Blob.valueOf(JSON.serialize(encrypt));

		RestContext.request = req;
		RestContext.response = res;

		Test.starttest();

		WebportalCustomerAPI_V3.doPost();

		Account acc = [SELECT Customer_Identifier__c, FirstName FROM Account ORDER BY CreatedDate DESC LIMIT 1];

		RestContext.request = new RestRequest();
		RestContext.response = new RestResponse();

		RestContext.request.requestURI = '/specific/visagateway/v3/customers/' + acc.Customer_Identifier__c;
		RestContext.request.httpMethod = 'PATCH';
		RestContext.request.headers.put('authorization2', 'Bearer ' + token);

		RestContext.request.requestBody = Blob.valueOf(JSON.serialize(encrypt));
		
		WebportalCustomerAPI_V3.doPatch();
		Test.stoptest();

		System.assertEquals(204, RestContext.response.statuscode);

		List<Customer_Notification__c> notification = [SELECT Id, Customer__c, Related_To__c, Title__c, Content__c, Push_Title__c, Push_Content__c FROM Customer_Notification__c ORDER BY CreatedDate ASC];
        System.assertEquals(2, notification.size(), 'Two Customer Notification records must be created');

		System.assertEquals(acc.Id, notification[0].Customer__c, 'Customer__c must match for creation notificaiton');
        System.assertEquals('CUSTOMER_NOTIFICATION', notification[0].Related_To__c, 'Related_to__c must equals to CUSTOMER_NOTIFICATION');
        System.assertEquals(customerNotificationMap.get('Customer_Creation').Title_EN_US__c, notification[0].Title__c, 'Title__c must match for creation notification');
        System.assertEquals(customerNotificationMap.get('Customer_Creation').Push_Title_EN_US__c, notification[0].Push_Title__c, 'Push_Title__c must match for creation notification');

		String creationContent = 'Your Visa Benefits Portal registration is complete. Start exploring and enjoying your Visa card benefits.';
		System.assertEquals(creationContent, notification[0].Content__c, 'Content__c must match for creation notification');
		System.assertEquals(creationContent, notification[0].Push_Content__c, 'Push_Content__c must match for creation notification');

        System.assertEquals(acc.Id, notification[1].Customer__c, 'Customer__c must match for update notificaiton');
		System.assertEquals('CUSTOMER_NOTIFICATION', notification[1].Related_To__c, 'Related_to__c must equals to CUSTOMER_NOTIFICATION');
        System.assertEquals(customerNotificationMap.get('Customer_Update').Title_EN_US__c, notification[1].Title__c, 'Title__c must match for update notification');
        System.assertEquals(customerNotificationMap.get('Customer_Update').Push_Title_EN_US__c, notification[1].Push_Title__c, 'Push_Title__c must match for update notification');

		String updateContent = 'Hi ' + acc.FirstName + ', we’ve successfully updated your personal details.';
        System.assertEquals(updateContent, notification[1].Content__c, 'Content__c must match for update notification');
        System.assertEquals(updateContent, notification[1].Push_Content__c, 'Push_Content__c must match for update notification');
	}

