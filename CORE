@RestResource(urlMapping='/sales/enterprise/transversal/benefits_configuration/vexp/products')
global with sharing class BenefitsConfigAPIProducts_VEXP {

    private static final String SCOPE_READ =
        'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.products.read_only';

    private static final Integer MAX_ITEMS = 100;

    @HttpGet
    global static void doGet() {
        try {
            RestContext.response.addHeader('Content-Type', 'application/json');

            WebportalAPITokenAuthentication_v1.AccessTokenData accessTokenData =
                WebportalAPITokenAuthentication_v1.parseAndValidateSecurityToken(
                    RestContext.request,
                    new Set<String>{ SCOPE_READ }
                );

            List<MN_Product_Benefit__c> productBenefits =
                fetchProductBenefits();

            List<ProductResponse> response =
                buildResponse(productBenefits);

            RestContext.response.statusCode = 200;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(response, true)
            );

        } catch (WebportalApiUtility_v1.RequestAPIException ex) {
            RestContext.response.statusCode = ex.status_code;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        String.valueOf(ex.status_code),
                        ex.error,
                        ex.error_description
                    ),
                    true
                )
            );

        } catch (Exception ex) {
            System.debug(
                LoggingLevel.ERROR,
                ex.getStackTraceString()
            );

            RestContext.response.statusCode = 500;
            RestContext.response.responseBody = Blob.valueOf(
                JSON.serializePretty(
                    new WebportalApiUtility_v1.ErrorMessage(
                        '500',
                        'Internal Server Error',
                        'Unexpected error retrieving product benefit information.'
                    )
                )
            );
        }
    }

    // ────────────────────────────────────────────────────────────────────────
    // DATA FETCHING
    // ────────────────────────────────────────────────────────────────────────

    private static List<MN_Product_Benefit__c> fetchProductBenefits() {
        return [
            SELECT
                Product__r.Key__c,
                Product__r.Name,
                Benefit__c,
                Benefit__r.Visa_External_Reference__c,
                Benefit__r.Name
            FROM MN_Product_Benefit__c
            WHERE Benefit__r.Active__c = true
              AND Benefit__r.Visa_External_Reference__c != null
            WITH USER_MODE
            LIMIT :MAX_ITEMS
        ];
    }

    // ────────────────────────────────────────────────────────────────────────
    // RESPONSE BUILDER
    // ────────────────────────────────────────────────────────────────────────

    private static List<ProductResponse> buildResponse(
        List<MN_Product_Benefit__c> productBenefits
    ) {
        Map<String, ProductResponse> productMap =
            new Map<String, ProductResponse>();

        Map<String, Set<Id>> benefitIdsByProduct =
            new Map<String, Set<Id>>();

        for (MN_Product_Benefit__c productBenefit : productBenefits) {
            String productKey =
                productBenefit.Product__r.Key__c;

            if (!productMap.containsKey(productKey)) {
                ProductResponse product =
                    new ProductResponse();

                product.product_reference = productKey;
                product.name =
                    productBenefit.Product__r.Name;
                product.core_benefits =
                    new List<CoreBenefitResponse>();

                productMap.put(productKey, product);

                benefitIdsByProduct.put(
                    productKey,
                    new Set<Id>()
                );
            }

            Set<Id> benefitIds =
                benefitIdsByProduct.get(productKey);

            if (!benefitIds.contains(productBenefit.Benefit__c)) {
                CoreBenefitResponse benefit =
                    new CoreBenefitResponse();

                benefit.benefit_id =
                    productBenefit
                        .Benefit__r
                        .Visa_External_Reference__c;

                benefit.name =
                    productBenefit
                        .Benefit__r
                        .Name;

                productMap
                    .get(productKey)
                    .core_benefits
                    .add(benefit);

                benefitIds.add(
                    productBenefit.Benefit__c
                );
            }
        }

        return productMap.values();
    }

    // ────────────────────────────────────────────────────────────────────────
    // RESPONSE CONTRACT
    // ────────────────────────────────────────────────────────────────────────

    private class ProductResponse {
        String product_reference;
        String name;
        List<CoreBenefitResponse> core_benefits;
    }

    private class CoreBenefitResponse {
        String benefit_id;
        String name;
    }
}
