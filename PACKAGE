private static ServiceContract getBenefitPackage(Id benefitPackageId) {
    List<ServiceContract> benefitPackages = [
        SELECT
            Id,
            Product__c,
            Package_Status__c,
            Product_Reference__c,
            StartDate,
            EndDate,
            Amount_of_Policies__c,
            Code__c,
            Is_Confirmed__c,
            Consented_At__c
        FROM ServiceContract
        WHERE Id = :benefitPackageId
        LIMIT 1
    ];

    return benefitPackages.isEmpty() ? null : benefitPackages[0];
}


private static List<MN_Product_Benefit__c> getCoreBenefitRecords(ServiceContract benefitPackage) {

    return [
        SELECT
            Benefit__c,
            Benefit__r.Name,
            Benefit__r.External_Reference__c,
            Benefit__r.Benefit_Description__c,
