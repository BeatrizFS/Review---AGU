@isTest
static void testUnauthorizedGET() {

    RestContext.request = new RestRequest();
    RestContext.request.requestURI =
        '/sales/enterprise/transversal/benefits_configuration/vexp/benefit_packages';
    RestContext.request.httpMethod = 'GET';

    RestContext.response = new RestResponse();

    Test.startTest();
    VOBPSalesBenefitPackages_V1.doGet();
    Test.stopTest();

    System.assertEquals(401, RestContext.response.statusCode);

    WebportalApiUtility_v1.ErrorMessage response =
        (WebportalApiUtility_v1.ErrorMessage)
        JSON.deserialize(
            RestContext.response.responseBody.toString(),
            WebportalApiUtility_v1.ErrorMessage.class
        );

    System.assertEquals('401', response.status_code);
    System.assertEquals('Unauthorized', response.error);
    System.assertEquals(
        'Header "authorization" is not a valid JSON Web Token.',
        response.error_description
    );
}
