    public class BenefitsWrapper {
        @AuraEnabled public List<SelectOptionWrapper> coreBenefits;
        @AuraEnabled public List<SelectOptionWrapper> optionalBenefits;
        @AuraEnabled public List<SelectOptionWrapper> notCoveredBenefits;
        
        public BenefitsWrapper( List<Benefit__c> coreBenefits, List<Benefit__c> optionalBenefits, List<Benefit__c> notCoveredBenefits ) {
            this.coreBenefits = new List<SelectOptionWrapper>();
            this.optionalBenefits = new List<SelectOptionWrapper>();
            this.notCoveredBenefits = new List<SelectOptionWrapper>();
            
            for( Benefit__c coreBenefit : coreBenefits ) {
                this.coreBenefits.add( new SelectOptionWrapper( coreBenefit.Id, coreBenefit.Name ) );
            }

            for( Benefit__c optionalBenefit : optionalBenefits ) {
                this.optionalBenefits.add( new SelectOptionWrapper( optionalBenefit.Id, optionalBenefit.Name ) );
            }
            
            for( Benefit__c notCoveredBenfit : notCoveredBenefits ) {
                this.notCoveredBenefits.add( new SelectOptionWrapper( notCoveredBenfit.Id, notCoveredBenfit.Name ) );
            }
            this.coreBenefits.sort();
            this.optionalBenefits.sort();
            this.notCoveredBenefits.sort();
        }
    }
    
    public class SelectOptionWrapper implements Comparable {
        @AuraEnabled public String value;
        @AuraEnabled public String label;
        
        public SelectOptionWrapper( String value, String label ) {
            this.value = value;
            this.label = label;
        }
        
        public Integer compareTo(Object compareTo) {
            SelectOptionWrapper compareToOption = (SelectOptionWrapper) compareTo;
            
            if( this.label > compareToOption.label ) {
                return 1;
            } else if( this.label < compareToOption.label ) {
                return -1;
            } else {
                return 0;
            }
        }
    }

