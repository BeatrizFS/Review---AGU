@RestResource(urlMapping='/v1/products/*/benefits/*')
global with sharing class WebportalSalesBinProductBenefits_V1 extends WebportalProductsBenefitsAPIBase_V1 {

    @HttpGet
    global static void doGet() {
		if(String.isBlank(RestContext.request.requestURI.substringAfter('/benefits/'))) {
        	handleGet();
		} else {
			WebportalSalesSpecificProductBenefit_V1.doGet();
		}
    }

    private static void handleGet() {
		RestContext.response.addHeader('Content-Type', 'application/json');
		
		String productKey = RestContext.request.requestURI.substringBetween('/products/', '/benefits');

		if(String.isBlank(productKey)) {
			RestContext.response.statuscode = 400;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorResponse('bad_request', 'Empty Product Id')));
		} else if(!isValidProductKey(productKey)) {
			RestContext.response.statuscode = 400;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorResponse('bad_request', 'Invalid product key')));
		} else {
			Date asOfDate = RestContext.request.params.containsKey('as_of_date') ? Date.valueOf(RestContext.request.params.get('as_of_date')) : Date.today();
			String asOfDateStr = RestContext.request.params.containsKey('as_of_date') ? RestContext.request.params.get('as_of_date') : null;

			Boolean binNumberFound;
			VG_BankIdentificationNumber__c binObj;
			Boolean vdbpResponse = false;
			
            if(productKey.length() == 10 && productKey.isNumeric()) {
            	try {
            	    binObj 	       = WebportalApiUtility_v1.getBIN(productKey);
            	    productKey     = binObj.Product_Version__r.Key__c != null ? binObj.Product_Version__r.Key__c : binObj.Product_Version__r.Product__r.Key__c;
            	    binNumberFound = true;
            	} catch(Exception e) {
            	    System.debug('WebportalSalesBinProductBenefits_V1 (24)--> ' + e.getMessage() + ' <<>> ' + e.getStackTraceString());
            	    binNumberFound = false;
            	}
            } else if(productKey.length() == 16) {
				List<MN_Account_BIN__c> accountBINS = [SELECT Id, BIN__c FROM MN_Account_BIN__c WHERE Credit_Card_Token__c = :productKey];

				if(accountBINS.size() == 0) {
					binNumberFound = false;
				} else {
					MN_Account_BIN__c accountBIN = accountBINS[0];
					binObj = [SELECT Id, Name, Bin_IssuerName__c, Product_Version__c, BIN_Country__c, BIN_6FirstDigits__c, BIN_10FirstDigitsStdEnc__c, Product_Version__r.Is_Express_Applicable__c, Product_Version__r.Product__r.Key__c FROM VG_BankIdentificationNumber__c WHERE Id = :accountBIN.BIN__c AND Status__c = 'Approved'];
					binNumberFound = true;
				}

				if(binNumberFound) {
					try {
						List<VDBPService.BenefitWrapper> benefitsWrappers = VDBPService.getInstance().getBenefits(productKey, asOfDateStr);
						List<BenefitResponse> response = new List<BenefitResponse>();
						for(VDBPService.BenefitWrapper benefitWrapper : benefitsWrappers) {
							BenefitResponse benefitResponse = new BenefitResponse();
                            benefitResponse.benefit_id = benefitWrapper.benefit_id;
                            benefitResponse.description = benefitWrapper.description ?? '';
							benefitResponse.external_reference = benefitWrapper.external_reference;
							benefitResponse.is_optional = benefitWrapper.is_optional;
							benefitResponse.name = benefitWrapper.name;
							response.add(benefitResponse);
						}
						vdbpResponse = true;
						RestContext.response.statuscode   = 200;
						RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(response));
					} catch(CalloutException e) {
						System.debug(e.getMessage());
					} catch(VDBPService.VDBPServiceException e) {
						System.debug(e.getMessage());
					}
				}
			}

            if(binNumberFound != null && !binNumberFound) {
            	RestContext.response.statuscode = 404;
                RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorResponse('not_found', 'BIN not found')));
            } else if(!vdbpResponse){
				List<MN_Product_Benefit__c> mnProdBenefitsList;

				if( binNumberFound != null ) {
					mnProdBenefitsList = [
						SELECT Id, Benefit__r.Id, Benefit__r.Name, Benefit__r.Benefit_Description__c, Benefit__r.Benefit_Record_Type__c, Benefit__r.External_Reference__c, Benefit__r.Category__c
						FROM MN_Product_Benefit__c
						WHERE Product__c = :binObj.Product_Version__c
							AND Benefit__r.Benefit_Record_Type__c != null
							AND Benefit__r.Web_Portal__c = true
							AND Benefit__r.Active__c = true
							AND (
								Valid_Until__c >= :asOfDate
								OR Valid_Until__c = null
							)
					];
				} else {
					mnProdBenefitsList = [
						SELECT Id, Benefit__r.Id, Benefit__r.Name, Benefit__r.Benefit_Description__c, Benefit__r.Benefit_Record_Type__c, Benefit__r.External_Reference__c, Benefit__r.Category__c
						FROM MN_Product_Benefit__c
						WHERE Product__r.Key__c = :productKey
							AND Benefit__r.Benefit_Record_Type__c != null
							AND Benefit__r.Web_Portal__c = true
							AND Benefit__r.Active__c = true
							AND (
								Valid_Until__c >= :asOfDate
								OR Valid_Until__c = null
							)
					];

					if(mnProdBenefitsList.isEmpty()){
						mnProdBenefitsList = [
							SELECT Id, Benefit__r.Id, Benefit__r.Name, Benefit__r.Benefit_Description__c, Benefit__r.Benefit_Record_Type__c, Benefit__r.External_Reference__c, Benefit__r.Category__c
							FROM MN_Product_Benefit__c
							WHERE Product__r.Product__r.Key__c = :productKey
								AND Benefit__r.Benefit_Record_Type__c != null
								AND Benefit__r.Web_Portal__c = true
								AND Benefit__r.Active__c = true
								AND (
									Valid_Until__c >= :asOfDate
									OR Valid_Until__c = null
								)
						];
					}

					if(mnProdBenefitsList.isEmpty()){

						Set<String> countriesCodes = new Set<String>();
						for(Country__c country : [Select Id, Code__c from Country__c] ) {
							countriesCodes.add( country.Code__c );    
						}
                        
                        if( productKey.split( '_' ).size() > 2 ) {
                            List<String> productCodeParts = productKey.split( '_' );
                            String countryCode = productCodeParts[ productCodeParts.size() - 1 ];
                            
                            if( countriesCodes.contains( countryCode ) ) {
                                productCodeParts.remove( productCodeParts.size() -1 );
                            }
                            productKey = String.join( productCodeParts, '_' );
                            System.debug( productKey );
							mnProdBenefitsList = [SELECT Id, Benefit__r.Id, Benefit__r.Name, Benefit__r.Benefit_Description__c, Benefit__r.Benefit_Record_Type__c, Benefit__r.External_Reference__c, Benefit__r.Category__c  FROM MN_Product_Benefit__c  WHERE Product__r.Product__r.Key__c = :productKey and Product__r.Country_LKP__c = null and Benefit__r.Benefit_Record_Type__c != null and Benefit__r.Web_Portal__c = true and (Valid_Until__c >= :asOfDate OR Valid_Until__c = null)];
                        }
					}
				}

				if(mnProdBenefitsList.isEmpty()) {
					RestContext.response.statuscode = 404;
					RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(new WebportalApiUtility_v1.ErrorResponse('not_found', 'Product not found')));
				} else {
					Set<String> benefitsToExclude = new Set<String>();
					if(binObj != null && binObj.BIN_Country__c != null) {
						String binCountry = binObj.BIN_Country__c;
						Set<Id> countriesIds = WebportalApiUtility_v1.getCountries(binCountry);
	
						List<Benefit_Country_Exception__c> countryExceptions = [SELECT Benefit__r.External_Reference__c, Country__c FROM Benefit_Country_Exception__c WHERE Country__c in :countriesIds];
						for(Benefit_Country_Exception__c countryException : countryExceptions) {
							benefitsToExclude.add(countryException.Benefit__r.External_Reference__c);
						}
					}						

	 		    	Map<String, BenefitResponse> benefitsResponseMap = new Map<String, BenefitResponse>();

					for (MN_Product_Benefit__c prodBenefit : mnProdBenefitsList) {
						BenefitResponse benefitResponseObj          = new BenefitResponse();
						benefitResponseObj.benefit_id              = prodBenefit.Benefit__r.Benefit_Record_Type__c;
						benefitResponseObj.external_reference      = prodBenefit.Benefit__r.External_Reference__c;
						benefitResponseObj.name                    = prodBenefit.Benefit__r.Name;
						benefitResponseObj.description             = prodBenefit.Benefit__r.Benefit_Description__c ?? '';
						benefitResponseObj.is_optional             = false;
						benefitResponseObj.categories              = String.isBlank(prodBenefit.Benefit__r.Category__c) ? new List<String>() : new List<String>(prodBenefit.Benefit__r.Category__c.split(';'));

						if( !benefitsToExclude.contains(prodBenefit.Benefit__r.External_Reference__c) ) {
							benefitsResponseMap.put(prodBenefit.Benefit__r.External_Reference__c, benefitResponseObj);
						}
            		}

					if(binNumberFound != null && binNumberFound) {
						for(MN_BINRange_Benefit__c binRangeBenefit : [SELECT Id, Remove_Core_Benefit__c, Benefit__r.Id, Benefit__r.Name, Benefit__r.Benefit_Description__c, BIN_Range__r.Min_Bin_Range_Enc__c, BIN_Range__r.Max_Bin_Range_Enc__c, Benefit__r.Benefit_Record_Type__c, Benefit__r.External_Reference__c, Benefit__r.Category__c
																	FROM MN_BINRange_Benefit__c
																	WHERE BIN_Range__r.IIN_Number__c = :binObj.BIN_6FirstDigits__c AND Benefit__r.Benefit_Record_Type__c != null AND Benefit__r.Web_Portal__c = true ]) 
						{
							if(binObj.BIN_10FirstDigitsStdEnc__c >= binRangeBenefit.BIN_Range__r.Min_Bin_Range_Enc__c && binObj.BIN_10FirstDigitsStdEnc__c <= binRangeBenefit.BIN_Range__r.Max_Bin_Range_Enc__c ) {
								if (!benefitsToExclude.contains(binRangeBenefit.Benefit__r.External_Reference__c) && !benefitsResponseMap.containsKey(binRangeBenefit.Benefit__r.External_Reference__c) && !binRangeBenefit.Remove_Core_Benefit__c) {
									BenefitResponse benefitResponseObjOpt = new BenefitResponse();
									benefitResponseObjOpt.benefit_id               = binRangeBenefit.Benefit__r.Benefit_Record_Type__c;
									benefitResponseObjOpt.external_reference       = binRangeBenefit.Benefit__r.External_Reference__c;
									benefitResponseObjOpt.name                     = binRangeBenefit.Benefit__r.Name;
									benefitResponseObjOpt.description              = binRangeBenefit.Benefit__r.Benefit_Description__c ?? '';
									benefitResponseObjOpt.is_optional              = true;
									benefitResponseObjOpt.categories              = String.isBlank(binRangeBenefit.Benefit__r.Category__c) ? new List<String>() : new List<String>(binRangeBenefit.Benefit__r.Category__c.split(';'));

									benefitsResponseMap.put(binRangeBenefit.Benefit__r.External_Reference__c, benefitResponseObjOpt);
								}

								if (benefitsResponseMap.containsKey(binRangeBenefit.Benefit__r.External_Reference__c) && binRangeBenefit.Remove_Core_Benefit__c) {
									benefitsResponseMap.remove(binRangeBenefit.Benefit__r.External_Reference__c);
								}
							}
						}
					}

					RestContext.response.statuscode = 200;
					RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(benefitsResponseMap.values()));
				}
	        }
		}
    }

    public class BenefitResponse {
        public String  benefit_id;
        public String  external_reference;
        public String  name;
    	public String  description; 
    	public Boolean is_optional;
		public List<String> categories;
    }
}

public with sharing class SearchCustomerCTRL {
    
