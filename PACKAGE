    @AuraEnabled
    public static List<AccountBINWrapper> search( String email, String binNumber, String firstName, String lastName, String phone ) {
        try {
            String query = 'Select Customer__c, Customer__r.Name, Customer__r.FirstName, Customer__r.LastName, Customer__r.Nationality__c, Customer__r.PersonBirthdate, Customer__r.Sex__pc, Customer__r.Phone, Customer__r.PersonEmail, Customer__r.VIP__c, Customer__r.PersonContactId, Customer__r.Account_Communication_Language__c,  BIN__c, BIN__r.BIN_6FirstDigits__c, BIN__r.BIN_10FirstDigitsStdEnc__c, BIN__r.BIN_Country__c, BIN__r.Product_Version__r.Name, BIN__r.Product_Version__r.Type__c, BIN__r.Bin_IssuerName__c, BIN__r.IIN__r.External__c, Credit_Card_Token__c, Is_Preferred__c from MN_Account_BIN__c';
            List<String> whereClauses = new List<String>();
            if( String.isNotBlank(email) ) {
                whereClauses.add( 'Customer__r.PersonEmail = \'' + email + '\'' );
            }
            
            if( String.isNotBlank(binNumber) ) {
                String binNumberEncripted = CryptoTools.getSHA512(binNumber);
                whereClauses.add( 'BIN__r.BIN_10FirstDigitsEnc__c = \'' + binNumberEncripted + '\'' );
            }
            
            if( String.isNotBlank(firstName) ) {
                whereClauses.add( 'Customer__r.FirstName = \'' + firstName + '\'' );
            }
            
            if( String.isNotBlank(lastName) ) {
                whereClauses.add( 'Customer__r.LastName = \'' + lastName + '\'' );
            }
            
            if( String.isNotBlank(phone) ) {
                whereClauses.add( 'Customer__r.Phone = \'' + phone + '\'' );
            }
            
            if( whereClauses.size() == 0 ) {
                AuraHandledException e = new AuraHandledException(Label.SearchCustomer_No_Filter_Selected_Error);
                e.setMessage(Label.SearchCustomer_No_Filter_Selected_Error);
                throw e;
            } else {
                whereClauses.add( 'Customer__r.ParentCustomerId__c = null' );
                query += ' WHERE ' + String.join(whereClauses,' AND ');
                List<AccountBINWrapper> result = new List<AccountBINWrapper>();
                List<MN_Account_BIN__c> accountBINs = Database.query( query );                 
                if(accountBINs.size() > 0){
                    for( MN_Account_BIN__c accountBIN : accountBINs ) {
                    
                        result.add( new AccountBINWrapper( accountBIN ) );
                    }
                    return result;
                } else {
                    return result;
                }
            }
            
        } catch (Exception e) {
            AuraHandledException ex = new AuraHandledException(e.getMessage());
            ex.setMessage(e.getMessage());
            throw ex;
        }
    }
    
    @AuraEnabled
    public static AccountBINWrapper getAccountBIN( String binNumber, String accountId, String firstName, String lastName, String email, String phone ){
        try {
            VG_BankIdentificationNumber__c bin = WebportalApiUtility_v1.getBIN( binNumber );
            AccountBINWrapper accountBIN;
            if (String.isNotBlank(accountId)){
                List<MN_Account_BIN__c> accountBINList = [SELECT Customer__c, Customer__r.Name, Customer__r.FirstName, Customer__r.Nationality__c, Customer__r.LastName, Customer__r.PersonBirthdate, Customer__r.Sex__pc, Customer__r.Phone, Customer__r.PersonEmail, Customer__r.VIP__c, Customer__r.PersonContactId, Customer__r.Account_Communication_Language__c, BIN__c, BIN__r.BIN_6FirstDigits__c, BIN__r.BIN_10FirstDigitsStdEnc__c, BIN__r.BIN_Country__c, BIN__r.Product_Version__c, BIN__r.Product_Version__r.Name, BIN__r.Product_Version__r.Type__c, BIN__r.Bin_IssuerName__c, Credit_Card_Token__c, Is_Preferred__c FROM MN_Account_BIN__c WHERE BIN__c = :bin.Id AND Customer__c = :accountId LIMIT 1];
                if(!accountBINList.isEmpty()) accountBIN = new AccountBINWrapper(accountBINList[0]);
            } 
            if(accountBIN == null){
                VG_BankIdentificationNumber__c type = [SELECT Id, Product_Version__r.Type__c FROM VG_BankIdentificationNumber__c WHERE BIN_Number__c = :binNumber LIMIT 1];
                bin.Product_Version__r.Type__c = type.Product_Version__r.Type__c;

                String queryAccount = 'SELECT Id, Name, FirstName, LastName, PersonEmail, Phone, Nationality__c, Account_Communication_Language__c, PersonContactId, VIP__c, PersonBirthdate, Sex__pc FROM Account ';

                String customerName = '';
                List<String> conditions = new List<String>();

                if (String.isNotBlank(firstName)) {
                    conditions.add('FirstName = :firstName');
                    customerName += firstName;
                }
                if (String.isNotBlank(lastName)) {
                    conditions.add('LastName = :lastName');
                    customerName += (customerName != '' ? ' ' : '') + lastName;
                }
                if (String.isNotBlank(email)) {
                    conditions.add('PersonEmail = :email');
                }
                conditions.add('ParentCustomerId__c = null');

                Boolean noHaveConditions = false;
                if(conditions.size() > 0) {
                    queryAccount += 'WHERE ';
                } else {
                    noHaveConditions = true;
                }

                queryAccount += String.join(conditions, ' AND ');
                queryAccount += ' LIMIT 1';

                List<Account> accList = Database.query(queryAccount);
                if (accList.isEmpty() || noHaveConditions) {
                    Account acc = new Account();
                    acc.FirstName = firstName;
                    acc.LastName = lastName;
                    acc.Name = customerName;
                    acc.PersonEmail = email;
                    acc.Phone = phone;
                    accountBIN = new AccountBINWrapper(acc, bin);
                } else {
                    Account acc = accList[0];
                    accountBIN = new AccountBINWrapper(acc, bin);
                }
            }
