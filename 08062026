                            ex.error,
                            ex.error_description
                        )
                    )
                );
            }
        }
    }

    private static AgentData buildAgentResponse(Contact agent) {
        AgentData response = new AgentData();
        response.first_name = agent.FirstName;
        response.last_name = agent.LastName;
        response.email = agent.Email;

        List<Communication_Subscription__c> subscriptions = [
            SELECT Id, Email__c 
            FROM Communication_Subscription__c 
            WHERE Contact__c = :agent.Id AND Channel__c = 'EMAIL'
        ];

        if (!subscriptions.isEmpty()) {
            response.communication_subscriptions = new CommunicationSubscriptions();
            response.communication_subscriptions.email = true;
        }

        return response;
    }

    public class AgentData {
        public String first_name {
            get {
                return first_name;
            }
            set {
                WebportalApiUtility_v1.validateMaxLength(value, 40, 'first_name');
                first_name = value;
            }
        }

        public String last_name {
            get {
                return last_name;
            }
            set {
                WebportalApiUtility_v1.validateMaxLength(value, 80, 'last_name');
                last_name = value;
            }
        }
        
        public String email {
            get {
                return email;
            }
            set {
                if (!WebportalApiUtility_v1.isValidEmail(value)) {
                    throw new WebportalApiUtility_v1.RequestAPIException(
                        400, 'Bad Request', 'Invalid request body. Invalid format: email'
                    );
                }

                email = value;
            }
        }

        public CommunicationSubscriptions communication_subscriptions;
    } 
    
    public class CommunicationSubscriptions {
        public Boolean email;
        public Boolean benefits_packages;
    }

    public class PatchAgentRequest{
        public CommunicationSubscriptions communication_subscriptions;
    }
}
