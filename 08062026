    private static void handlePatch() {
        try {
            RestContext.response.addHeader('Content-Type', 'application/json');

            WebportalAPITokenAuthentication_v1.AccessTokenData accessTokenData =
                WebportalAPITokenAuthentication_v1.parseAndValidateSecurityToken(
                    RestContext.request,
                    new Set<String>{
                        'urn:axa.partners.sales.enterprise.transversal.benefits_configuration.banks.agents.write'
                    }
                );

            String requestUri = RestContext.request.requestURI;
            String bankId = requestUri.substringBetween('/banks/', '/agents/');
            String agentId = requestUri.substringAfter('/agents/');

            if (String.isBlank(bankId) || String.isBlank(agentId)) {
                throw new WebportalApiUtility_v1.RequestAPIException(400,'Bad Request','The input information received were not compliant with the endpoint specification.');
            }

            //Mapear campo ou objeto usado para setar a comunicação
            List<Contact> agentRecords = [SELECT Id FROM Contact WHERE Id = :agentId AND AccountId = :bankId AND Account.RecordType.DeveloperName = 'Issuer_Bank' LIMIT 1];

            if (agentRecords.isEmpty()) {
                throw new WebportalApiUtility_v1.RequestAPIException(404,'Not Found','The searched resource was not found.');
            }

            Contact agentRecord = agentRecords[0];

            String requestBody = RestContext.request.requestBody.toString().trim();
            requestBody = WebportalApiUtility_v1.removeXMLInjections(requestBody);
            requestBody = WebportalApiUtility_v1.removeHtmlInjection(requestBody);

            AgentData agentRequest = (AgentData)JSON.deserializeStrict(requestBody, AgentData.class);
            
            if (String.isNotBlank(agentRequest.first_name)) {
                agentRecord.FirstName = agentRequest.first_name;
            }

            update agentRecord;

            RestContext.response.statusCode = 200;
            RestContext.response.responseBody = Blob.valueOf(JSON.serializePretty(buildAgentResponse(agentRecord)));

        } catch (WebportalApiUtility_v1.RequestAPIException ex) {
            RestContext.response.statusCode = ex.status_code;

            if (ex.status_code == 401) {
